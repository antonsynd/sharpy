#!/usr/bin/env python3
import argparse
import logging
import os
import random
import re
import shutil
import signal
import subprocess
import sys
from pathlib import Path
from typing import (
    AbstractSet,
    Mapping,
    MutableMapping,
    MutableSequence,
    Sequence,
    Tuple,
)

_logger: logging.Logger = logging.getLogger(name="build_sharpy")

ROOT_DIR: Path = Path(__file__).parent.parent.parent
TOOLS_DIR: Path = ROOT_DIR / "tools"
DATA_DIR: Path = ROOT_DIR / "data"
BUILD_TOOLS_DIR: Path = ROOT_DIR / "build_tools"

SRC_DIR: Path = ROOT_DIR / "src"

COMPILER_DIR: Path = SRC_DIR / "Sharpy.Compiler"
COMPILER_TEST_DIR: Path = SRC_DIR / "Sharpy.Compiler.Tests"
CORE_DIR: Path = SRC_DIR / "Sharpy.Core"
CORE_TEST_DIR: Path = SRC_DIR / "Sharpy.Core.Tests"
STDLIB_DIR: Path = SRC_DIR / "Sharpy.Stdlib"
STDLIB_TEST_DIR: Path = SRC_DIR / "Sharpy.Stdlib.Tests"
CLI_DIR: Path = SRC_DIR / "Sharpy.Cli"
LSP_DIR: Path = SRC_DIR / "Sharpy.Lsp"
LSP_TEST_DIR: Path = SRC_DIR / "Sharpy.Lsp.Tests"

PLAYGROUND_DIR: Path = SRC_DIR / "Sharpy.Playground"
DOCS_DIR: Path = ROOT_DIR / "docs"

EDITORS_DIR: Path = ROOT_DIR / "editors"
VSCODE_EXT_DIR: Path = EDITORS_DIR / "vscode"

# Where the property-stress crash watchdog writes per-round blame artifacts (#1033).
PROPERTY_STRESS_DIR: Path = ROOT_DIR / ".claude" / "tmp" / "property-stress"

CSHARP_PROJECTS: Sequence[Path] = [
    COMPILER_DIR / "Sharpy.Compiler.csproj",
    CLI_DIR / "Sharpy.Cli.csproj",
    COMPILER_TEST_DIR / "Sharpy.Compiler.Tests.csproj",
    CORE_DIR / "Sharpy.Core.csproj",
    CORE_TEST_DIR / "Sharpy.Core.Tests.csproj",
    STDLIB_DIR / "Sharpy.Stdlib.csproj",
    STDLIB_TEST_DIR / "Sharpy.Stdlib.Tests.csproj",
    LSP_DIR / "Sharpy.Lsp.csproj",
    LSP_TEST_DIR / "Sharpy.Lsp.Tests.csproj",
]

CSHARP_CS: str = "cs"
CSHARP_CSHARP: str = "csharp"
CSHARP_CONSTS: AbstractSet[str] = {CSHARP_CS, CSHARP_CSHARP}
PYTHON_PY: str = "py"
PYTHON_PYTHON: str = "python"
PYTHON_CONSTS: AbstractSet[str] = {PYTHON_PY, PYTHON_PYTHON}
TARGET_CONSTS: Tuple[str, ...] = (CSHARP_CSHARP, CSHARP_CS, PYTHON_PYTHON, PYTHON_PY)


def main() -> None:
    setup_logger()

    parser: argparse.ArgumentParser = create_parser()
    pre_args: MutableSequence[str] = []
    rest: MutableSequence[str] = []

    for i, arg in enumerate(sys.argv[1:], start=1):
        if arg == "--":
            rest.extend(sys.argv[i + 1 :])
            break

        pre_args.append(arg)

    args: argparse.Namespace = parser.parse_args(pre_args)

    command: str = args.command

    if command == "build":
        build(args=args, rest=rest, release=args.release)
    elif command == "setup":
        setup(args=args, rest=rest)
    elif command == "clean":
        clean(args=args, rest=rest)
    elif command == "install":
        install(args=args, rest=rest)
    elif command == "format":
        format(args=args, rest=rest)
    elif command == "debug":
        format(args=args, rest=rest)
        build(args=args, rest=rest, release=False)
        test(args=args, rest=rest, release=False)
    elif command == "release":
        format(args=args, rest=rest)
        build(args=args, rest=rest, release=False)
        test(args=args, rest=rest, release=False)
        build(args=args, rest=rest, release=True)
        test(args=args, rest=rest, release=True)
        install(args=args, rest=rest)
    elif command == "test":
        test(args=args, rest=rest, release=False)
    elif command == "property-test":
        property_test(args=args, rest=rest)
    elif command == "playground":
        playground(args=args, rest=rest)
    elif command == "docs":
        docs(args=args, rest=rest)
    elif command == "help":
        parser.print_help()
    else:
        get_logger().error(f'Unknown command "{command}"')


def create_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="")
    subparsers = parser.add_subparsers(dest="command")

    _ = subparsers.add_parser("setup", help="Restores the project.")

    build_parser = subparsers.add_parser("build", help="Builds the package.")
    build_parser.add_argument(
        "--project",
        type=str,
        default="all",
        choices=("all", "cli", "compiler", "lib", "tests", "vscode"),
    )
    build_parser.add_argument("--release", action="store_true")
    clean_parser = subparsers.add_parser(
        "clean", help="Cleans up intermediate objects."
    )
    clean_parser.add_argument(
        "--clean-resources", action="store_true", help="Cleans up generated resources."
    )
    install_parser = subparsers.add_parser(
        "install", help="Installs the Sharpy compiler to ~/.local/bin"
    )
    install_parser.add_argument(
        "--release",
        action="store_true",
        default=True,
        help="Install release build (default)",
    )
    install_parser.add_argument(
        "--debug", action="store_true", help="Install debug build instead of release"
    )
    install_parser.add_argument(
        "--prefix",
        type=str,
        default=None,
        help="Custom install prefix (default: ~/.local)",
    )
    format_parser = subparsers.add_parser("format", help="Runs code formatters.")
    format_parser.add_argument(
        "--target",
        action="append",
        choices=TARGET_CONSTS,
        default=None,
    )
    debug_parser = subparsers.add_parser("debug", help="Runs all steps.")
    debug_parser.add_argument(
        "--target",
        action="append",
        choices=TARGET_CONSTS,
        default=None,
    )
    release_parser = subparsers.add_parser("release", help="Runs all steps.")
    release_parser.add_argument(
        "--target",
        action="append",
        choices=TARGET_CONSTS,
        default=None,
    )
    test_parser = subparsers.add_parser("test", help="Runs tests.")
    test_parser.add_argument(
        "--target",
        action="append",
        choices=TARGET_CONSTS,
        default=None,
    )
    playground_parser = subparsers.add_parser(
        "playground", help="Runs the Blazor WASM playground locally."
    )
    playground_parser.add_argument("--release", action="store_true")
    playground_parser.add_argument(
        "--no-watch",
        action="store_true",
        help="Run without hot reload (dotnet run instead of dotnet watch run)",
    )

    docs_parser = subparsers.add_parser(
        "docs", help="Serves or builds the documentation site."
    )
    docs_parser.add_argument(
        "--build",
        action="store_true",
        help="Build static site instead of serving locally",
    )
    docs_parser.add_argument(
        "--strict",
        action="store_true",
        help="Enable strict mode (fail on warnings)",
    )

    property_test_parser = subparsers.add_parser(
        "property-test", help="Runs property-based tests (Category=RandomProperty)."
    )
    property_test_parser.add_argument(
        "--rounds",
        type=int,
        default=1,
        metavar="N",
        help="Number of rounds to run (each uses fresh random seeds, default: 1)",
    )
    property_test_parser.add_argument(
        "--filter",
        type=str,
        default=None,
        metavar="FILTER",
        help="Additional test name filter (e.g. 'Parser', 'Metamorphic')",
    )
    property_test_parser.add_argument("--release", action="store_true")

    _ = subparsers.add_parser("help", help="Prints this help message.")

    return parser


def get_targets(args: argparse.Namespace) -> AbstractSet[str]:
    if args.target:
        return set(args.target)

    return {CSHARP_CS, PYTHON_PY}


def build(args: argparse.Namespace, rest: Sequence[str], release: bool) -> None:
    argdict: Mapping[str, str] = vars(args)

    if "project" not in argdict or argdict["project"] in {"all", "lib"}:
        build_lib(release=release)

    if "project" not in argdict or argdict["project"] in {"all", "compiler"}:
        build_compiler(release=release)

    if "project" not in argdict or argdict["project"] in {"all", "cli"}:
        build_cli(release=release)

    if "project" not in argdict or argdict["project"] in {"all", "tests"}:
        build_tests(release=release)

    if argdict.get("project") == "vscode":
        build_vscode(production=release)


def build_cli(release: bool) -> None:
    build_type: str = "Release" if release else "Debug"

    try:
        get_logger().info(f"Building CLI with {build_type.lower()} configuration...")

        subprocess.run(["dotnet", "build", "-c", build_type, str(CLI_DIR)], check=True)
    except subprocess.CalledProcessError as e:
        print(f"Encountered error {e}", file=sys.stderr)
        sys.exit(1)


def build_compiler(release: bool) -> None:
    build_type: str = "Release" if release else "Debug"

    try:
        get_logger().info(
            f"Building compiler with {build_type.lower()} configuration..."
        )

        subprocess.run(
            ["dotnet", "build", "-c", build_type, str(COMPILER_DIR)], check=True
        )
    except subprocess.CalledProcessError as e:
        print(f"Encountered error {e}", file=sys.stderr)
        sys.exit(1)


def build_lib(release: bool) -> None:
    build_type: str = "Release" if release else "Debug"

    try:
        get_logger().info(
            f"Building core library with {build_type.lower()} configuration..."
        )
        subprocess.run(["dotnet", "build", "-c", build_type, str(CORE_DIR)], check=True)

        get_logger().info(
            f"Building stdlib with {build_type.lower()} configuration..."
        )
        subprocess.run(["dotnet", "build", "-c", build_type, str(STDLIB_DIR)], check=True)
    except subprocess.CalledProcessError as e:
        print(f"Encountered error {e}", file=sys.stderr)
        sys.exit(1)


def build_vscode(production: bool) -> None:
    get_logger().info("Building VS Code extension...")

    # Ensure node_modules are installed
    if not (VSCODE_EXT_DIR / "node_modules").exists():
        get_logger().info("Installing npm dependencies...")
        try:
            subprocess.run(
                ["npm", "install"],
                check=True,
                cwd=VSCODE_EXT_DIR,
            )
        except (subprocess.CalledProcessError, FileNotFoundError) as e:
            get_logger().error(f"npm install failed: {e}")
            sys.exit(1)

    cmd: MutableSequence[str] = ["node", "esbuild.mjs"]

    if production:
        cmd.append("--production")

    try:
        subprocess.run(cmd, check=True, cwd=VSCODE_EXT_DIR)
        get_logger().info("VS Code extension built successfully.")
    except (subprocess.CalledProcessError, FileNotFoundError) as e:
        get_logger().error(f"VS Code extension build failed: {e}")
        sys.exit(1)


def build_tests(release: bool) -> None:
    build_type: str = "Release" if release else "Debug"

    try:
        get_logger().info(f"Building tests with {build_type.lower()} configuration...")
        subprocess.run(
            ["dotnet", "build", "-c", build_type, str(CORE_TEST_DIR)], check=True
        )
        subprocess.run(
            ["dotnet", "build", "-c", build_type, str(COMPILER_TEST_DIR)], check=True
        )
        subprocess.run(
            ["dotnet", "build", "-c", build_type, str(STDLIB_TEST_DIR)], check=True
        )
        subprocess.run(
            ["dotnet", "build", "-c", build_type, str(LSP_TEST_DIR)], check=True
        )
    except subprocess.CalledProcessError as e:
        print(f"Encountered error {e}", file=sys.stderr)
        sys.exit(1)


def playground(args: argparse.Namespace, rest: Sequence[str]) -> None:
    build_type: str = "Release" if args.release else "Debug"
    project: str = str(PLAYGROUND_DIR)

    get_logger().info(f"Starting playground ({build_type.lower()})...")
    get_logger().info("Open http://localhost:5000 or https://localhost:5001 in your browser")
    get_logger().info("Press Ctrl+C to stop")

    try:
        if args.no_watch:
            subprocess.run(
                ["dotnet", "run", "--project", project, "-c", build_type, *rest],
                check=True,
            )
        else:
            subprocess.run(
                ["dotnet", "watch", "run", "--project", project, "-c", build_type, *rest],
                check=True,
            )
    except subprocess.CalledProcessError as e:
        get_logger().error(f"Playground failed: {e}")
        sys.exit(1)
    except KeyboardInterrupt:
        get_logger().info("Playground stopped.")


def docs(args: argparse.Namespace, rest: Sequence[str]) -> None:
    cmd: MutableSequence[str] = ["mkdocs"]

    if args.build:
        cmd.append("build")
        get_logger().info("Building documentation site...")
    else:
        cmd.append("serve")
        get_logger().info("Serving documentation site...")
        get_logger().info("Open http://localhost:8000 in your browser")
        get_logger().info("Press Ctrl+C to stop")

    if args.strict:
        cmd.append("--strict")

    cmd.extend(rest)

    try:
        subprocess.run(cmd, check=True, cwd=ROOT_DIR)
    except FileNotFoundError:
        get_logger().error("mkdocs not found. Install it with: pip install mkdocs-material")
        sys.exit(1)
    except subprocess.CalledProcessError as e:
        get_logger().error(f"Documentation {'build' if args.build else 'serve'} failed: {e}")
        sys.exit(1)
    except KeyboardInterrupt:
        get_logger().info("Documentation server stopped.")


def setup(args: argparse.Namespace, rest: Sequence[str]) -> None:
    get_logger().info("Setting up...")
    get_logger().info("Restoring project...")

    try:
        subprocess.run(["dotnet", "restore"], check=True, cwd=ROOT_DIR)
    except subprocess.CalledProcessError as e:
        print(f"Encountered error {e}", file=sys.stderr)
        sys.exit(1)

    # Install VS Code extension dependencies
    if (VSCODE_EXT_DIR / "package.json").exists():
        get_logger().info("Installing VS Code extension npm dependencies...")
        try:
            subprocess.run(
                ["npm", "install"],
                check=True,
                cwd=VSCODE_EXT_DIR,
            )
        except FileNotFoundError:
            get_logger().warning("npm not found, skipping VS Code extension setup")
        except subprocess.CalledProcessError as e:
            print(f"Encountered error {e}", file=sys.stderr)
            sys.exit(1)


def clean(args: argparse.Namespace, rest: Sequence[str]) -> None:
    get_logger().info("Cleaning project...")

    try:
        subprocess.run(["dotnet", "clean"], check=True, cwd=ROOT_DIR)
    except subprocess.CalledProcessError as e:
        print(f"Encountered error {e}", file=sys.stderr)
        sys.exit(1)

    # Clean VS Code extension dist
    vscode_dist = VSCODE_EXT_DIR / "dist"

    if vscode_dist.exists():
        get_logger().info("Cleaning VS Code extension dist/...")
        shutil.rmtree(vscode_dist)


def install(args: argparse.Namespace, rest: Sequence[str]) -> None:
    # Determine build type
    if hasattr(args, "debug") and args.debug:
        build_type = "Debug"
        get_logger().info("Installing debug build...")
    else:
        build_type = "Release"
        get_logger().info("Installing release build...")

    # Determine install prefix
    if hasattr(args, "prefix") and args.prefix:
        install_prefix = Path(args.prefix).expanduser()
    else:
        install_prefix = Path.home() / ".local"

    install_bin_dir = install_prefix / "bin"

    # Create install directory if it doesn't exist
    install_bin_dir.mkdir(parents=True, exist_ok=True)

    # Locate the built compiler
    cli_bin_dir = CLI_DIR / "bin" / build_type / "net10.0"

    if not cli_bin_dir.exists():
        get_logger().error(
            f"Compiler not found at {cli_bin_dir}. Please build it first with:"
        )
        get_logger().error(
            f"  build_sharpy build --project cli {'--release' if build_type == 'Release' else ''}"
        )
        sys.exit(1)

    # Copy the entire output directory to preserve all dependencies
    target_dir = install_prefix / "lib" / "sharpyc"

    if target_dir.exists():
        get_logger().info(f"Removing existing installation at {target_dir}...")
        shutil.rmtree(target_dir)

    get_logger().info(f"Copying compiler to {target_dir}...")
    shutil.copytree(cli_bin_dir, target_dir)

    # Create a wrapper script for easier invocation
    wrapper_script = install_bin_dir / "sharpyc"

    # Remove old wrapper if it exists (could be a file or directory)
    if wrapper_script.exists():
        if wrapper_script.is_dir():
            shutil.rmtree(wrapper_script)
        else:
            wrapper_script.unlink()

    get_logger().info(f"Creating wrapper script at {wrapper_script}...")

    with open(wrapper_script, "w") as f:
        f.write(
            f"""#!/bin/sh
exec dotnet "{target_dir}/sharpyc.dll" "$@"
"""
        )

    # Make the wrapper executable
    os.chmod(wrapper_script, 0o755)

    get_logger().info(f"✓ Sharpy compiler ({build_type}) installed successfully!")
    get_logger().info(f"  Installation directory: {target_dir}")
    get_logger().info(f"  Executable wrapper: {wrapper_script}")
    get_logger().info("")
    get_logger().info(f"To use the compiler, add {install_bin_dir} to your PATH:")
    get_logger().info(f'  export PATH="{install_bin_dir}:$PATH"')
    get_logger().info("")
    get_logger().info("Then you can run: sharpyc --help")


def format(args: argparse.Namespace, rest: Sequence[str]) -> None:
    targets = get_targets(args)

    if CSHARP_CS in targets or CSHARP_CSHARP in targets:
        format_csharp(args=args, rest=rest)

    if PYTHON_PY in targets or PYTHON_PYTHON in targets:
        format_python(args=args, rest=rest)


def format_csharp(args: argparse.Namespace, rest: Sequence[str]) -> None:
    try:
        for project in CSHARP_PROJECTS:
            if not project.exists():
                get_logger().error(f"Project file '{project}' does not exist.")
                sys.exit(1)

            get_logger().info(
                f"Formatting source files from {project.name} with dotnet-format..."
            )
            subprocess.run(
                [
                    "dotnet",
                    "format",
                    "whitespace",
                    "-v",
                    "detailed",
                    str(project),
                ],
                check=True,
            )
    except subprocess.CalledProcessError as e:
        print(f"Encountered error {e}", file=sys.stderr)
        sys.exit(1)


def format_python(args: argparse.Namespace, rest: Sequence[str]) -> None:
    """Format Python code in build_tools using ruff and black."""
    get_logger().info("Formatting Python code in build_tools...")

    # First try ruff format (fast and comprehensive)
    try:
        get_logger().info("Running ruff format...")
        subprocess.run(
            ["ruff", "format", str(BUILD_TOOLS_DIR)],
            check=True,
        )
    except FileNotFoundError:
        get_logger().warning("ruff not found, skipping ruff formatting")
    except subprocess.CalledProcessError as e:
        get_logger().warning(f"ruff format failed: {e}")

    # Then try black as fallback
    try:
        get_logger().info("Running black...")
        subprocess.run(
            ["black", str(BUILD_TOOLS_DIR)],
            check=True,
        )
    except FileNotFoundError:
        get_logger().warning("black not found, skipping black formatting")
    except subprocess.CalledProcessError as e:
        get_logger().error(f"black formatting failed: {e}")
        sys.exit(1)


def test(args: argparse.Namespace, rest: Sequence[str], release: bool) -> None:
    targets = get_targets(args)

    if CSHARP_CS in targets or CSHARP_CSHARP in targets:
        test_csharp(args=args, rest=rest, release=release)

    if PYTHON_PY in targets or PYTHON_PYTHON in targets:
        test_python(args=args, rest=rest)


def test_csharp(args: argparse.Namespace, rest: Sequence[str], release: bool) -> None:
    build_type: str = "Release" if release else "Debug"

    get_logger().info(
        f"Running tests with dotnet with {build_type.lower()} configuration..."
    )
    try:
        subprocess.run(
            ["dotnet", "test", "-c", build_type, str(CORE_TEST_DIR), *rest],
            check=True,
        )

        subprocess.run(
            ["dotnet", "test", "-c", build_type, str(COMPILER_TEST_DIR), *rest],
            check=True,
        )

        subprocess.run(
            ["dotnet", "test", "-c", build_type, str(STDLIB_TEST_DIR), *rest],
            check=True,
        )

        subprocess.run(
            ["dotnet", "test", "-c", build_type, str(LSP_TEST_DIR), *rest],
            check=True,
        )
    except subprocess.CalledProcessError as e:
        get_logger().error(f"Encountered error {e}")
        sys.exit(1)


def test_python(args: argparse.Namespace, rest: Sequence[str]) -> None:
    """Run Python tests in build_tools using pytest."""
    get_logger().info("Running Python tests in build_tools...")

    pytest_args = [
        "pytest",
        str(BUILD_TOOLS_DIR / "tests"),
        "-v",
        "--tb=short",
    ]

    # Add any extra arguments passed after --
    if rest:
        pytest_args.extend(rest)

    try:
        subprocess.run(pytest_args, check=True, cwd=ROOT_DIR)
        get_logger().info("✓ Python tests passed")
    except FileNotFoundError:
        get_logger().error("pytest not found. Install it with: pip install pytest")
        sys.exit(1)
    except subprocess.CalledProcessError as e:
        get_logger().error(f"Python tests failed: {e}")
        sys.exit(1)


# CsCheck's base-64 seed-string alphabet (SeedString.Chars64).
_CSCHECK_SEED_CHARS: str = (
    "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-"
)


def generate_cscheck_seed() -> str:
    """Return a valid CsCheck seed string for a fresh random generation start.

    Encodes a random 64-bit PCG state as 11 big-endian base-64 digits plus a
    trailing '0' stream digit — byte-identical to CsCheck's own
    ``SeedString.ToString(state, stream=0)`` (verified against CsCheck 4.7.0).
    The format is strict: a malformed ``CsCheck_Seed`` makes ``SeedString.Parse``
    throw ``IndexOutOfRangeException`` at startup, aborting *every* test in the
    invocation, so the encoding must match exactly.

    ``CsCheck_Seed`` pins only the *first* generated case per test (later
    iterations draw fresh entropy), so a fresh per-round seed keeps full
    stress diversity while making first-case crashes reproducible.
    """
    state: int = random.getrandbits(64)
    digits: str = "".join(
        _CSCHECK_SEED_CHARS[(state >> (6 * i)) & 63] for i in range(10, -1, -1)
    )
    return digits + "0"


def extract_crashing_tests(sequence_xml: Path) -> str:
    """Name the test(s) in flight when the host crashed, per a blame Sequence file.

    ``--blame-crash`` writes ``Sequence_*.xml`` marking each in-flight test with
    ``Completed="False"``; those are the blame targets.
    """
    try:
        text: str = sequence_xml.read_text()
    except OSError:
        return "(unknown)"
    running: Sequence[str] = re.findall(
        r'<Test\b(?=[^>]*\bCompleted="False")[^>]*\bName="([^"]*)"', text
    )
    if not running:
        running = re.findall(r'<Test\b[^>]*\bName="([^"]*)"', text)
    return ", ".join(running) if running else "(unknown)"


def snapshot_testhost_pids() -> AbstractSet[int]:
    """Return the PIDs of the test host processes currently running.

    Used to scope per-round cleanup to only the hosts a round spawns (see
    ``new_testhost_pids``). ``pgrep`` exits 1 when nothing matches — not an
    error for us. If ``pgrep`` is unavailable (or otherwise errors), return an
    empty set so the caller silently skips cleanup (zero behavior change);
    losing per-round cleanup is strictly safer than killing another session's
    hosts.
    """
    try:
        completed = subprocess.run(
            ["pgrep", "-f", "testhost"],
            capture_output=True,
            text=True,
        )
    except (OSError, ValueError):
        return set()
    pids: set = set()
    for token in completed.stdout.split():
        try:
            pids.add(int(token))
        except ValueError:
            continue
    return pids


def new_testhost_pids(before: set, after: set) -> set:
    """Return the test host PIDs present in ``after`` but not ``before``.

    A plain set difference, factored out so the per-round cleanup decision is
    unit-testable without spawning processes. ``before`` is the snapshot taken
    before a round starts (other sessions' hosts included); ``after`` is a
    fresh snapshot once the round finishes. Only the difference — the hosts
    *this* round spawned — is eligible to be killed.
    """
    return after - before


def kill_new_testhosts(before: AbstractSet[int]) -> None:
    """Kill only the test host processes spawned since the ``before`` snapshot.

    Scoped cleanup — never a blanket ``pkill -f testhost``. A blanket kill
    reaps test hosts belonging to OTHER concurrent agent sessions (the same
    cross-session-kill incident class as the ``pkill -f dotnet`` crashes seen
    4x during plan-f08ccf; #1132). When ``pgrep`` is unavailable the fresh
    snapshot is empty and nothing is killed (silent skip, zero behavior
    change). Residual race: a host another session starts mid-round is absent
    from ``before`` and could be caught here — accepted as strictly safer than
    a blanket pkill, and rare (test hosts are long-lived; the window is one
    round).

    Mirrors the scoped-diff cleanup in
    ``.claude/skills/property-stress/SKILL.md`` step 4 — keep both in sync.
    """
    for pid in new_testhost_pids(set(before), set(snapshot_testhost_pids())):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass


def property_test(args: argparse.Namespace, rest: Sequence[str]) -> None:
    build_type: str = "Release" if args.release else "Debug"
    rounds: int = max(1, args.rounds)

    test_filter: str = "Category=RandomProperty"
    if args.filter:
        test_filter = f"{test_filter}&FullyQualifiedName~{args.filter}"

    get_logger().info(f"Building before property tests...")
    try:
        subprocess.run(
            ["dotnet", "build", "-c", build_type, str(COMPILER_TEST_DIR), "--nologo"],
            check=True,
        )
    except subprocess.CalledProcessError as e:
        get_logger().error(f"Build failed: {e}")
        sys.exit(1)

    PROPERTY_STRESS_DIR.mkdir(parents=True, exist_ok=True)

    passes: int = 0
    failures: int = 0

    for i in range(1, rounds + 1):
        if rounds > 1:
            get_logger().info(f"=== Round {i}/{rounds} ===")

        # Fresh CsCheck seed per round: logged for reproduction, exported so the
        # round's generation start is pinned (crash watchdog, #1033).
        seed: str = generate_cscheck_seed()

        # Snapshot pre-existing test hosts (other sessions' included) so the
        # post-round cleanup targets only PIDs this round spawns. Mirrors
        # BEFORE_HOSTS in .claude/skills/property-stress/SKILL.md step 4.
        hosts_before: AbstractSet[int] = snapshot_testhost_pids()

        results_dir: Path = PROPERTY_STRESS_DIR / f"round-{i}-results"
        if results_dir.exists():
            shutil.rmtree(results_dir, ignore_errors=True)

        env: MutableMapping[str, str] = {**os.environ, "CsCheck_Seed": seed}
        get_logger().info(f"Round {i}: CsCheck_Seed={seed}")

        cmd: MutableSequence[str] = [
            "dotnet",
            "test",
            str(COMPILER_TEST_DIR),
            "-c",
            build_type,
            "--filter",
            test_filter,
            "--no-build",
            # Blame watchdog: name the running test + leave a dump if the host dies.
            "--blame-crash",
            "--blame-hang",
            "--blame-hang-timeout",
            "15m",
            "--results-directory",
            str(results_dir),
            *rest,
        ]

        result = subprocess.run(cmd, env=env)

        # Scoped cleanup: kill only the test hosts THIS round spawned, never a
        # blanket `pkill -f testhost` (that reaps other sessions' hosts — same
        # cross-session-kill incident class as `pkill -f dotnet`, #1132). This
        # mirrors the scoped diff in .claude/skills/property-stress/SKILL.md
        # step 4 — keep both in sync.
        kill_new_testhosts(hosts_before)

        if result.returncode == 0:
            passes += 1
            if rounds > 1:
                get_logger().info(f"Round {i}: PASS (seed {seed})")
            shutil.rmtree(results_dir, ignore_errors=True)
            continue

        failures += 1

        # Nonzero exit: capture blame artifacts (a host crash) or report an
        # ordinary assertion failure (CsCheck prints its own reproduction seed).
        # This logic is mirrored in .claude/skills/property-stress/SKILL.md step 5
        # (bash version) — keep both in sync.
        blame_dir: Path = PROPERTY_STRESS_DIR / f"round-{i}-blame"
        sequence_found: bool = False
        crashing_test: str = "(unknown)"
        dump_path: str = "(none)"
        if results_dir.exists():
            for seq in results_dir.rglob("Sequence_*.xml"):
                sequence_found = True
                blame_dir.mkdir(parents=True, exist_ok=True)
                shutil.copy2(seq, blame_dir / seq.name)
                crashing_test = extract_crashing_tests(seq)
            for pattern in ("*.dmp", "*.crashdump", "core.*"):
                for dump in results_dir.rglob(pattern):
                    blame_dir.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(dump, blame_dir / dump.name)
                    dump_path = str(blame_dir / dump.name)

        if sequence_found:
            get_logger().error(
                f"Round {i}: CRASH — test {crashing_test}, seed {seed}, "
                f"dump {dump_path}, blame {blame_dir}"
            )
        elif not results_dir.exists():
            # Results dir never created: if this was a host crash it predated blame
            # attachment, so no Sequence/dump artifacts exist. Flag it distinctly
            # rather than letting it pass as a plain assertion failure.
            get_logger().warning(
                f"Round {i}: FAIL (seed {seed}) — results dir absent; a crash this "
                f"early predates blame attachment, no artifacts available"
            )
        elif rounds > 1:
            get_logger().info(f"Round {i}: FAIL (seed {seed})")

        # Blame copies (if any) live under blame_dir; drop the bulky results dir.
        shutil.rmtree(results_dir, ignore_errors=True)

    if rounds > 1:
        get_logger().info(f"=== Property Test Summary ===")
        get_logger().info(f"Rounds: {rounds}  Passed: {passes}  Failed: {failures}")

    if failures > 0:
        sys.exit(1)


def get_logger() -> logging.Logger:
    global _logger
    return _logger


def setup_logger() -> None:
    global _logger

    _logger.setLevel(
        logging.DEBUG
    )  # Set the base level to the lowest level you want to capture

    # Handler for stdout (INFO and DEBUG)
    _stdout_handler = logging.StreamHandler(sys.stdout)
    _stdout_handler.setLevel(logging.DEBUG)
    _stdout_handler.addFilter(
        lambda record: record.levelno <= logging.INFO
    )  # Filter for DEBUG and INFO

    # Handler for stderr (WARNING and ERROR)
    _stderr_handler = logging.StreamHandler(sys.stderr)
    _stderr_handler.setLevel(logging.WARNING)
    _stderr_handler.addFilter(
        lambda record: record.levelno >= logging.WARNING
    )  # Filter for WARNING and ERROR

    _formatter = logging.Formatter(
        "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    )
    _stdout_handler.setFormatter(_formatter)
    _stderr_handler.setFormatter(_formatter)

    # Add handlers to the logger
    _logger.addHandler(_stdout_handler)
    _logger.addHandler(_stderr_handler)


def remove_pycache_dirs(root_path: Path):
    # Iterate over all __pycache__ directories recursively
    for pycache_dir in root_path.rglob("__pycache__"):
        if pycache_dir.is_dir():
            get_logger().info(f"Removing: {pycache_dir}")

            # Remove the __pycache__ directory
            for pycache_file in pycache_dir.iterdir():
                pycache_file.unlink()  # Remove the file

            pycache_dir.rmdir()  # Remove the directory itself


if __name__ == "__main__":
    main()
