#!/bin/bash
# Monitor peak RSS during dotnet test execution.
# Usage: .claude/scripts/test-memory-profile [--threshold MB]
#
# Samples RSS of the dotnet test process every 2 seconds and reports:
# - Peak RSS (MB)
# - Average RSS (MB)
# - Test duration
# - PASS/FAIL against threshold (default: 6144 MB = 6 GB)

set -euo pipefail

THRESHOLD_MB=${1:-6144}
if [[ "${1:-}" == "--threshold" ]]; then
    THRESHOLD_MB=${2:-6144}
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

echo "=== Sharpy Test Suite Memory Profile ==="
echo "Threshold: ${THRESHOLD_MB} MB"
echo "Starting dotnet test..."

cd "$REPO_ROOT"

LOCK_DIR="${HOME}/.claude/locks/dotnet.lock"
TEST_LOG="$SCRIPT_DIR/../tmp/test-memory-profile.log"

# Recursive RSS sum for a process tree rooted at $1 (KB).
tree_rss_kb() {
    local root_pid="$1" total=0
    local rss
    rss=$(ps -o rss= -p "$root_pid" 2>/dev/null || echo "0")
    rss="${rss// /}"
    total=$((total + ${rss:-0}))
    local kid
    for kid in $(ps -A -o pid=,ppid= 2>/dev/null | awk -v p="$root_pid" '$2 == p { print $1 }'); do
        local child_rss
        child_rss=$(tree_rss_kb "$kid")
        total=$((total + child_rss))
    done
    echo "$total"
}

"$SCRIPT_DIR/dotnet-serialized" test --no-build --filter "Category!=Benchmark" \
    > "$TEST_LOG" 2>&1 &
WRAPPER_PID=$!

# Handshake: wait until our wrapper owns the lock and the dotnet child PID is available.
echo "Waiting for dotnet lock..."
while true; do
    if ! kill -0 "$WRAPPER_PID" 2>/dev/null; then
        wait "$WRAPPER_PID" && WRAPPER_EXIT=0 || WRAPPER_EXIT=$?
        echo "Wrapper exited before sampling started (exit $WRAPPER_EXIT)"
        exit "$WRAPPER_EXIT"
    fi
    lock_owner=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
    if [[ "$lock_owner" == "$WRAPPER_PID" ]]; then
        if [[ -f "$LOCK_DIR/child" ]]; then
            DOTNET_PID=$(cat "$LOCK_DIR/child")
            if [[ -n "$DOTNET_PID" ]]; then
                echo "Lock acquired. Dotnet PID: $DOTNET_PID"
                break
            fi
        fi
    fi
    sleep 1
done

PEAK_RSS=0
TOTAL_RSS=0
SAMPLES=0
START_TIME=$(date +%s)

while kill -0 "$WRAPPER_PID" 2>/dev/null; do
    TOTAL_RSS_KB=$(tree_rss_kb "$DOTNET_PID")
    RSS_MB=$((TOTAL_RSS_KB / 1024))

    if [[ $RSS_MB -gt 0 ]]; then
        SAMPLES=$((SAMPLES + 1))
        TOTAL_RSS=$((TOTAL_RSS + RSS_MB))
        if [[ $RSS_MB -gt $PEAK_RSS ]]; then
            PEAK_RSS=$RSS_MB
        fi
    fi

    sleep 2
done

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

wait "$WRAPPER_PID" && TEST_EXIT=0 || TEST_EXIT=$?

echo ""
echo "=== Memory Profile Results ==="
echo "Duration: ${DURATION}s"
echo "Samples: ${SAMPLES}"
if [[ $SAMPLES -gt 0 ]]; then
    AVG_RSS=$((TOTAL_RSS / SAMPLES))
    echo "Peak RSS: ${PEAK_RSS} MB"
    echo "Average RSS: ${AVG_RSS} MB"
else
    echo "Peak RSS: (no samples collected)"
    AVG_RSS=0
fi
echo "Test exit code: ${TEST_EXIT}"
echo ""

if [[ $TEST_EXIT -ne 0 ]]; then
    echo "FAIL: Tests failed (exit code ${TEST_EXIT})"
    echo "See .claude/tmp/test-memory-profile.log for details"
    exit 1
fi

if [[ $PEAK_RSS -gt $THRESHOLD_MB ]]; then
    echo "FAIL: Peak RSS (${PEAK_RSS} MB) exceeds threshold (${THRESHOLD_MB} MB)"
    exit 1
else
    echo "PASS: Peak RSS (${PEAK_RSS} MB) is within threshold (${THRESHOLD_MB} MB)"
    exit 0
fi
