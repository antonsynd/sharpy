<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sharpyc</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
    <!-- #1107: runtime-only assets (batteries_v2/provider/native e_sqlite3) don't flow through the
         Stdlib reference (ReferenceOutputAssembly="false" carries only lib assets like SQLitePCLRaw.core);
         reference the bundle directly so the managed provider DLLs and runtimes/*/native/*e_sqlite3*
         co-locate with sharpyc for RuntimeClosureResolver to copy standalone. ExcludeAssets="compile"
         keeps the CLI's compile surface free of the SQLitePCL API (stdlib is discovered at runtime).
         Keep Version in lock-step with Microsoft.Data.Sqlite in Sharpy.Stdlib.csproj — the
         SQLitePCLRaw bundle/core version-drift tripwire test guards this. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" ExcludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sharpy.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sharpy.Compiler\Sharpy.Compiler.csproj" />
    <ProjectReference Include="..\Sharpy.Core\Sharpy.Core.csproj">
      <Aliases>SharpyRT</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\Sharpy.Stdlib\Sharpy.Stdlib.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Sharpy.Lsp\Sharpy.Lsp.csproj" />
  </ItemGroup>

</Project>
