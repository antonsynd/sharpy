# The `(...)` twin of event_interface_stub_pair_0001. A parenthesized ellipsis is the same stub
# (#1214), so this must emit byte-identical C# to the `...` spelling — asserted by
# EventStubEmissionTests.InterfaceEventStubPair_BothSpellings_EmitIdenticalCSharp.
delegate SimpleHandler() -> None


interface INotifier:
    event add on_action(self, handler: SimpleHandler):
        (...)

    event remove on_action(self, handler: SimpleHandler):
        (...)

    def fire(self):
        (...)


class Publisher(INotifier):
    _handlers: list[SimpleHandler] = []

    event add on_action(self, handler: SimpleHandler):
        self._handlers.append(handler)
        print("added")

    event remove on_action(self, handler: SimpleHandler):
        self._handlers.remove(handler)
        print("removed")

    def fire(self):
        for h in self._handlers:
            h.invoke()


def handler():
    print("action fired")


def main():
    n: INotifier = Publisher()
    n.on_action += handler
    n.fire()
    n.on_action -= handler
    n.fire()
    print("done")
