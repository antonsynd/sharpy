# The `(...)` twin of event_abstract_stub_inline_0001 — the inline position was the last place
# `(...)` was not transparent (#1238), so the spelling must vanish here too.
delegate SimpleHandler() -> None


@abstract
class Base:
    @abstract
    event add on_action(self, handler: SimpleHandler): (...)

    @abstract
    event remove on_action(self, handler: SimpleHandler): (...)

    @abstract
    def fire(self): (...)


class Impl(Base):
    _handlers: list[SimpleHandler] = []

    @override
    event add on_action(self, handler: SimpleHandler):
        self._handlers.append(handler)
        print("added")

    @override
    event remove on_action(self, handler: SimpleHandler):
        self._handlers.remove(handler)
        print("removed")

    @override
    def fire(self):
        for h in self._handlers:
            h.invoke()


def handler():
    print("action fired")


def main():
    b: Base = Impl()
    b.on_action += handler
    b.fire()
    b.on_action -= handler
    b.fire()
    print("done")
