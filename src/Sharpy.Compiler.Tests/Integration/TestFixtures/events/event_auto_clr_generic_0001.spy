# Auto event typed with the generic CLR EventHandler[T] (#1512, events.md "Generic
# EventHandler[TEventArgs]"). T = EventArgs here; the written arity selects EventHandler`1
# from the CLR name group and the synthesized Invoke substitutes the type argument (#1613 —
# event_auto_clr_generic_subclass_1613 proves substitution with a user-defined subclass).
from System import EventArgs


class Publisher:
    event on_change: EventHandler[EventArgs]

    def notify(self):
        self.on_change?.invoke(self, EventArgs.empty)


def handler(sender: object, e: EventArgs) -> None:
    print("changed")


def main():
    p: Publisher = Publisher()
    p.on_change += handler
    p.notify()
    print("done")
