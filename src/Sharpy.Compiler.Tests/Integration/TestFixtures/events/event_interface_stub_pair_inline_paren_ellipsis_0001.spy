# The `(...)` twin of event_interface_stub_pair_inline_0001 — the inline position was the last place
# `(...)` was not transparent (#1238), so the spelling must vanish here too.
delegate SimpleHandler() -> None


interface INotifier:
    event add on_action(self, handler: SimpleHandler): (...)

    event remove on_action(self, handler: SimpleHandler): (...)

    def fire(self): (...)


class Publisher(INotifier):
    _handlers: list[SimpleHandler] = []

    event add on_action(self, handler: SimpleHandler):
        self._handlers.append(handler)
        print("added")

    event remove on_action(self, handler: SimpleHandler):
        self._handlers.remove(handler)
        print("removed")

    def fire(self):
        for h in self._handlers:
            h.invoke()


def handler():
    print("action fired")


def main():
    n: INotifier = Publisher()
    n.on_action += handler
    n.fire()
    n.on_action -= handler
    n.fire()
    print("done")
