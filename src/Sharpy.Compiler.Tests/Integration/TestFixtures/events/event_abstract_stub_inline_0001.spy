# The inline spelling of event_abstract_stub_0001. Inline stubs only began parsing at all in #1238,
# so this is the first shape where that parser change meets #1239's lowering — and neither batch's
# own fixtures cover the combination. Must emit byte-identical C# to the block-bodied twin.
delegate SimpleHandler() -> None


@abstract
class Base:
    @abstract
    event add on_action(self, handler: SimpleHandler): ...

    @abstract
    event remove on_action(self, handler: SimpleHandler): ...

    @abstract
    def fire(self): ...


class Impl(Base):
    _handlers: list[SimpleHandler] = []

    @override
    event add on_action(self, handler: SimpleHandler):
        self._handlers.append(handler)
        print("added")

    @override
    event remove on_action(self, handler: SimpleHandler):
        self._handlers.remove(handler)
        print("removed")

    @override
    def fire(self):
        for h in self._handlers:
            h.invoke()


def handler():
    print("action fired")


def main():
    b: Base = Impl()
    b.on_action += handler
    b.fire()
    b.on_action -= handler
    b.fire()
    print("done")
