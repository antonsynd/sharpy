# The `(...)` twin of event_abstract_stub_0001. A parenthesized ellipsis is the same stub (#1214),
# so this must emit byte-identical C# to the `...` spelling — asserted by
# EventStubEmissionTests.AbstractEventStub_BothSpellings_EmitIdenticalCSharp — and run identically.
delegate SimpleHandler() -> None


@abstract
class Base:
    @abstract
    event add on_action(self, handler: SimpleHandler):
        (...)

    @abstract
    event remove on_action(self, handler: SimpleHandler):
        (...)

    @abstract
    def fire(self):
        (...)


class Impl(Base):
    _handlers: list[SimpleHandler] = []

    @override
    event add on_action(self, handler: SimpleHandler):
        self._handlers.append(handler)
        print("added")

    @override
    event remove on_action(self, handler: SimpleHandler):
        self._handlers.remove(handler)
        print("removed")

    @override
    def fire(self):
        for h in self._handlers:
            h.invoke()


def handler():
    print("action fired")


def main():
    b: Base = Impl()
    b.on_action += handler
    b.fire()
    b.on_action -= handler
    b.fire()
    print("done")
