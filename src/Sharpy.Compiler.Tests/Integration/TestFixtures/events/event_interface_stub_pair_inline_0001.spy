# The inline spelling of event_interface_stub_pair_0001: an interface add/remove pair whose bodies
# are inline stubs. This is the shape the parser agent flagged as still emitting CS0102 + CS0229
# after #1238 — the grouping fix in #1239 is what closes it. Must emit byte-identical C# to the
# block-bodied twin.
delegate SimpleHandler() -> None


interface INotifier:
    event add on_action(self, handler: SimpleHandler): ...

    event remove on_action(self, handler: SimpleHandler): ...

    def fire(self): ...


class Publisher(INotifier):
    _handlers: list[SimpleHandler] = []

    event add on_action(self, handler: SimpleHandler):
        self._handlers.append(handler)
        print("added")

    event remove on_action(self, handler: SimpleHandler):
        self._handlers.remove(handler)
        print("removed")

    def fire(self):
        for h in self._handlers:
            h.invoke()


def handler():
    print("action fired")


def main():
    n: INotifier = Publisher()
    n.on_action += handler
    n.fire()
    n.on_action -= handler
    n.fire()
    print("done")
