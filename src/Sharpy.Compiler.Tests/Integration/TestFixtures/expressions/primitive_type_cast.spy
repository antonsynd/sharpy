def main():
    x: int = 42
    # Cast to CLR primitive types
    s: short = x as! short
    print(s)
    b: byte = x as! byte
    print(b)
    # Cast using Sharpy-style names
    s2: int16 = x as! int16
    print(s2)
    b2: uint8 = x as! uint8
    print(b2)
    # Cast between CLR primitives
    u: ushort = s as! ushort
    print(u)
