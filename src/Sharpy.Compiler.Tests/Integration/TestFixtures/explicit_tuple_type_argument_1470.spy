# A `tuple[...]` written as a TYPE ARGUMENT must be the same TupleType the annotation position
# produces. It was not: the type-argument resolver built GenericType("tuple", [int, int]), which
# renders identically to tuple[int, int] and compares unequal to it — so the substituted parameter
# matched nothing (SPY0354) and the return check reported "Cannot return type
# 'Iterator[tuple[int, int]]' from function expecting 'Iterator[tuple[int, int]]'" (#1470).
#
# #1200 fixed exactly this for the top-level spelling. The type-argument position is its sibling,
# and it stayed broken — so every row below is a spelling that used to be refused, alongside the
# int/list[int] controls that always worked.
def _pairs(xs: list[int]) -> tuple[int, int]:
    i: int = 0
    while i + 1 < len(xs):
        yield (xs[i], xs[i + 1])
        i = i + 1


def pairs(xs: list[int]) -> Iterator[tuple[int, int]]:
    return iter[tuple[int, int]](_pairs(xs))


def _ints(xs: list[int]) -> int:
    for x in xs:
        yield x


def ints(xs: list[int]) -> Iterator[int]:
    return iter[int](_ints(xs))


def identity[T](v: list[T]) -> list[T]:
    return v


def main() -> None:
    for p in pairs([1, 2, 3, 4]):
        print(p)

    for i in ints([7, 8]):
        print(i)

    # The class is wider than iter: a user-defined generic and another builtin generic were
    # refused for the same reason.
    print(identity[tuple[int, int]]([(1, 2), (3, 4)]))
    print(sorted[tuple[int, int]]([(3, 4), (1, 2)]))

    # A tuple type argument on a list literal, and zip's tuple element type.
    print(iter[tuple[int, int]]([(5, 6)]) is not None)
    z: Iterator[tuple[int, int]] = iter[tuple[int, int]](zip([1, 2], [3, 4]))
    for t in z:
        print(t)
