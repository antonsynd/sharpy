# "The as-target cell runs" (#1839 close criterion): a BODY assignment to `n`, inside a suppressing
# `with` that HAS an as-target `s`, is runtime-checked exactly like plain-suppressing — the
# as-target's presence does not disturb the two-pass. No-raise here, so it prints. (The as-target
# itself is block-scoped in Sharpy and does NOT persist — reading it outside its block is SPY0200,
# "block-scoped … unlike Python" — so DD4's "binding precedes the edge → assigned" premise is void;
# that control is pinned in SuppressionWithDefiniteAssignmentMatrixTests, not here.)
class Sup:
    def __enter__(self) -> int:
        return 1
    def __exit__(self, t: object?, v: Exception?, b: object?) -> bool:
        return True

def maybe_raise(flag: bool) -> None:
    if flag:
        raise ValueError("boom")

def main() -> None:
    n: int
    with Sup() as s:
        n = 5
    print(n)
