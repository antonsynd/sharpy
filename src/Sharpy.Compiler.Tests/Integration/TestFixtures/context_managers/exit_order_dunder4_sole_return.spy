# A sole return inside a suppression-capable with is refused by SPY0266 (#1691).
# The __exit__ can suppress the exception, so the successor is reachable and
# must have a return — refused at the function level.
# Positive control: exit_order_dunder4_return_after_with (return after the with block).
#
# python3 equivalent:
#   class Tracked:
#       def __enter__(self):
#           print("enter")
#           return 1
#       def __exit__(self, exc_type, exc_val, exc_tb):
#           print("exit", exc_val is not None)
#           return False
#   def sole():
#       with Tracked():
#           print("inside")
#           return 9
#   print(sole())
#   # measured: enter / inside / exit False / 9

class Tracked:
    def __enter__(self) -> int:
        print("enter")
        return 1

    def __exit__(self, exc_type: object?, exc_val: Exception?, exc_tb: object?) -> bool:
        print("exit " + str(exc_val is not None))
        return False

def sole() -> int:
    with Tracked():
        print("inside")
        return 9

def main() -> None:
    print(sole())
