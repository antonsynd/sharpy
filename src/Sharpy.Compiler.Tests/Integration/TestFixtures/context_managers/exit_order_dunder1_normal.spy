# with-statement execution order (#1669), row 1 of 3: the no-arg `__exit__` form.
# Cell: normal completion.
#
# These cells cannot live in the DifferentialExecutionTests corpus: its shared-subset filter
# rejects both `with` (sharpy-only-node:WithStatement) and every class definition, and no
# user-defined context manager can be spelled identically in both languages anyway (Sharpy's
# no-arg `__exit__` is a TypeError in CPython, and the 4-arg form's `Exception?` annotation is a
# CPython SyntaxError). The trace below is therefore pinned here and checked by hand against the
# equivalent python3 program, whose measured output is quoted with each cell.
#
# python3 equivalent (a `__exit__(self, exc_type, exc_val, exc_tb)` that only cleans up):
#   class Simple:
#       def __enter__(self):
#           print("enter")
#           return 1
#       def __exit__(self, exc_type, exc_val, exc_tb):
#           print("exit")
#   with Simple():
#       print("inside")
#   print("after")
#   # measured: enter / inside / exit / after

class Simple:
    def __enter__(self) -> int:
        print("enter")
        return 1

    def __exit__(self) -> None:
        print("exit")

def main() -> None:
    with Simple():
        print("inside")
    print("after")
