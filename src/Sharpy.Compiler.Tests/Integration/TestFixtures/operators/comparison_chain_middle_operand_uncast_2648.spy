# A chain's middle operand read by a comparison link and then bound as the next link's membership needle
# (plan P93 D3, #2648): the comparison link is its binary twin, so it compares the operand at its own
# type, never at the needle's binding type. The capture is uncast; only the membership read casts it.
# Each wrong cast flips a result: `str` as `object` compares by reference, a `Dog` as `Animal` skips
# Dog's `__eq__`, a `long` as `float` rounds 2**53 + 1 to 2**53.

def mk(s: str) -> str:
    return s + "b"


def big() -> long:
    return 9007199254740993


class Animal:
    name: str

    def __init__(self, name: str):
        self.name = name


class Dog(Animal):
    def __init__(self, name: str):
        super().__init__(name)

    def __eq__(self, other: Dog) -> bool:
        return self.name == other.name


def same(d: Dog) -> Dog:
    return d


def main() -> None:
    a: str = "ab"
    b: str = mk("a")
    objs: list[object] = [a]
    others: list[object] = ["zz"]
    print(a == b in objs)
    print(a == mk("a") in objs)
    print(a != mk("a") in objs)
    print(a == mk("a") not in others)
    print(a == mk("a") == mk("a") in objs)
    print(a == mk("a"))

    d: Dog = Dog("rex")
    rex: Dog = Dog("rex")
    animals: list[Animal] = [rex]
    print(d == same(rex) in animals)
    print(d != same(rex) in animals)
    print(d == same(rex) == same(rex) in animals)

    n: long = 9007199254740992
    m: long = 9007199254740993
    fs: list[float] = [9007199254740992.0]
    ones: list[float] = [1.0]
    print(n == big() in fs)
    print(m == big() not in ones)
    print(n < big() not in ones)
