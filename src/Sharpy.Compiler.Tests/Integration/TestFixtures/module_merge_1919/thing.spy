# A GENERIC class named like its file (#1919 → #2039, the #2039 repro). It could not merge into
# the module class `Thing` (arity 0) nor nest in it (CS0542), so it was refused (SPY0520). Every
# module is now a namespace: `Thing<T>` is declared beside the members class `ThingModule`, and the
# program runs.
class Thing[T]:
    v: T

    def __init__(self, v: T) -> None:
        self.v = v

def main() -> None:
    print(Thing[int](7).v)
