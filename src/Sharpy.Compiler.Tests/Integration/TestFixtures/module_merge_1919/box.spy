# Control for #1919 → #2039: a NON-generic class named like its file. It used to merge into the
# module class; with no merge (ruling M2) it is an ordinary type beside the members class
# `BoxModule`, exactly like the generic thing.spy.
class Box:
    v: int

    def __init__(self, v: int) -> None:
        self.v = v

def main() -> None:
    print(Box(7).v)
