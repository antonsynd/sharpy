# Negative twin of deprecated_chaining_selected_overload: the deprecated overload is declared
# FIRST but is not the one the chaining call binds to, so nothing warns (an empty .warning).
# SPY0466 used to fire here for super().__init__, read off the first-declared __init__.

class P:
    x: int

    @deprecated("use P(n)")
    def __init__(self):
        self.x = 0

    def __init__(self, n: int):
        self.x = n

    def __init__(self, a: int, b: int):
        self.__init__(a + b)


class Base:
    x: int

    @deprecated("use Base(n)")
    def __init__(self):
        self.x = 0

    def __init__(self, n: int):
        self.x = n


class Derived(Base):
    def __init__(self):
        super().__init__(5)


def main() -> None:
    print(P(1, 2).x)
    print(Derived().x)
