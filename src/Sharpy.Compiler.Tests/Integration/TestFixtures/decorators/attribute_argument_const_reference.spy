# A bracket-attribute argument is a C# constant expression, so it admits a const reference and
# constant-valued compositions, not only literals (#1801, #1782). The emitted attribute must carry
# the const's NAME, not its value — that is what distinguishes reading the recorded CodeGenInfo
# from re-spelling the literal. Every argument below was SPY0909 "Unsupported decorator argument
# expression" or SPY0425 before the emitter arms and the admission rows landed together.
import system

const MSG: str = "Use bar() instead"
const FLAG: bool = False


@[system.obsolete(MSG, False)]
def const_reference() -> int:
    return 1


@[system.obsolete("Use " + "bar()", False)]
def folded_concat() -> int:
    return 2


@[system.obsolete("x" if True else "y", False)]
def conditional_of_literals() -> int:
    return 3


@[system.obsolete(("paren"), False)]
def parenthesized() -> int:
    return 4


@[system.obsolete("neg", not True)]
def negated() -> int:
    return 5


@[system.obsolete(MSG, FLAG)]
def two_const_references() -> int:
    return 6


def main() -> None:
    print(const_reference(), folded_concat(), conditional_of_literals(),
          parenthesized(), negated(), two_const_references())
