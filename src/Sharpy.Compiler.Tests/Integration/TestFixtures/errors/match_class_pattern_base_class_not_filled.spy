# #1308: the fill WALKS the inheritance chain with per-level substitution.
#
# `Pair[T]` derives from `Box[list[T]]`, so a scrutinee of `Pair[int]` is a
# `Box[list[int]]` — and the fill produces `Box[list[int]]`, NOT `Box[int]`.
# The match arm body entering proves the fill succeeded.

class Box[T]:
    value: T

    def __init__(self, value: T) -> None:
        self.value = value


class Pair[T](Box[list[T]]):
    def __init__(self, value: list[T]) -> None:
        super().__init__(value)


def main() -> None:
    p: Pair[int] = Pair[int]([1, 2])
    match p:
        case Box():
            print("matched Box")
        case _:
            print("other")
