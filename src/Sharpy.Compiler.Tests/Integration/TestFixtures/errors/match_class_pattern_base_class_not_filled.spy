# #1235: the fill takes the vector from the scrutinee's OWN instantiation only. It does not
# walk a base chain, and this fixture is what keeps it that way.
#
# `Pair[T]` derives from `Box[list[T]]`, so a scrutinee of `Pair[int]` is a `Box[list[int]]`
# — NOT a `Box[int]`. Filling `case Box():` by copying the scrutinee's type arguments
# positionally would produce `Box[int]`: a pattern that compiles, runs, and matches the
# wrong closed type, with no diagnostic anywhere, because the emitted test and the
# expectation would be wrong together. Substituting correctly through the inheritance chain
# needs per-level argument substitution, which the fill deliberately does not attempt.
#
# So a base-class pattern is REFUSED rather than guessed. A refusal is recoverable; a
# silently wrong type test is not. The same rule and the same refusal apply to the
# `isinstance(p, Box)` and `p is Box` spellings — all three were measured and agree.
#
# The remedy the message names does work for this shape: binding through
# `v: Box[list[int]] = p as! Box[list[int]]` and matching `case Box():` on that prints
# "matched via typed local".

class Box[T]:
    value: T

    def __init__(self, value: T):
        self.value = value


class Pair[T](Box[list[T]]):
    def __init__(self, value: list[T]):
        super().__init__(value)


def main() -> None:
    p: Pair[int] = Pair[int]([1, 2])
    match p:
        case Box():
            print("never")
        case _:
            print("other")
