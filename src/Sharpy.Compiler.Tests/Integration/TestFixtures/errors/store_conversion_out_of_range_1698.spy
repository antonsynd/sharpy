# Controls: the store seam admits a value SHAPE, not a type. An out-of-range
# constant and a variable of the wider type stay refused at every position
# (plan-14853b, #1698, #1688).
#
# The conditional row (line 16) reports at the OFFENDING BRANCH, not at the declaration: under a
# slot each branch goes through the store seam at its own span (#1677, #1743, R-W arm 1). Before
# that arm the same program was refused at 16:5 with the same code and the same message; only the
# column moved, and `300` is the operand the user has to change.

def takes_narrow(n: int8) -> int8:
    return n


def main():
    wide: float = 1.5

    elements: list[int8] = [300]
    print(elements[0])

    flag: bool = True
    branch: int8 = 7 if flag else 300
    print(branch)

    print(takes_narrow(n=300))

    variable: float32 = wide
    print(variable)

    huge: list[float32] = [1e40]
    print(huge[0])
