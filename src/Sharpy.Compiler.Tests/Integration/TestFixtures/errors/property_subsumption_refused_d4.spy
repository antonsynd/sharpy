# D4 (#1890): `case Box(a=x):` covers every Box, so the later `case Box(a=1):` is unreachable —
# SPY0700 subsumption, not the CS8120 ICE behind SPY0908 it reached before.
class Box:
    a: int

    def __init__(self, a: int) -> None:
        self.a = a

def classify(o: object) -> str:
    match o:
        case Box(a=x):
            return f"any {x}"
        case Box(a=1):
            return "one"
        case _:
            return "other"

def main() -> None:
    print(classify(Box(1)))
