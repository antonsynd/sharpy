# Once the `is` sibling of isinstance_open_generic_undetermined (#1235). `x is TypeName`
# is retired as a type test (#1298), so `is` is now refused before the open-generic
# question is ever asked: this fixture pins SPY0349, not the SPY0345 rationale it was
# written for. errors/isinstance_open_generic_undetermined keeps the SPY0345 coverage.

class Box[T]:
    value: T

    def __init__(self, value: T):
        self.value = value


def main() -> None:
    o: object = Box[int](5)
    if o is Box:
        print("never")
