# #1345: this cell used to pin a REFUSAL. The target names a construction of a generic BASE, and the
# candidate list printed `(T) -> Box[T]` — the class constructing itself — because the arguments
# could not be carried across the hierarchy. The header carried a flip note saying that when #1345
# landed the cell would stop refusing and become an `.expected`; this is that flip.
#
# `Box[T](Base[T])` now solves `T := int` by unifying its base clause against the target's
# `Base[int]`, so `mk` pins and lowers to `__ctor_source_0 => new Box<int>(__ctor_source_0)`.
#
# The printed line is the DELEGATE's, not a constructed value's: `print(mk)` on a pinned constructor
# reference reaches `object.ToString()` on a `Func<,>`, so what it pins is that the variable's
# declared type is the TARGET (`(int) -> Base[int]`) rather than the constructed `Box[int]` — #1270's
# rule that the pinned Sharpy type is the target itself. The construction is observed instead by
# builtins/constructor_reference_generic_base_1345.

class Base[T]:
    value: T

    def __init__(self, value: T) -> None:
        self.value = value


class Box[T](Base[T]):
    def __init__(self, value: T) -> None:
        super().__init__(value)


def main() -> None:
    mk: (int) -> Base[int] = Box
    print(mk)
