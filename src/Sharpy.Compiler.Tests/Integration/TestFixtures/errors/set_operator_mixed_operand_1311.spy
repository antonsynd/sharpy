# #1311: a lone operator overload must still type-check its argument. Before the fix a
# single-candidate `__or__` was accepted on arity alone, so these cells sailed through
# semantic analysis typed as `object` and died in codegen as SPY0908. Each must be
# refused at semantic time as SPY0222 — never an internal error. The three pairings are
# the exact cells the fix names (set|list, set|frozenset, frozenset|set); operand types
# differ per cell so each @line:col anchor matches a unique message.
def main() -> None:
    s: set[int] = {1, 2}
    fs: frozenset[int] = frozenset([1, 2])
    a = s | [3]
    b = s | fs
    c = fs | s
    print(a)
    print(b)
    print(c)
