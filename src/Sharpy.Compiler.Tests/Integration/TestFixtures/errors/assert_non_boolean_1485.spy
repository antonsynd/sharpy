# #1485 + #1558: All types with a falsy case are truth-testable in assert, matching
# the unified truthiness rule. bytes, int, str, and __bool__ types all pass.
def bytes_operand() -> None:
    assert b"data", "foo"


def int_operand() -> None:
    x: int = 3
    assert x


class Flagged:
    def __bool__(self) -> bool:
        return True


def truth_testable_operands_are_accepted() -> None:
    s: str = "text"
    assert s
    assert "literal"
    assert Flagged()


def main() -> None:
    bytes_operand()
    int_operand()
    truth_testable_operands_are_accepted()
    print("all assertions passed")
