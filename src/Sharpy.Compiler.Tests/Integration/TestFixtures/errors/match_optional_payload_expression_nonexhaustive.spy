# #1510 (reverts #1358): a payload TYPE pattern over an Optional scrutinee is refused in a match
# EXPRESSION too (SPY0498), not just a statement. #1358 had made this shape an exhaustiveness ERROR
# ("Missing cases: None"); the owner ruling on #1510 refuses the payload spelling outright — use the
# constructor cases (`case Some(v):` / `case None():`) or narrow first. The statement twin is at
# match/match_optional_payload_nonexhaustive.spy.
def probe(x: str?) -> str:
    return match x:
        case str(): "s"
        case _: "other"


def main() -> None:
    print(probe("hi"))
