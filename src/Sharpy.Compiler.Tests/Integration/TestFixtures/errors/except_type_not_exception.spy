# #1235: an except clause's type must derive from Exception. This is the same check and the
# same code `try[E]` already applies, reused rather than reinvented.
#
# It is not decoration. The `except (A, B) as e:` lowering binds at the alternatives' common
# base, and a base computed over types that are not exceptions could land on `object` —
# `catch (object e)` is not legal C#. Enforcing derivation makes the base an Exception
# subtype by construction. Before this the same shape reached codegen as CS0155 behind
# SPY0908.

class NotAnError:
    x: int = 1


def main() -> None:
    try:
        print("try")
    except NotAnError:
        print("never")
