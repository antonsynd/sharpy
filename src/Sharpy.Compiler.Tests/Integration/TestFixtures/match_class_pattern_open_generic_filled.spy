# #1235/#1708: a bare generic name in a class pattern gets its argument vector filled from the
# scrutinee's own static type. Against a `Box[int]` scrutinee — the very type that determines the
# vector — `case Box()` fills to `Box[int]` and matches, rather than being rejected (it used to be
# refused with SPY0361, a pattern rejected by the very type it matches, the opposite of CPython).
#
# The bare-collection sibling that once lived here (`case list()` against an `object` scrutinee,
# pinned as "erased to a non-generic interface") no longer exists: reification (#1708) refuses a
# bare collection pattern on an open scrutinee with SPY0345. That refusal is pinned by
# errors/match_bare_collection_open_scrutinee_refused, and the closed-scrutinee fill by
# match/match_collection_pattern_closed_scrutinee.

class Box[T]:
    value: T

    def __init__(self, value: T):
        self.value = value


def main() -> None:
    b: Box[int] = Box[int](7)
    match b:
        case Box():
            print("box filled")
        case _:
            print("other")
