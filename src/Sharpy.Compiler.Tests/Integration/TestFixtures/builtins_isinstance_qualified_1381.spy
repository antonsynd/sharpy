# `builtins.isinstance` must behave exactly like bare `isinstance` in every position (#1322,
# #1381): as a narrowing condition, and inside a @test body where assert-isinstance gets its
# special rewrites. The semantic half landed in 5c924ced2; the @test-body codegen half rode
# the #1413 commit. Each shape is written both ways beside its bare twin, so agreement is
# asserted, not assumed.
import builtins


@test
def test_qualified_single():
    x: object = 42
    assert builtins.isinstance(x, int)


@test
def test_qualified_negated():
    x: object = "hello"
    assert not builtins.isinstance(x, int)


@test
def test_qualified_or_of_singles():
    # Union-intent: rewritten from (int, str) to or-of-singles (#1532).
    x: object = 42
    assert builtins.isinstance(x, int) or builtins.isinstance(x, str)


def main() -> None:
    r: object = 7
    # Narrowing: the qualified condition narrows the read exactly as the bare one does.
    if builtins.isinstance(r, int):
        print(r + 1)
    if isinstance(r, int):
        print(r + 2)
    print(r)
