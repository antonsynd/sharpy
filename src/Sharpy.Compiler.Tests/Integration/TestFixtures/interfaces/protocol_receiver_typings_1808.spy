# One receiver, one protocol answer, whatever the TYPING (#1808). Three typings of the same protocol
# were three different answers before the membership authority existed:
#   - a DERIVED class inheriting __reversed__ was SPY0354 "No overload of 'reversed' matches (Sack)"
#     while len/bool/if/for/in/[] on the same receiver all worked;
#   - a GENERIC HOST declaring __len__ was refused at `if b:` while `bool(b)` ran (the #1808
#     divergence surviving on the host axis).
# The fourth typing — a receiver TYPED as `IEnumerable[int]` — still refuses `in` and is NOT in this
# fixture: see #1860.
# Output verified against python3 for the reversed cell (`list(reversed([1, 2]))` -> `[2, 1]`);
# truthiness follows Python's "empty is falsy" rule through __len__.
class Bag:
    items: list[int]

    def __init__(self) -> None:
        self.items = [1, 2]

    def __reversed__(self) -> int:
        for i in range(len(self.items) - 1, -1, -1):
            yield self.items[i]

class Sack(Bag):
    pass

class Box[T]:
    n: int

    def __init__(self, n: int) -> None:
        self.n = n

    def __len__(self) -> int:
        return self.n

def main() -> None:
    s: Sack = Sack()
    for x in reversed(s):
        print(x)

    b: Box[int] = Box[int](6)
    print(bool(b))
    if b:
        print("truthy")

    empty: Box[int] = Box[int](0)
    if not empty:
        print("falsy")
