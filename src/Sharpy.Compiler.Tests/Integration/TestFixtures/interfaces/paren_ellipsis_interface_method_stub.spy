# An interface method stub written `(...)` is the same stub as `...` (#1214). It used to be
# treated as a real body, drawing SPY0266 ("must return a value in all code paths").
interface Greeter:
    def greet(self, name: str) -> str:
        (...)

    def farewell(self, name: str) -> str:
        ((...))


class Hello(Greeter):
    def greet(self, name: str) -> str:
        return "hello " + name

    def farewell(self, name: str) -> str:
        return "bye " + name


def main():
    g: Greeter = Hello()
    print(g.greet("world"))
    print(g.farewell("world"))
