# super().__init__ that no base overload accepts by count is refused naming the base. It was
# CS1729 behind SPY0908.

class Base:
    x: int

    def __init__(self):
        self.x = 0

    def __init__(self, n: int):
        self.x = n


class Derived(Base):
    def __init__(self):
        super().__init__(1, 2, 3)


def main() -> None:
    print(Derived().x)
