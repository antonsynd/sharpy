def try_parse(s: str, result: out int) -> bool:
    result = int(s)
    return True

def main():
    let x=1
    let   y:int=2
    let a,b = 1,2
    let first, *rest = [1, 2, 3]
    let (p, q) = (3, 4)
    let (t) = 7
    let `let` = 8
    @suppress(SPY0451)
    let unused = 9
    if try_parse("10", out   let n):
        print(n)
    if try_parse("11", out let m:int):
        print(m)
    print(x, y, a, b, first, rest, p, q, t, `let`)
