# A keyword naming a slot already filled positionally is SPY0235 at the keyword, on an overloaded
# callee exactly as on a single-candidate one (#1810, Decision 6(b)). It used to be CS1744 behind
# SPY0908, then SPY0354 at the whole call.

def g(x: int, y: int = 0) -> str:
    return "int"

def g(x: str) -> str:
    return "str"

def main() -> None:
    print(g(1, x=2))
