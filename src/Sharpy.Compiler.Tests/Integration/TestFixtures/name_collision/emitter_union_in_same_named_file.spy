# A union named like its file (#1268 → #2039). It used to emit class EmitterUnionInSameNamedFile
# nested inside the module class of the same name (CS0542 behind SPY0908), then was refused by name
# (SPY0520). Every module is now a namespace: the union is declared beside the members class
# EmitterUnionInSameNamedFileModule, so it is an ordinary type and the program runs.
union EmitterUnionInSameNamedFile:
    case Circle(r: float)
    case Empty()


def main() -> None:
    s: EmitterUnionInSameNamedFile = EmitterUnionInSameNamedFile.Circle(5.0)
    match s:
        case Circle(r):
            print(r)
        case EmitterUnionInSameNamedFile.Empty:
            print("empty")
