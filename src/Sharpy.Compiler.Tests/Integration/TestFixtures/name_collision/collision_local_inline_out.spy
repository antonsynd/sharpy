# An inline out declaration introduces a local at the call site and draws from the same slot table
# (#1276). Uncaught, the emitter declared `value` twice and the generated C# was CS0128.

def try_parse(s: str, result: out int) -> bool:
    result = int(s)
    return True

def main() -> None:
    Value: int = 5
    success = try_parse("42", out value: int)
    print(success)
    print(value)
    print(Value)
