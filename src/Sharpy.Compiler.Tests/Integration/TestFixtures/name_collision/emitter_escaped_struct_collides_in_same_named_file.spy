# An escaped struct whose verbatim name equals the file's stem (#1268 → #2039). It was the negative
# control of emitter_escaped_struct_in_same_named_file while the module class was named by the stem;
# every module is now a namespace whose members live in `<Stem>Module`, so a type named like its
# file is an ordinary sibling type and the program runs (refused → runs, SPY0520 retired).
struct `EmitterEscapedStructCollidesInSameNamedFile`:
    n: int


def main() -> None:
    x = `EmitterEscapedStructCollidesInSameNamedFile`(4)
    print(x.n)
