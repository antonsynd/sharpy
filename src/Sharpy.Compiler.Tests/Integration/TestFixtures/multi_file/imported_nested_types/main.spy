# An imported nested type emits its DECLARING CHAIN (#1435): `Lib.Registry.Entry`, not `Lib.Entry`.
# Only the current-file branch of TypeSyntaxMapper ran the chain walk, so the same-file spelling was
# correct while the imported one was CS0426 behind SPY0908. All three nested kinds are here because
# the issue names all three and they take different emission paths.
#
# Both spellings: from-imported bare and three-segment module-qualified (#1523).
import lib
from lib import Registry


def main() -> None:
    entry: Registry.Entry = Registry.Entry(7)
    print(entry.tag)

    slot: Registry.Slot = Registry.Slot(3)
    print(slot.index)

    level: Registry.Level = Registry.Level.HIGH
    print(level == Registry.Level.HIGH)

    q_entry: lib.Registry.Entry = lib.Registry.Entry(42)
    print(q_entry.tag)

    q_slot: lib.Registry.Slot = lib.Registry.Slot(8)
    print(q_slot.index)

    # The four-segment qualified enum VALUE (lib.Registry.Level.LOW) is NOT here: the
    # member-access value path never hands off into NestedTypes, so it fails with
    # "Type 'Registry' has no member 'Level'" while the bare spelling above works — #1590.
