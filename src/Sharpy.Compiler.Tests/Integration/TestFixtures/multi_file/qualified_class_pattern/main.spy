# A module-qualified CLASS pattern (#1445). `case lib.Circle():` used to be a parse error — the
# dotted arm consumed the whole chain into a value pattern and never looked for the call parens —
# so a module qualifier changed whether the program parsed at all.
#
# `case Color.RED:` is the negative control: a dotted name with NO parens still parses as a value
# pattern rather than being swept into the class-pattern arm. It is written bare because the
# module-qualified spelling `case lib.Color.RED:` does not resolve — see TODO(#1524).
import lib
from lib import Circle
from lib import Color


def main() -> None:
    shape: lib.Shape = lib.Circle()
    match shape:
        case lib.Circle():
            print("qualified circle")
        case _:
            print("other")

    bare: lib.Shape = Circle()
    match bare:
        case Circle():
            print("bare circle")
        case _:
            print("other")

    color: Color = Color.RED
    match color:
        case Color.RED:
            print("red")
        case _:
            print("other")
