# #1608: slicing an isinstance-narrowed receiver — pins the narrowed-read lowering path
# (the emitted slice must read the narrowed receiver, not the declared object).
def describe(x: object) -> None:
    if isinstance(x, list[int]):
        print(x[1:3])
    else:
        print("not a list")


def main():
    xs: list[int] = [10, 20, 30, 40]
    describe(xs)
    describe("plain")
