# #1608 positives: str slicing with omitted, None, negative, and step bounds, plus a
# loose-nullable (int | None) bound variable.
def main():
    s: str = "hello"
    print(s[1:4])
    print(s[:3])
    print(s[2:])
    print(s[None:2])
    print(s[-3:])
    print(s[::2])
    print(s[::-1])
    n: int | None = 2
    print(s[n:])
