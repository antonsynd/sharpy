# A mutable-collection dataclass field default is a per-instance initializer (R-A, #1684):
# the synthesized constructor lowers it to a sentinel parameter (`T? name = null`) and a
# `this.Field = name ?? <default>` body assignment, never a C# default-parameter value, so
# every instance that omits the argument gets its own fresh collection.
@dataclass
class Bag:
    xs: list[int] = [1]

def main() -> None:
    a = Bag()
    b = Bag()
    a.xs.append(2)
    print(a.xs)
    print(b.xs)
    c = Bag(xs=[9])
    print(c.xs)
