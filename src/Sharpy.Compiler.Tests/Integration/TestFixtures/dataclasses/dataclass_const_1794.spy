# The @dataclass host of the same roster: a `const` is not a dataclass field, so it is neither a
# constructor parameter nor an auto-property. Emitted as an instance property it was
# `public int SCALE { get; set; } = 3;` and `P.SCALE` came back as CS0120 behind SPY0908 (#1794).
@dataclass
class P:
    const SCALE: int = 3
    x: int
    y: int


def main() -> None:
    p = P(1, 2)
    print(p.x)
    print(p.y)
    print(P.SCALE)
