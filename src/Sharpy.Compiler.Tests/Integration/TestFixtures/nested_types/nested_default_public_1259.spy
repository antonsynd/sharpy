# #1259: Nested types default to public — cross-class access without @public.
class Outer:
    class Inner:
        value: int = 10

        def describe(self) -> str:
            return f"Inner({self.value})"

    struct Point:
        x: int
        y: int

        def __init__(self, x: int, y: int):
            self.x = x
            self.y = y

    enum Color:
        Red = 1
        Blue = 2

def main() -> None:
    i: Outer.Inner = Outer.Inner()
    print(i.describe())
    p: Outer.Point = Outer.Point(3, 4)
    print(p.x)
    print(Outer.Color.Blue)
