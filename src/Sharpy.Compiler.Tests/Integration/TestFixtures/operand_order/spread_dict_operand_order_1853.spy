# GenerateSpreadDictBuilder: a dict entry's key and value are sibling operands that evaluate left to
# right (#1853). In {**base, take(xs): len(...)}, `take` pops first (returning 1, leaving [2, 3]) so
# the value len is 2: {9: 9, 1: 2}. Before the fix the comprehension in the value hoisted above the
# entry and ran before the key: len 3 -> {9: 9, 1: 3}.
#
# python3 3.12:
#   def take(xs): return xs.pop(0)
#   base={9:9}; xs=[1,2,3]
#   print({**base, take(xs): len([v for v in xs])})  # measured: {9: 9, 1: 2}
def take(xs: list[int]) -> int:
    return xs.pop(0)


def main() -> None:
    base: dict[int, int] = {9: 9}
    xs: list[int] = [1, 2, 3]
    print({**base, take(xs): len([v for v in xs])})
