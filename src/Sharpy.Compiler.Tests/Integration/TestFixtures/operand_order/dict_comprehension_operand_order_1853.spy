# GenerateImperativeComprehension: a dict comprehension entry's key and value are sibling operands
# that evaluate left to right (#1853). `take` pops first (returning 1, leaving [2, 3]) so the value
# len is 2: {1: 2}. Before the fix the comprehension in the value hoisted above the entry assignment
# and ran before the key: len 3 -> {1: 3}.
#
# python3 3.12:
#   def take(xs): return xs.pop(0)
#   xs=[1,2,3]
#   print({take(xs): len([v for v in xs]) for _ in range(1)})  # measured: {1: 2}
def take(xs: list[int]) -> int:
    return xs.pop(0)


def main() -> None:
    xs: list[int] = [1, 2, 3]
    print({take(xs): len([v for v in xs]) for _ in range(1)})
