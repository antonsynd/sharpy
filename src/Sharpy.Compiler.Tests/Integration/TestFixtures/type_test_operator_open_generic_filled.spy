# #1235: `as?`/`as!` name a runtime type exactly as isinstance does, so a bare
# generic name gets its argument vector filled from the tested value's own static type.
# `x is TypeName` was retired as a type test (#1298) — the `as?`/`as!` halves keep
# the fill-from-subject coverage.

class Box[T]:
    value: T

    def __init__(self, value: T):
        self.value = value


def main() -> None:
    b: Box[int] = Box[int](42)

    c = b as? Box
    if c is not None:
        print("as? filled")

    d = b as! Box[int]
    print(d.value)
