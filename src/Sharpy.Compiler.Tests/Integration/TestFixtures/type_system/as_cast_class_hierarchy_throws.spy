class Animal:
    def speak(self) -> str:
        return "..."

class Dog(Animal):
    def speak(self) -> str:
        return "woof"

class Cat(Animal):
    def speak(self) -> str:
        return "meow"

def main() -> None:
    a: Animal = Dog()
    # as! is the throwing form: a failed downcast raises at runtime rather than
    # returning None (that is the as? form's job).
    c: Cat = a as! Cat
    print(c.speak())
