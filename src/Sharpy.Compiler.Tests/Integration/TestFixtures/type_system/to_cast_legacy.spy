# Retained until `to` retirement (#1127); exercises the transitional `to` cast spelling.
# `as!` / `as?` are the primary cast forms — see type_system/as_cast* for their coverage.
# SPY0479 fires on each `to` cast below (advisory Hint) suggesting the `as!` / `as?` spelling;
# it is advisory-only here and does not affect compilation.

class Animal:
    def speak(self) -> str:
        return "..."

class Dog(Animal):
    def speak(self) -> str:
        return "woof"

def main() -> None:
    # `to T` — throwing cast; the boxed int unboxes to int.
    boxed: object = 42
    n: int = boxed to int
    print(n)

    # `to T?` — safe cast; success yields Some, failure yields None.
    ok: int? = boxed to int?
    print(ok ?? -1)
    text: object = "nope"
    bad: int? = text to int?
    print(bad ?? -1)

    # `to T?` numeric narrowing (#1110): in-range float truncates toward zero, out of range -> None.
    f: float = 3.9
    print((f to int?) ?? -1)
    big: float = 1e30
    print((big to int?) ?? -1)

    # Downcast through the throwing `to` reaches the runtime type.
    a: Animal = Dog()
    d: Dog = a to Dog
    print(d.speak())

    # `?? default` chaining flows the default when a safe cast fails.
    print((text to int?) ?? 99)
