# #1500: a lambda parameter that shadows the setter's value parameter was rewritten to C#'s
# implicit `value` too, because the accessor rewrite matched by SPELLING with no scope. The lambda
# then ignored its argument: `f(3)` computed `value * 2 == 200` instead of `6`.
# CPython control (python3.12): 106. Sharpy before the fix: 300, with no diagnostic.
# The cell is DISCRIMINATING by construction — the argument (3) differs from the incoming value
# (100), so the two candidate lowerings cannot agree (the issue's first probe passed only because
# it applied the lambda to the setter's own value).
class Box:
    total: int

    def __init__(self) -> None:
        self.total = 0

    property set scaled(self, v: int):
        f: (int) -> int = lambda v: v * 2
        self.total = f(3) + v

    property get scaled(self) -> int:
        return self.total


def main() -> None:
    b: Box = Box()
    b.scaled = 100
    print(b.scaled)
