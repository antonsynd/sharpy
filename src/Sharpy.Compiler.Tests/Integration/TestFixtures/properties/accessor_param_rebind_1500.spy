# #1500, the write side of the same mechanism (found while fixing it, measured 2026-08-13).
# Assigning to the accessor's named value REBINDS it, exactly as a Python parameter rebinds. The
# emitter used to declare a fresh local (`var v = value + 1`) while every later read still mapped
# the spelling onto `value`, so the write was silently dropped.
# CPython control (python3.12): 101. Sharpy before the fix: 100, with no diagnostic.
class Box:
    total: int

    def __init__(self) -> None:
        self.total = 0

    property set scaled(self, v: int):
        v = v + 1
        self.total = v

    property get scaled(self) -> int:
        return self.total


def main() -> None:
    b: Box = Box()
    b.scaled = 100
    print(b.scaled)
