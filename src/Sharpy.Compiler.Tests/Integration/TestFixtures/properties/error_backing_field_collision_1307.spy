# #1307: the spec's own function-style-setter example declared `_celsius` beside a `celsius`
# auto getter. The mixed form synthesizes `_Celsius` itself, so the declaration duplicates it
# (CS0102/CS0229 as SPY0908 before this rule).
class Temperature:
    _celsius: float = 0.0

    property set celsius(self, value: float):
        if value < -273.15:
            raise ValueError("Temperature below absolute zero")
        self._celsius = value

    property get celsius: float


def main() -> None:
    t = Temperature()
    t.celsius = 21.5
    print(t.celsius)
