# #1500, the write side through augmented assignment: `v += 7` must read and write the accessor's
# value slot, keeping that path's own operator lowering.
# CPython control (python3.12): 107.
class Box:
    total: int

    def __init__(self) -> None:
        self.total = 0

    property set scaled(self, v: int):
        v += 7
        self.total = v

    property get scaled(self) -> int:
        return self.total


def main() -> None:
    b: Box = Box()
    b.scaled = 100
    print(b.scaled)
