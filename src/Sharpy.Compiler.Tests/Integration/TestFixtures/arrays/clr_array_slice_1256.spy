# Test (#1256): slicing a CLR array produces a Sharpy list, with Python slice semantics.
#
# Before this, an array-typed slice had no lowering at all: the emitted Slice.GetSlice call bound the
# `string` overload and leaked CS1503 behind SPY0908, and the natural annotation
# `xs: list[str] = <array slice>` drew SPY0220 because a slice of array[T] was typed array[T].
#
# The source is deliberately NOT sys.argv. argv became a list[str] in the same change, so it now
# exercises LIST slicing — pinning the array path through argv would have quietly stopped testing it.
# `to_char_array()` returns a genuine CLR char[].
#
# Expected values verified against CPython (list('hello') sliced identically) and now agree with it
# character for character. They did not when this fixture was written: the char rows printed
# `[e, l, l]` for CPython's `['e', 'l', 'l']`, because a char[]'s elements emitted as C# `char` and a
# Sharpy list of char prints its elements unquoted. That divergence was the visible half of #1291,
# whose annotated positions were the SPY0908 half; both are closed by converting the char[] to a
# string[] where it is produced, so the rows below are ordinary list-of-str printing.
#
# The char[] annotation this fixture originally had to avoid is now pinned directly (see the `x: str`
# and `list[str]` rows), alongside the string[] source that stood in for it.
from system import Environment


def main() -> None:
    cs = "hello".to_char_array()
    print(len(cs))

    # Plain indexing is unchanged: still the element, not a slice.
    print(cs[0])

    print(cs[1:4])
    print(cs[-2:])
    print(cs[::-1])
    print(cs[0:0])

    # The char[] rows the fixture used to route around (#1291). An element in a str slot and a slice
    # in a list[str] slot are the two positions that leaked CS0029 behind SPY0908.
    x: str = cs[0]
    print(x)
    tail_chars: list[str] = cs[1:]
    print(tail_chars)

    # The annotation a user would naturally write is now well-typed by construction. Only
    # invocation-independent facts are asserted, since the argument vector varies by host.
    argv = Environment.get_command_line_args()
    tail: list[str] = argv[1:]
    print(len(tail) == len(argv) - 1)
    print(len(argv[0:0]))
