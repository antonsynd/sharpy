# dict(a=1, b=2) is CPython's keyword-argument dict constructor: the kwarg NAMES are the keys.
# The construction path had no arm for keyword arguments, so inference fell through to dict[?, ?]
# and the emitter turned that into the static-class-as-value shape (CS0712/CS0723, #1220).
def main():
    d = dict(a=1, b=2)
    print(d)
    print(len(d))
    print(d["a"])

    # Mixed value types unify exactly as the equivalent literal {"a": 1, "b": "x"} does — the two
    # spellings of one construct must not disagree.
    mixed = dict(a=1, b="x")
    print(len(mixed))

    # The keyword construct through a PINNED reference rather than the bare name. The alias spelling
    # (`alias = dict; alias(c=3, d=4)`) covered this until #1248 retired it; the construct itself is
    # unchanged and must still carry its keyword arguments.
    keyed: dict[str, int] = dict(c=3, d=4)
    print(keyed)
    print(keyed["d"])
