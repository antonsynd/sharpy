# The CLR<->Sharpy sequence seam, as a matrix (#1251, #1252, #1256, #1260, #1531).
#
# Two actual kinds — a Sharpy list and a CLR List[T] — against three positions:
#   * a CLR-ORIGIN formal   (a parameter the bridge mapped from CLR metadata, spelled `list[T]`)
#   * a SHARPY-NATIVE formal (a parameter written `list[T]` in Sharpy source)
#   * an ANNOTATED Sharpy target
#
# Arrays are now honestly typed (#1531): a CLR array-returning call types as `array[T]`,
# and `array[T]` does not convert implicitly to `list[T]` — refused with a `list(...)` steer.
# The refused cells are pinned as .error siblings:
#   clr_array_to_list_formal_refused_1531
#   clr_array_to_annotated_target_refused_1531
#
# The rule the matrix encodes: a CLR-origin formal accepts exactly what .NET binds, because the
# emitted formal IS the CLR type; a Sharpy-native slot means the Sharpy collection, so a CLR value
# either materializes into one or is refused. Five cells work and are pinned here. The CLR List
# refusals are deliberate and pinned next door (bcl_extension_native_formal_strict_1260,
# clr_list_to_annotated_target_refused).
from system.collections.generic import List
from system import Environment


def native_formal(xs: list[str]) -> int:
    return len(xs)


def main() -> None:
    sharpy_list = ["a", "b"]

    clr_list = List[str]()
    clr_list.add("a")
    clr_list.add("b")

    # --- CLR-origin formal (LINQ concat's IEnumerable<T> parameter, mapped to list[str]) ---
    print(list(sharpy_list.concat(sharpy_list)))
    print(list(clr_list.concat(sharpy_list)))

    # --- Sharpy-native formal ---
    print(native_formal(sharpy_list))

    # --- Annotated Sharpy target ---
    annotated_from_sharpy: list[str] = sharpy_list
    print(annotated_from_sharpy)

    # --- Positive control: list(array) works (the steer is honest) ---
    clr_array = Environment.get_command_line_args()
    converted: list[str] = list(clr_array)
    print(len(converted) == len(clr_array))
