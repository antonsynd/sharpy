# #1573: an `int` must not be admitted at an enum-typed CLR parameter. `Compare(String, String,
# StringComparison)` once accepted a Sharpy `int` because the bridge described every enum as its
# underlying `int32`, which made it the unique candidate while the emitted C# needed the enum (CS1503
# behind SPY0908); the sibling `Compare(String, String, Boolean)` refuses an int outright. Nothing
# fits, and the refusal now NAMES both candidates' parameter types, because the enum parameter is
# described as the enum itself (#1705) — so the Sharpy vocabulary is what refuses, and the
# same-argument rule (#1775) can state it. C# refuses this call too: only the literal 0 converts to
# an enum.
from system import String


def main() -> None:
    r: int = String.compare("a", "b", 1)
    print(r)
