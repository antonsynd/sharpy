# #1573: the enum→int bridge arm must not manufacture a unique candidate.
# Compare(String, String, StringComparison) accepts a Sharpy `int` through its `int`
# spelling while the emitted C# needs the enum (CS1503 behind SPY0908); the sibling
# Compare(String, String, Boolean) refuses an int outright. Nothing fits: no-match.
from system import String


def main() -> None:
    r: int = String.compare("a", "b", 1)
    print(r)
