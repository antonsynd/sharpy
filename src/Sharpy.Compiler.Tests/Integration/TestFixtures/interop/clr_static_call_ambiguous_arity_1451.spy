# Conservatism control for #1451 / #1530. `Math.floor` has TWO overloads of arity 1 (double and
# decimal). With argument-driven unique-candidate selection (#1530), `Math.floor(1.5)` is no longer
# ambiguous: `float64` has no implicit path to `decimal`, so `Math.Floor(double)` is the unique
# survivor and the call types as `float64`.
#
# `v: float = Math.floor(1.5)` works because `float64` assigns to `float` (both map to C# double).
# The mismatched-destination case (`b: bool = Math.floor(1.5)` → SPY0220) is pinned next door.
from system import Math


def main() -> None:
    v: float = Math.floor(1.5)
    print(v)

    w: float = Math.floor(-1.5)
    print(w)
