# Pin: the unslotted order_by/then_by chain must survive the IOrderedEnumerable bridge
# arm (#1332). In the emitted C# the chain is a single expression where OrderBy returns
# IOrderedEnumerable<T> and ThenBy extends it — no materialization intervenes.
#
# The slotted variants ship their own pins (#1390), and they differ:
#   - clr_order_by_then_by_slot_1390.spy      — `xs = lst.order_by(f)` then `xs.then_by(g)`
#     WORKS. IOrderedEnumerable<T> maps to itself, so an inferred slot keeps the ordering
#     context instead of materializing into a Sharpy list.
#   - clr_then_by_list_slot_refusal_1390.spy  — `xs: list[int] = lst.order_by(f)` then
#     `xs.then_by(g)` REFUSES with SPY0203. The annotation asks for a Sharpy list, which is
#     not an IOrderedEnumerable<T>; that is the materialization contract
#     (dotnet_interop.md:162) doing what it says, reported instead of deferred to codegen.
from system.collections.generic import List


def main() -> None:
    lst: List[int] = List[int]()
    lst.add(3)
    lst.add(1)
    lst.add(2)
    lst.add(1)

    # Unslotted chain — must keep working
    for x in lst.order_by(lambda v: v).then_by(lambda v: -v):
        print(x)
