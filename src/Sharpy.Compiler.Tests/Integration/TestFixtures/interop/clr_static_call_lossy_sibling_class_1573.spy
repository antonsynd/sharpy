# #1573: the same rule beside a class-typed sibling. `EnumerateFiles(String, String, SearchOption)`
# accepted `1` through the enum's old `int32` spelling and became the unique candidate over
# `EnumerateFiles(String, String, EnumerationOptions)`; the emitted C# was CS1503 behind SPY0908.
# Neither overload takes an int, and the refusal names both parameter types now that an enum
# parameter is described as the enum (#1705).
from System.IO import Directory


def main() -> None:
    for f in Directory.enumerate_files(".", "*", 1):
        print(f)
