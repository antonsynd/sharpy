# #1687: an imported CLR type keeps the name it was IMPORTED under, and its members resolve under
# the reverse-mangled Sharpy spelling.
from system import Guid
from system import Uri

def main() -> None:
    g: Guid = Guid.new_guid()
    print(len(g.to_string()) > 0)
    u = Uri("https://example.com/x")
    print(u.host)
