# #1510 (reverts #1358): a bare payload TYPE pattern over an Optional scrutinee is REFUSED with a
# steer to the constructor cases (SPY0498). #1358 had classified `case str():` over `str?` as the
# synthetic Some case; the owner ruling on #1510 (2026-08-13) reverses that — Optional and Result
# both match through their constructor spellings, and the payload form hid a CS8121 ICE. This
# fixture pins the refusal across the payload shapes #1358 covered: a reference payload, a payload
# SUBTYPE, a value-type payload, and a match EXPRESSION. Each arm carries a wildcard so the ONLY
# diagnostic is the refusal (no exhaustiveness/return cascade); `!SPY0908` pins that CS8121 never
# returns (the refusal fires at semantic time, before codegen).
def probe_str(x: str?) -> None:
    match x:
        case str():
            print("str")
        case _:
            print("other")


def probe_subtype(a: object?) -> None:
    match a:
        case str():
            print("str")
        case _:
            print("other")


def probe_value_type(x: int?) -> None:
    match x:
        case int():
            print("int")
        case _:
            print("other")


def probe_expression(x: str?) -> str:
    return match x:
        case str(): "s"
        case _: "other"


def main() -> None:
    probe_str("hi")
    probe_subtype("hi")
    probe_value_type(3)
    print(probe_expression("hi"))
