# #1510 (reverts #1358): #1358 made exhaustiveness count `case str():` over `str?` as the Some case,
# so only `None` read as missing. The owner ruling on #1510 refuses the payload pattern outright
# (SPY0498), so there is no payload-pattern-as-Some contribution left to exhaustiveness — this
# fixture, formerly the pin for that contribution, now pins the refusal. The remedy is the
# constructor cases (`case Some(v):` / `case None():`) or narrowing first.
def probe(x: str?) -> None:
    match x:
        case str():
            print("str")
        case _:
            print("other")


def main() -> None:
    probe("hi")
