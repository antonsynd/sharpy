# #1816: a break in a plain (unguarded) match arm targets the enclosing loop, not the C# switch
# the emitter manufactures. Python prints `0 1 done`; before the fix Sharpy printed `0 1 3 done`.
def main() -> None:
    for i in range(4):
        match i:
            case 2:
                break
            case _:
                print(i)
    print("done")
