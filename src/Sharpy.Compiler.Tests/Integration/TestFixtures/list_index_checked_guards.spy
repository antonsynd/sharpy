# Conservatism guards for the non-negative index fast path (#1052): each access
# below is NOT provably >= 0, so it must stay on the checked indexer (native
# Sharpy.List indexer with negative-index Normalize) and keep Python semantics.
def main() -> None:
    xs: list[int] = [5, 6, 7, 8]

    # Negative literals index from the back -> stay checked.
    print(xs[-1])
    print(xs[-2])

    # Induction variable reassigned in the body -> stays checked.
    for i in range(len(xs)):
        i = len(xs) - 1 - i
        print(xs[i])

    # Induction variable reassigned inside a nested block -> stays checked.
    for j in range(len(xs)):
        if j == 0:
            j = 2
        print(xs[j])

    # range(start, stop) with a negative start can yield negatives -> stays checked.
    for k in range(-1, 0):
        print(xs[k])
