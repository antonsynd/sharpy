# SPY0344: isinstance() in Sharpy accepts only a single type argument.
# Passing a tuple of types — the legal Python 3 spelling for OR-of-types —
# is rejected at semantic time. The restriction is load-bearing, not stylistic:
# a successful check narrows to one concrete type, and a tuple has nothing to
# narrow to. Lowering it would emit a correct boolean and then silently fail to
# narrow at the next line, so the form is refused instead.
# This diagnostic replaces the retired SPY0475 hint, which let compilation
# continue into a generated-C# failure (SPY0908).

class Animal:
    name: str = ""

class Dog(Animal):
    pass

class Cat(Animal):
    pass

def main():
    a: Animal = Dog()
    if isinstance(a, (Dog, Cat)):
        print("matched")
