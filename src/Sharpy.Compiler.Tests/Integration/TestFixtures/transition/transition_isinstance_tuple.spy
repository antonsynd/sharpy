# SPY0499: isinstance() tuple type test is statically impossible.
# Under type-position semantics (#1532), (Dog, Cat) denotes tuple[Dog, Cat].
# The scrutinee's static type is Animal, which is never a tuple —
# the test is statically impossible and is refused.

class Animal:
    name: str = ""

class Dog(Animal):
    pass

class Cat(Animal):
    pass

def main():
    a: Animal = Dog()
    if isinstance(a, (Dog, Cat)):
        print("matched")
