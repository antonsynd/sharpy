union Maybe:
    case Valid(value: int)
    case Invalid(message: str)

    def is_ok(self) -> bool:
        match self:
            case Valid(_):
                return True
            case Invalid(_):
                return False

    def unwrap_or(self, default: int) -> int:
        match self:
            case Valid(v):
                return v
            case Invalid(_):
                return default

def main():
    ok: Maybe = Maybe.Valid(42)
    err: Maybe = Maybe.Invalid("fail")
    print(ok.is_ok())
    print(err.is_ok())
    print(ok.unwrap_or(0))
    print(err.unwrap_or(0))
