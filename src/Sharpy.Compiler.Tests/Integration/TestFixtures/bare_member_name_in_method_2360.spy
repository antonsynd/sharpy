# P21g (#2360) hazard (6): the member-declaration seam must not change the verdict of a bare read of a
# type-body member — SPY0200 with the class-scope steer, never a binding (a property or event bound by
# its bare name would type Unknown or reach the identifier checker's unrecognized-subtype arm). One
# cell per member kind read inside a method (the walk's crossing, #1786), and the class-BODY reads of
# a property: a field initializer and a parameter default, each ONE SPY0200 naming its position (P21h
# D8, R-JJ — no SPY0401 beside the parameter default's). The event gets the self steer like the rest.


class FieldRead:
    f: int = 1

    def m(self) -> int:
        return f


class PropertyRead:
    property p: int = 1

    def m(self) -> int:
        return p


class EventRead:
    event e: Action[int]

    def m(self) -> None:
        print(e)


class InitializerRead:
    property p: int = 1
    q: int = p


class DefaultRead:
    property p: int = 1

    def m(self, x: int = p) -> int:
        return x


def scale(x: int) -> int:
    return x + 100


class CallRead:
    def scale(self, x: int) -> int:
        return x * 2

    v: int = scale(3)
    w: int = scale(x=4)


def main() -> None:
    print(FieldRead().m())
