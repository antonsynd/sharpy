# P21g (#2360) hazard (6): the member-declaration seam must not change the verdict of a bare read of a
# type-body member — SPY0200 with the class-scope steer, never a binding (a property or event bound by
# its bare name would type Unknown or reach the identifier checker's unrecognized-subtype arm). One
# cell per member kind read inside a method (the walk's crossing, #1786), and the class-BODY reads of
# a property: a field initializer and a parameter default. The event has no steer — today's text,
# pinned, not improved. The parameter default's SPY0401 is its pinned cascade (P21g D10).


class FieldRead:
    f: int = 1

    def m(self) -> int:
        return f


class PropertyRead:
    property p: int = 1

    def m(self) -> int:
        return p


class EventRead:
    event e: Action[int]

    def m(self) -> None:
        print(e)


class InitializerRead:
    property p: int = 1
    q: int = p


class DefaultRead:
    property p: int = 1

    def m(self, x: int = p) -> int:
        return x


def main() -> None:
    print(FieldRead().m())
