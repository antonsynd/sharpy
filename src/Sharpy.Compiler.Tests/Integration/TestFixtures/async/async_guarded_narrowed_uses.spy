# plan-775c50 D6: an `async def` body's use of a Guarded value the checker narrowed names
# the value's helpers from its own spelling, never from the narrowed read (`g!`, a cast).
class Box:
    x: int

    def __init__(self, x: int):
        self.x = x

async def two() -> int:
    return 2

g: str | None = "abc"
t: str | None = "tru"
w: str | None = None
e: str | None = "early"
a: str | None = "asserted"
m: str | None = "matched"
items: list[int] | None = [1]
o: object = [1, 2]
h: Box | None = Box(1)

class C:
    @static
    s: list[int] | None = [5]
    @static
    st: str | None = "cs"
    @static
    sb: Box | None = Box(3)

async def main():
    if g is not None:
        print(g.upper())
    if items is not None:
        x = await two()
        items.append(x)
        items[0] = 7
        print(items)
    if isinstance(o, list[int]):
        o.append(await two())
        print(o)
    if t:
        print(t.upper())
    if (w := "wal") is not None:
        print(w.upper())
    assert a is not None
    print(a.upper())
    match m:
        case str():
            print(m.upper())
        case _:
            print("none")
    if h is not None:
        h.x = await two()
        h.x += 1
        print(h.x)
    if C.s is not None:
        C.s.append(await two())
        C.s[0] = 8
        print(C.s)
    if C.st:
        print(C.st.upper())
    if C.st is not None:
        print(C.st.upper())
    if C.sb is not None:
        C.sb.x = await two()
        print(C.sb.x)
    if e is None:
        return
    print(e.upper())
