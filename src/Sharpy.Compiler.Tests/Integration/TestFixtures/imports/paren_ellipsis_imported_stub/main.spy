from shapes import Greeter, GreeterBase


class Polite(GreeterBase):
    @override
    def salutation(self) -> str:
        return "dear"

    # `greet` is inherited from GreeterBase as abstract because the `(...)` body in the imported
    # module is classified as a stub — so @override is required here, exactly as it would be for a
    # `...` body. NOTE: the classification comes from NameResolver, not from ModuleLoader's
    # cross-module symbol extraction. Measured 2026-08-06 (#1258): disabling
    # ModuleLoader.ExtractFullInterfaceSymbol's stub marking outright leaves this fixture green,
    # because since #1087 the entry file's local-import closure is lowered into a synthetic project
    # and every unit is name-resolved (#1267). The ModuleLoader seam is pinned by
    # `Semantic/StubClassificationTableTests`, not here.
    @override
    def greet(self, name: str) -> str:
        return self.salutation() + " " + name


def main():
    g: Greeter = Polite()
    print(g.greet("ada"))
