# An inline out declaration is a value-position binding like any other, so the backtick escape has
# to reach it. Without the flag on ModifiedArgument the symbol was bound bare, which destroyed the
# builtin for the rest of the scope: the bare `int(3)` below was refused with SPY0201 "'int' is not
# callable" — the same failure shape the walrus target had (#1326).
def try_parse(s: str, result: out int) -> bool:
    result = int(s)
    return True

def main():
    success = try_parse("42", out `int`: int)
    print(success, `int`)
    # Bare: still the builtin conversion, in the same scope as the escaped twin.
    print(int(3))
