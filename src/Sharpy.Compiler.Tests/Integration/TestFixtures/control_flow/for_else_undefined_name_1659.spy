# #1659: the else: body of a for loop was never type-checked — an undefined name in it
# reached the C# compiler (pre-fix @ 97e60e2b4: SPY0908 CS0103). It is now checked like the
# loop body, so the semantic diagnostic fires.
def main() -> None:
    for i in range(2):
        print(i)
    else:
        undefined_name()
    print("done")
