# #1723 while-test walrus host cell: IndexAccess host with a while…else clause. python3-verified. @ e523ceec3: looped forever (walrus hoisted once).
def main():
    d: dict[str, int] = {"x": 1, "y": 2, "z": 0}
    ks: list[str] = ["x", "y", "z"]
    while d[(k := ks.pop(0))]:
        print(k)
    else:
        print("else")
    print("done", len(ks))
