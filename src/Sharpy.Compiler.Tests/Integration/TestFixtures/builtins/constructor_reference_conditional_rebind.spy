# #1248 is CLOSED BY CONSTRUCTION, and this fixture records how.
#
# The defect: a constructor alias rebound inside a conditional resolved against the binding that
# reached the `if`, not the one the branch installed, and did so SILENTLY — `taken()` returned
# "meow" where CPython returns "woof". The cause was the alias being resolved where it was READ,
# which is a property of a construct with no runtime value at all.
#
# The fix is not a flow-analysis correction. The construct is retired (#1248), so every binding
# below is refused where it is written and the wrong-answer shape cannot be spelled. The
# CPython-matching replacement is pinned next door in constructor_reference_annotated_rebind.
#
# Each function names a different class so every expected message is unique.
class Cat:
    def speak(self) -> str:
        return "meow"


class Dog:
    def speak(self) -> str:
        return "woof"


class Fox:
    def speak(self) -> str:
        return "ring"


def taken() -> str:
    flag: bool = True
    f = Cat
    if flag:
        f = Dog
    return f().speak()


def straight_line() -> str:
    g = Fox
    return g().speak()


def main():
    print(taken())
    print(straight_line())
