# #1272: frozenset, frozendict, object and decimal have constructor-reference families, so an
# annotated target pins them the way `list` has always pinned. bytes joined them with the
# Conversion family when its statics moved to BytesFromhex (#1347); only Iterator/DictKeyView
# stay unfamilied — non-constructible, refused as SPY0346 (#1346).
def main() -> None:
    mkfs: () -> frozenset[int] = frozenset
    print(len(mkfs()))

    mkfd: () -> frozendict[str, int] = frozendict
    print(len(mkfd()))

    mko: () -> object = object
    print(str(mko()) != "")

    mkd: (str) -> decimal = decimal
    print(mkd("1.5"))

    mkb: (int) -> bytes = bytes
    print(len(mkb(4)))
