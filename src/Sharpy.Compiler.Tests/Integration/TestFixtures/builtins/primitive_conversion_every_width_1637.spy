# #1637: which conversion a primitive type name denotes is a fact of the CLR type, never of
# the spelling — canonical width (int32), python-facing (int), and C# alias (long/sbyte/…)
# all call the same Builtins method. Every width x {canonical, alias} x {str input, int input}
# with an annotated destination (the type probe). Expected values are python3's int()/float().
def main() -> None:
    a1: int8 = int8("42")
    a2: int8 = sbyte("-42")
    print(a1, a2, int8(7) + sbyte(1))
    b1: int16 = int16("1234")
    b2: int16 = short("-1234")
    print(b1, b2, int16(7) + short(1))
    c1: int32 = int32("123456")
    c2: int32 = int("-123456")
    print(c1, c2, int32(7) + int(1))
    d1: int64 = int64("1234567890123")
    d2: int64 = long("-1234567890123")
    print(d1, d2, int64(7) + long(1))
    e1: uint8 = uint8("200")
    e2: uint8 = byte("255")
    print(e1, e2, uint8(7) + byte(1))
    f1: uint16 = uint16("60000")
    f2: uint16 = ushort("65535")
    print(f1, f2, uint16(7) + ushort(1))
    g1: uint32 = uint32("4000000000")
    g2: uint32 = uint("4294967295")
    print(g1, g2, uint32(7) + uint(1))
    h1: uint64 = uint64("18000000000000000000")
    h2: uint64 = ulong("18446744073709551615")
    print(h1, h2, uint64(7) + ulong(1))
    i1: float32 = float32("1.5")
    print(i1, float32(3))
    j1: float64 = float64("2.5")
    j2: float64 = float("-2.5")
    print(j1, j2, float64(3), float(4))
    k1: bool = bool("x")
    k2: str = str(42)
    print(k1, k2)
