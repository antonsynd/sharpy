# #1248 retired tier 2 — the call-only ALIAS. A binding with no signature available used to become
# an alias of the builtin, with each call through it resolved at its own call site; it is now
# refused where it is written.
#
# The alias was untyped BY DESIGN: it had no runtime representation, emitted no C#, and was resolved
# where it was READ rather than where it was written — a compile-time macro impersonating a value.
# With overloaded constructors, which signature was meant was unknowable until each call. C# has no
# constructor values at all, and Java's `Point::new` is legal only in target-typed positions, which
# is tier 1.
#
# One row per family, each naming a DIFFERENT type, so every expected message is unique: the harness
# matches an expected substring to the first diagnostic containing it.
def shadowed() -> int:
    # A local variable named after a builtin shadows it and stays an ordinary variable: the
    # constructor-reference rules short-circuit on the VariableSymbol, so this is NOT refused.
    dict = 5
    return dict + 1


def main():
    print(shadowed())

    f = int
    g = str
    d_maker = dict
    l_maker = list
    s_maker = set
    fl = float

    # A parenthesized binding value is still a binding value.
    b = (bool)
