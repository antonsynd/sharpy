class Circle:
    r: int

    def __init__(self, r: int) -> None:
        self.r = r

def describe(shape: object) -> str:
    if isinstance(shape, Circle):
        # Without the `failable_cast` feature the cast is gated (SPY0331).
        c: Circle = shape as! Circle
        return f"circle-{c.r}"
    return "unknown"

def main() -> None:
    print(describe(Circle(3)))
