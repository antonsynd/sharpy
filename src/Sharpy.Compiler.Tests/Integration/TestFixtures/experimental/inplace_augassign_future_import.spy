# Per-file enablement via from __future__ import (Semantic scope). No .features sidecar.
from __future__ import inplace_augassign

def main() -> None:
    xs: list[int] = [1, 2]
    t: list[int] = xs
    xs += [3]
    print(t)

    s: set[int] = {1, 2}
    u: set[int] = s
    s |= {3}
    print(sorted(u))
