# Constant expressions fold to literals under opt_const_fold (E3, #640). The program's observable
# behaviour is identical with or without the flag; the flag only changes the emitted C#.
def main() -> None:
    a: int = 2 + 3 * 4
    b: int = 100 - 7 * 8
    c: bool = 5 < 3
    d: bool = 10 > 2
    e: int = 2 ** 10 + 1
    f: int = -5 + 8
    g: bool = True and False
    h: float = 1.5 * 2.0 + 1.0
    print(a)
    print(b)
    print(c)
    print(d)
    print(e)
    print(f)
    print(g)
    print(h)
