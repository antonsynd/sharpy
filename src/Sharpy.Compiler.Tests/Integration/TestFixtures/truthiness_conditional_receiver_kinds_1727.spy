# #1727 precedence-inversion class: truthiness kind × conditional receiver.
# Each kind's receiver is a ternary (x if flag else y) — unparenthesized.
# python3-verified where an analog exists; int?/__bool__ from value-position twins.
def main() -> None:
    # ── str (StringNotEmpty) ──
    flag: bool = True
    s: str = "hello"
    t: str = ""
    if s if flag else t:
        print("str-true-branch")
    flag = False
    if s if flag else t:
        print("str-false-truthy")
    else:
        print("str-false-falsy")

    # ── int (IntNotZero) ──
    flag = True
    n: int = 42
    m: int = 0
    if n if flag else m:
        print("int-true-branch")
    flag = False
    if n if flag else m:
        print("int-false-truthy")
    else:
        print("int-false-falsy")

    # ── float (FloatNotZero) ──
    flag = True
    f: float = 3.14
    g: float = 0.0
    if f if flag else g:
        print("float-true-branch")
    flag = False
    if f if flag else g:
        print("float-false-truthy")
    else:
        print("float-false-falsy")

    # ── long (LongNotZero) ──
    flag = True
    ln: long = 42
    lm: long = 0
    if ln if flag else lm:
        print("long-true-branch")
    flag = False
    if ln if flag else lm:
        print("long-false-truthy")
    else:
        print("long-false-falsy")

    # ── bytes (BytesNotEmpty, cast arm) ──
    flag = True
    bs: bytes = b"hello"
    cs: bytes = b""
    if bs if flag else cs:
        print("bytes-true-branch")
    flag = False
    if bs if flag else cs:
        print("bytes-false-truthy")
    else:
        print("bytes-false-falsy")

    # ── list[int] (CollectionNotEmpty / SizedNotEmpty, cast arm) ──
    flag = True
    xs: list[int] = [1, 2]
    ys: list[int] = []
    if xs if flag else ys:
        print("list-true-branch")
    flag = False
    if xs if flag else ys:
        print("list-false-truthy")
    else:
        print("list-false-falsy")

    # ── dict[str, int] (CollectionNotEmpty, cast arm) ──
    flag = True
    d1: dict[str, int] = {"a": 1}
    d2: dict[str, int] = {}
    if d1 if flag else d2:
        print("dict-true-branch")
    flag = False
    if d1 if flag else d2:
        print("dict-false-truthy")
    else:
        print("dict-false-falsy")

    # ── str | None (NullableNotNull) ──
    flag = True
    ns: str | None = "hello"
    nt: str | None = None
    if ns if flag else nt:
        print("nullable-true-branch")
    flag = False
    if ns if flag else nt:
        print("nullable-false-truthy")
    else:
        print("nullable-false-falsy")

    # ── int? (OptionalIsSome) — expected from value-position twin ──
    flag = True
    o1: int? = 42
    o2: int? = None()
    if o1 if flag else o2:
        print("optional-true-branch")
    flag = False
    if o1 if flag else o2:
        print("optional-false-truthy")
    else:
        print("optional-false-falsy")

    # ── __bool__ class (BoolConvertible) — expected from value-position twin ──
    flag = True
    tv: TruthyVal = TruthyVal()
    fv: FalsyVal = FalsyVal()
    if tv if flag else fv:
        print("bool-conv-true-branch")
    flag = False
    if tv if flag else fv:
        print("bool-conv-false-truthy")
    else:
        print("bool-conv-false-falsy")

class TruthyVal:
    def __bool__(self) -> bool:
        return True

class FalsyVal:
    def __bool__(self) -> bool:
        return False
