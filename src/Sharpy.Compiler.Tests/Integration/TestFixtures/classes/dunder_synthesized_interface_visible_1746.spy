# Verify synthesized ISized is visible to the type checker (#1746)
# Bag has __len__ but does not explicitly implement ISized;
# passing it to a function accepting ISized must work.
class Bag:
    n: int

    def __init__(self, n: int):
        self.n = n

    def __len__(self) -> int:
        return self.n

def accepts_sized(s: ISized) -> bool:
    return True

def main():
    b = Bag(42)
    print(accepts_sized(b))
