# A chaining call binds against the target's WHOLE __init__ overload set, whatever order the
# overloads are declared in (constructors.md, "Constructor Chaining"). Every chain here targets an
# overload declared BELOW the constructor that calls it; its twin,
# constructor_chaining_target_declared_first, declares the same constructors target-first and must
# print the same output. self.__init__ used to be checked against the first-declared __init__ only
# (SPY0224 "expects 0 arguments but got 2").

# The spec's example: two constructors chain to the two-parameter one declared between/below them.
class Point:
    x: float
    y: float

    def __init__(self):
        self.__init__(0.0, 0.0)

    def __init__(self, x: float, y: float):
        self.x = x
        self.y = y

    def __init__(self, xy: float):
        self.__init__(xy, xy)

# Same-arity overloads: the target is the second one-parameter overload, not the first.
class Tag:
    n: int
    label: str

    def __init__(self):
        self.__init__(7)

    def __init__(self, label: str):
        self.n = len(label)
        self.label = label

    def __init__(self, n: int):
        self.n = n
        self.label = "int"

# Keyword arguments into a later overload.
class Named:
    n: int
    name: str

    def __init__(self):
        self.__init__(name="k", n=4)

    def __init__(self, n: int, name: str):
        self.n = n
        self.name = name

# A generic class chaining to a later overload.
class Box[T]:
    v: T
    n: int

    def __init__(self, v: T):
        self.__init__(v, 1)

    def __init__(self, v: T, n: int):
        self.v = v
        self.n = n

# super().__init__ into a later base overload.
class Base:
    size: int

    def __init__(self):
        self.size = 0

    def __init__(self, size: int):
        self.size = size

class Derived(Base):
    def __init__(self):
        super().__init__(5)

def main() -> None:
    p = Point()
    print(p.x, p.y)
    q = Point(2.5)
    print(q.x, q.y)
    t = Tag()
    print(t.n, t.label)
    m = Named()
    print(m.n, m.name)
    b = Box[str]("q")
    print(b.v, b.n)
    print(Derived().size)
