# A construction that no __init__ overload accepts by count is refused at the call. It used to
# reach Roslyn as CS1729 behind SPY0908: the overloaded route compared neither count nor types.

class P:
    x: int

    def __init__(self):
        self.x = 0

    def __init__(self, n: int):
        self.x = n


def main() -> None:
    print(P(1, 2, 3).x)
