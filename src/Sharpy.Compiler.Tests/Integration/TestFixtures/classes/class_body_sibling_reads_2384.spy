# P21h D8 (#2384, R-JJ): a bare class-body read outside a method resolves exactly the siblings C#
# resolves in its position. Every initializer position — a plain class's field initializer, a
# property default in any host, a @static initializer, a const initializer (static readonly) — reads
# a const, a @static field, a @static property and a @static method; a parameter default and a
# struct/dataclass instance field initializer (the synthesized constructor's parameter default) read
# a const. Each line prints the four siblings' values: 1 2 4 6 — except that the @static FIELD and
# const initializer lines read only the const and the @static field (1 2), and the @static PROPERTY
# default lines do not call the method (1 2 4): written while #2396 refused those reads. Since P75
# (source-order emission, R-JT) they run; static_prop_in_static_init_2396 and
# StaticInitializerOrderMatrixTests pin them.
# The refusals are pinned by bare_member_name_in_method_2360.error and ClassBodyReadPositionMatrixTests.


class Plain:
    const K: int = 1
    @static
    s: int = 2
    @static
    property sp: int = 4
    @static
    def sm() -> int:
        return 6

    f1: int = K
    f2: int = s
    f3: int = sp
    f4: int = sm()
    @static
    g1: int = K
    @static
    g2: int = s
    property p1: int = K
    property p2: int = s
    property p3: int = sp
    property p4: int = sm()
    @static
    property q1: int = K
    @static
    property q2: int = s
    @static
    property q3: int = sp
    const C1: int = K
    const C2: int = s

    def m(self, x: int = K) -> int:
        return x


struct Pair:
    const K: int = 1
    @static
    s: int = 2
    @static
    property sp: int = 4
    @static
    def sm() -> int:
        return 6

    fk: int = K
    @static
    g1: int = K
    @static
    g2: int = s
    property p1: int = K
    property p2: int = s
    property p3: int = sp
    property p4: int = sm()
    @static
    property q1: int = K
    @static
    property q2: int = s
    @static
    property q3: int = sp
    const C1: int = K
    const C2: int = s


@dataclass
class Rec:
    const K: int = 1
    @static
    s: int = 2
    @static
    property sp: int = 4
    @static
    def sm() -> int:
        return 6

    fk: int = K
    @static
    g1: int = K
    @static
    g2: int = s
    property p1: int = K
    property p2: int = s
    property p3: int = sp
    property p4: int = sm()
    @static
    property q1: int = K
    @static
    property q2: int = s
    @static
    property q3: int = sp
    const C1: int = K
    const C2: int = s


def main() -> None:
    a = Plain()
    print(a.f1, a.f2, a.f3, a.f4)
    print(Plain.g1, Plain.g2)
    print(a.p1, a.p2, a.p3, a.p4)
    print(Plain.q1, Plain.q2, Plain.q3)
    print(Plain.C1, Plain.C2)
    print(a.m())

    b = Pair()
    print(b.fk)
    print(Pair.g1, Pair.g2)
    print(b.p1, b.p2, b.p3, b.p4)
    print(Pair.q1, Pair.q2, Pair.q3)
    print(Pair.C1, Pair.C2)

    c = Rec()
    print(c.fk)
    print(Rec.g1, Rec.g2)
    print(c.p1, c.p2, c.p3, c.p4)
    print(Rec.q1, Rec.q2, Rec.q3)
    print(Rec.C1, Rec.C2)
