# #2396 (P21h D8 refused these until the layout followed the source; P75, R-JT): a @static field's or a
# const's initializer reading an EARLIER @static PROPERTY reads its value, bare or qualified — the
# emitter lays the members out in source order, so C# runs `sp`'s initializer first (4 4) — and a call
# of an earlier @static method runs it (`get()` reads the earlier `Calls.sp`: 4). The method's body
# reads the statics initialized so far: `later()` returns `Calls.b`, declared after `K`, so `K` is 0
# (C#'s rule, c8 — the spec names it). The positive control is class_body_sibling_reads_2384.

class Host:
    @static
    property sp: int = 4

    @static
    g: int = sp
    const C: int = sp


class Calls:
    @static
    property sp: int = 4

    @static
    def get() -> int:
        return Calls.sp

    @static
    def later() -> int:
        return Calls.b

    @static
    a: int = get()
    const K: int = later()
    @static
    b: int = 2


def main() -> None:
    print(Host.g, Host.C, Calls.a, Calls.K)
