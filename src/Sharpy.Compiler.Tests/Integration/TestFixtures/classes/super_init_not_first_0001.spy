# A statement ahead of super().__init__() would run after it (the call is hoisted to `: base(...)`), so it is refused: SPY0292 (#2507). CPython runs it in source order (docs/deviations.yaml, constructor-chaining-call-first).
class Base:
    value: int

    def __init__(self, value: int):
        self.value = value

class Child(Base):
    extra: int

    def __init__(self, value: int, extra: int):
        self.extra = extra
        super().__init__(value)

def main():
    c: Child = Child(10, 20)
    print(c.value)
    print(c.extra)
