# Reified `case set[int](s)` binding with Pythonic operations on the set surface (#877; migrated #1708).
# Tests add, len(), and containment check.

def process(x: object):
    match x:
        case set[int](s):
            s.add(99)
            print(len(s))
            print(99 in s)
        case _:
            print("not a set")

def main():
    process({1, 2, 3})
