# Reified `case list[int](l)` binding with Pythonic operations on the list surface (#876; migrated #1708).
# Tests append, len(), indexing (positive and negative), and iteration.

def process(x: object):
    match x:
        case list[int](l):
            l.append(99)
            print(len(l))
            print(l[0])
            print(l[-1])
            for item in l:
                print(item)
        case _:
            print("not a list")

def main():
    process([1, 2, 3])
