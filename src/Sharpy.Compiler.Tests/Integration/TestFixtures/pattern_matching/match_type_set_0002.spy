# Dispatch correctness: reified set[int]()/list[int]()/dict[str, int]()/str() patterns resolve to
# distinct runtime types, not overlapping .NET base types (#877; migrated under reification, #1708).

def classify(x: object) -> str:
    match x:
        case set[int]():
            return "set"
        case list[int]():
            return "list"
        case dict[str, int]():
            return "dict"
        case str():
            return "str"
        case _:
            return "other"

def main():
    print(classify({1, 2}))
    print(classify([1, 2]))
    print(classify({"a": 1}))
    print(classify("hello"))
    print(classify(42))
