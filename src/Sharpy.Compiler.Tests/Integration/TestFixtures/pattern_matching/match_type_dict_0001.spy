# Match an `object` parameter against a reified `case dict[str, int](d)` collection pattern
# (#869; migrated to the closed spelling under reification, #1708). The scrutinee is built as
# dict[str, int], so that is the spelling that matches. Verifies dispatch + len().

def process(value: object) -> None:
    match value:
        case dict[str, int](d):
            print("dict with " + str(len(d)) + " entries")
        case _:
            print("not a dict")

def main():
    process({"a": 1, "b": 2})
    process(42)
