# Reified `case dict[str, int](d)` — indexing + key iteration (#869; migrated under #1708).
# d[k] indexing must resolve on the reified dict surface.
# `for k in d:` must iterate keys (not DictionaryEntry objects).

def process(value: object) -> None:
    match value:
        case dict[str, int](d):
            print(d["x"])
            for k in d:
                print(k)
        case _:
            print("not a dict")

def main():
    process({"x": 10, "y": 20, "z": 30})
