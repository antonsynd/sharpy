# #1712 precedence-inversion class: as? coercion in truthiness positions.
# The emitter builds cond ? Some(x) : default — unparenthesized, .IsSome re-associates.
# Expected from value-position twins (r = o as? T; if r:) executed at HEAD; every consumption is
# unparenthesized so the coercion conditional itself is the receiver.
# Numeric controls (as? int8, as? int64, 5 as? long) compile clean — they stay clean.
def main() -> None:
    o: object = long(42)

    # assert — the coercion itself is the assert operand (the plan's measured CS8716 cell)
    assert o as? long, "as-long assert"
    print("assert-pass")

    # if
    if o as? long:
        print("if-as-long")

    # while (mutates o so while runs once)
    count: int = 0
    while o as? long:
        print("while-as-long")
        o = "not a long"
        count = count + 1
    print("while-count:" + str(count))

    # ternary test
    o = long(42)
    result: str = "some" if o as? long else "none"
    print("ternary:" + result)

    # and-operand — unparenthesized (source parentheses would make the cell pass by construction)
    flag: bool = True
    o = long(42)
    if o as? long and flag:
        print("and-as-long")
    o = "not a long"
    if o as? long and flag:
        print("and-as-long-falsy-unexpected")
    else:
        print("and-as-long-falsy")

    # ── Numeric controls (must compile clean, no SPY0908) ──
    n: int = 300
    # narrowing: int → int8 (out of range → None)
    if n as? int8:
        print("narrow-some")
    else:
        print("narrow-none")

    # widening: int → int64 (always succeeds)
    if n as? int64:
        print("widen-some")

    # statically convertible
    if 5 as? long:
        print("static-some")
