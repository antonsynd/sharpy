# Test float32 literal with f suffix - type inference only.
# The annotated forms live in float32_literal_annotation.spy: `x: float32 = 3.14f` works (#280 fixed)
# and the unsuffixed `x: float32 = 0.1` narrows (#1301).
def main():
    x = 3.14f
    print(x)
    y = 2.0f
    print(y)
    z = 0.5f
    print(z)
