# An escaped type name has to survive the BASE-LIST position too, not just annotations.
# The two travel different routes: an annotation resolves through the SYMBOL (which carries the
# escape flag), while a base list resolves through the type NAME — and a TypeAnnotation has no
# escape flag of its own, so the name route defaulted to false and PascalCased. The declaration
# emitted `zed` and the base list emitted `Zed`, CS0246 (#1241).
#
# A NEUTRAL name is what pins this: the defect has nothing to do with builtins or C# keywords, so
# covering it only through keyword names would make the coverage incidental to a different rule.
# The keyword row below was restored once 178f7983b made the unparser emit backticks in every
# type-reference position (#1274) — the round-trip suite now pins base-list escapes for keyword
# names too.
class `zed`:
    def go(self) -> int:
        return 1


class DerivedZed(`zed`):
    pass


# The keyword row: an escaped C# keyword as a base-list reference (#1274).
class `pass`:
    def go2(self) -> int:
        return 2


class DerivedPass(`pass`):
    pass


def main():
    a: `zed` = DerivedZed()
    print(a.go())

    b = `zed`()
    print(b.go())

    c: `pass` = DerivedPass()
    print(c.go2())
