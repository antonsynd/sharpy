# Decimal `%` deliberately keeps NATIVE truncating semantics: sign of the
# DIVIDEND. The floored-`%` lowering (#1153) is scoped to int/long/float operands
# only; decimal lowers to guarded decimal.Remainder(a, b) — value-identical to
# CLR op_Modulus for every nonzero divisor (#1189) — see
# docs/language_specification/arithmetic_operators.md. The values below
# intentionally differ from the int results.
def main() -> None:
    x: decimal = -7m
    y: decimal = 3m
    print(x % y)        # -1  (native; int -7 % 3 is 2)
    print(7m % -3m)     # 1   (native; int 7 % -3 is -2)
    print(-7m % -3m)    # -1
    print(7m % 3m)      # 1
    print(-17m % 5m)    # -2  (native; int -17 % 5 is 3)
    # Decimal `//` is native too — truncated toward zero, so -7m // 3m is -2 where
    # int -7 // 3 is -3 (#1174; full sign matrix in floordiv_decimal_native.spy).
    print(x // y)       # -2
    print(-7 % 3)       # 2   (int contrast: floored, sign of divisor)
