# #1308: isinstance fills through the inheritance chain.
#
# `Pair[int]` derives from `Box[list[int]]`, so `isinstance(p, Box)` fills `Box[list[int]]`. The
# narrowed value's payload is READ as a `list[int]`: reaching the branch only proves the test
# matched, which a positional copy filling `Box[int]` would also do. `len(p.value)` is what
# distinguishes them — an `int` payload does not compile there.

class Box[T]:
    value: T

    def __init__(self, value: T) -> None:
        self.value = value


class Pair[T](Box[list[T]]):
    def __init__(self, value: list[T]) -> None:
        super().__init__(value)


def main() -> None:
    p: Pair[int] = Pair[int]([1, 2])
    if isinstance(p, Box):
        payload: list[int] = p.value
        print(len(payload))
    else:
        print("no match")
