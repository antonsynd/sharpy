# Positive control for the two invariance fixtures beside it: DECLARED variance is still honoured, so
# an `IEnumerable[Dog]` reaches an `IEnumerable[Animal]` formal (a reference conversion), and a
# `list[int]` still infers `T` through an `IEnumerable[T]` formal (#827's actual subject, which is a
# base-interface relation rather than element covariance).
class Animal:
    def __init__(self):
        pass


class Dog(Animal):
    def __init__(self):
        super().__init__()


def describe(xs: IEnumerable[Animal]) -> str:
    return "animals"


def count_items[T](items: IEnumerable[T]) -> int:
    n: int = 0
    for i in items:
        n += 1
    return n


def main():
    ds: IEnumerable[Dog] = [Dog(), Dog()]
    print(describe(ds))

    xs: list[int] = [1, 2, 3]
    print(count_items(xs))

    animals: list[Animal] = [Dog()]
    print(len(animals))
