# #1287 negative: Box[int] = Pair[int](...) must be refused with SPY0220,
# not accepted-then-SPY0908 (the leak cell).

class Box[T]:
    value: T

    def __init__(self, value: T) -> None:
        self.value = value

class Pair[T](Box[list[T]]):
    def __init__(self, items: list[T]) -> None:
        super().__init__(items)

def main() -> None:
    p: Pair[int] = Pair[int]([1, 2])
    wrong: Box[int] = p
