# sorted[T](generator) inside a generic def — same open-formal path as iter (#1518).
def _gen[T](xs: list[T]) -> T:
    for x in xs:
        yield x


def wrap[T](xs: list[T]) -> list[T]:
    return sorted[T](_gen[T](xs))


def main() -> None:
    result: list[int] = wrap[int]([3, 1, 2])
    print(result)
