# #1142: explicit type arguments on a USER-module generic function now resolve — the module-level
# export carries its type parameters (ModuleLoader), so `mathlib.identity[int]` is recognized as a
# generic reference and `[...]` is type arguments, matching the .NET-module arm (json.loads[int]).
# The uncalled form (f = mathlib.identity[int]) is covered separately by
# usermod_generic_func_uncalled_reference_1142 (deliberate SPY0335).
import mathlib

def main() -> None:
    print(mathlib.identity[int](5))
    print(mathlib.pair[int, str](1, "a"))
