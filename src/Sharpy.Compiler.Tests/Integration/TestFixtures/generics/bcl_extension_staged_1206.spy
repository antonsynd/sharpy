# #1206: an extension call with NO type arguments written. Before staged inference nothing resolved
# these at all — the call's type was Unknown and the emitter wrote it blind — so every line below is
# new capability, not protected behavior. The explicit `select[str](f)` spelling (#1195) is pinned by
# bcl_extension_closed_signature_1195; this is its no-type-args twin, and both record the same fact,
# differing only in the node it is keyed on.
from system.collections.generic import List


def main():
    lst: List[int] = List[int]()
    lst.add(3)
    lst.add(4)
    lst.add(5)

    # One stage: TSource comes from the receiver, TResult from the lambda's return.
    print(list(lst.select(lambda x: str(x))))

    # A predicate closes from the receiver alone — no open parameter to recover.
    print(list(lst.where(lambda x: x > 3)))

    # CHAINED. The first call's recorded type (a Sharpy list) becomes the second's receiver, so the
    # staging has to run twice over its own output. `where` is not a Sharpy list method and is absent
    # from Sharpy.List<T>'s CLR surface, so gate 4 passes and the second call stages too.
    print(list(lst.select(lambda x: x * 2).where(lambda y: y > 6)))

    # THREE STAGES. TCollection is recovered structurally from `list[TCollection]` against the first
    # lambda's `list[int]` return, and only then does the second lambda become checkable, yielding
    # TResult. The measured partition found exactly six such shapes on the whole Enumerable surface —
    # SelectMany (2 overloads), GroupBy (3) and AggregateBy (1) — and nothing needing four.
    print(list(lst.select_many(lambda x: [x, x], lambda a, b: str(a + b))))

    # TWO BOUNDARIES A READER MEETS RIGHT HERE, both measured against the pre-batch compiler and
    # both unchanged by it — neither is a #1206 regression, and neither is fixed by #1206 either.
    #
    # 1. #1252. The select_many above works because its first lambda returns a SHARPY list. Return a
    #    raw `system.collections.generic.List[int]` from it instead and the call does not close:
    #    `IEnumerable<T>` maps to Sharpy `list`, so the formal is `Func[int, list[TCollection]]`, and
    #    unification will not match `list[TCollection]` against `List[int]` — different generic name.
    #    Staging then declines, the call stays permissive, and the wrapping `list(...)` leaks CS0305
    #    exactly as it did before the batch. Widening unification to bridge CLR sequence types is
    #    deliberately out of scope: it is the single unifier every generic call depends on.
    #
    # 2. #1251. Printing a staged sequence without wrapping it — `print(lst.select(f))` — shows the
    #    .NET iterator's ToString, not a Python repr, because the emitted expression is still an
    #    `IEnumerable<T>` even though the checker now types it `list[str]`. Pre-batch the checker had
    #    no opinion at all, so nothing changed; what DID change is the diagnosis, since the type is
    #    now known and only the emitter's materialization is missing. That is why every line above
    #    wraps in list().
