# #1136: a generic instance method of a raw BCL type (List[T].ConvertAll<TOutput>) is absent from the
# discovered TypeSymbol, so lst.convert_all[str](...) used to fall through to value-indexing and silently
# mis-emit lst.ConvertAll[...] (CS0021 -> SPY0908). The CLR-reflection fallback in
# TryResolveGenericInstanceMethod now resolves it and convert() below emits lst.ConvertAll<string>(...),
# which compiles, links, and runs here (the lambda -> Converter<int,string> conversion binds).
#
# The receiver is a *parameter*, not a `List[int]()` literal: constructing a raw BCL List still emits an
# ambiguous `new List<int>()` (CS0104 vs Sharpy.List) — a separate pre-existing codegen gap tracked in
# #1139 — so main() cannot call convert() yet. The ConvertAll<string> emission is additionally pinned by
# BclGenericInstanceMethodCodeGenTests.
from system.collections.generic import List

def convert(lst: List[int]) -> int:
    strs = lst.convert_all[str](lambda x: str(x))
    return len(strs)

def main() -> None:
    print("bcl-generic-instance-method-ok")
