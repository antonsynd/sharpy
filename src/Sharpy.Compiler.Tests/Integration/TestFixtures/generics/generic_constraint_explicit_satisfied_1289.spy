# The false-positive twin of the explicit-type-argument constraint check (#1289): every written
# vector that DOES satisfy its constraint keeps compiling. Self, subclass and interface are the three
# ways to satisfy one, and all three fall out of the same symbol comparison.


interface Drawable:
    def draw(self) -> int


class Shape:
    sides: int

    def __init__(self, sides: int) -> None:
        self.sides = sides


class Circle(Shape):
    def __init__(self) -> None:
        super().__init__(0)


class Sprite(Drawable):
    def draw(self) -> int:
        return 9


def describe[T: Shape](shape: T) -> int:
    return shape.sides


def render[T: Drawable](item: T) -> int:
    return item.draw()


def main() -> None:
    # Self: the written argument IS the constraint.
    print(describe[Shape](Shape(4)))
    # Subclass.
    print(describe[Circle](Circle()))
    # Interface implementation.
    print(render[Sprite](Sprite()))
