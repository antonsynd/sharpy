# Augmented assignment on a collection mutates the receiver in place, so every alias observes the
# change (CPython `__iadd__`-family semantics; inplace_augassign graduated, #1614). Every value is
# printed through the ALIAS — the cell that discriminates in-place mutation from a rebind — and the
# `.expected` is python3-derived (python3 3.12, 2026-08-29). The empty `.warning` is the positive
# control that no transition hint (the retired SPY0478) fires.

def main() -> None:
    # list +=
    xs: list[int] = [1, 2]
    t_xs: list[int] = xs
    xs += [3]
    print(t_xs)

    # list *=
    ys: list[int] = [1, 2]
    t_ys: list[int] = ys
    ys *= 2
    print(t_ys)

    # set |=
    s1: set[int] = {1, 2}
    t_s1: set[int] = s1
    s1 |= {3}
    print(sorted(t_s1))

    # set -=
    s2: set[int] = {1, 2, 3}
    t_s2: set[int] = s2
    s2 -= {2}
    print(sorted(t_s2))

    # set &=
    s3: set[int] = {1, 2, 3}
    t_s3: set[int] = s3
    s3 &= {2, 3, 4}
    print(sorted(t_s3))

    # set ^=
    s4: set[int] = {1, 2, 3}
    t_s4: set[int] = s4
    s4 ^= {2, 4}
    print(sorted(t_s4))

    # dict |=
    d: dict[str, int] = {"a": 1}
    t_d: dict[str, int] = d
    d |= {"b": 2}
    print(sorted(t_d.keys()))
