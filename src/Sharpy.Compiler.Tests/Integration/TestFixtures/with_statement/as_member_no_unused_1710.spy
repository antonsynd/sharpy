# A `with … as p.x` target READS p, so p is used and SPY0451 must not fire (#1710, cell b4_18).
# The with target is p's ONLY appearance on purpose: a `print(p.x)` in the body would read p by
# itself and the empty `.warning` would then hold no matter what the WithStatement arm of
# UnusedVariableValidator does. The empty `.warning` is an absence assertion; its positive control
# is the twin as_member_unused_control_1710.spy, identical but for one extra local that IS unused
# and DOES warn.
class Holder:
    x: int

    def __init__(self):
        self.x = 0

class CM:
    def __enter__(self) -> int:
        return 7

    def __exit__(self) -> None:
        pass

def main() -> None:
    p: Holder = Holder()
    with CM() as p.x:
        print("body")
