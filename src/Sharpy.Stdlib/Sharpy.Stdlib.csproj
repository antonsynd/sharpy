<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion Condition="'$(TargetFramework)' == 'netstandard2.1'">9.0</LangVersion>
    <LangVersion Condition="'$(TargetFramework)' == 'net10.0'">14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Sharpy</RootNamespace>
    <AssemblyName>Sharpy.Stdlib</AssemblyName>
    <!-- SharpyLang.* NuGet family (Sharpy.* is owned by an unrelated package family); assembly name unchanged -->
    <PackageId>SharpyLang.Stdlib</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Standard library for the Sharpy programming language. Provides json, os, re, math, and 60+ modules with Pythonic APIs on .NET.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Ships code ported from CPython (THIRD-PARTY-NOTICES.txt), so the PSF licence joins the expression -->
    <PackageLicenseExpression>(Apache-2.0 OR MIT) AND PSF-2.0</PackageLicenseExpression>
    <!-- CS1574/CS1580: XML doc cref resolution issues for generic/dunder methods -->
    <!-- CS1591: missing XML docs — suppressed for simple data types -->
    <NoWarn>CS1574;CS1580;CS1591</NoWarn>
    <!-- CA1305/CA1307: globalization overloads — Python string ops are ordinal by design. -->
    <NoWarn Condition="'$(TargetFramework)' == 'net10.0'">$(NoWarn);CA1305;CA1307</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../nuget/SharpyLang.Stdlib.README.md" Pack="true" PackagePath="\README.md" />
    <!-- Licence notices for third-party code compiled into this assembly (CPython, Datetime/DatetimeIso.cs):
         at the nupkg root, and at the root of every publish output that carries this assembly (the
         release zips; it flows to sharpyc's publish through the project references). Not in build output. -->
    <None Include="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Sharpy.Core/Sharpy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Tomlyn" Version="2.11.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sharpy.Stdlib.Tests" />
    <InternalsVisibleTo Include="Sharpy.Stdlib.Spy" />
  </ItemGroup>

  <!-- Exclude .spy source directory from C# compilation (contains .spy files
       and may contain stale generated .cs from staleness checks) -->
  <ItemGroup>
    <Compile Remove="spy/**" />
  </ItemGroup>

  <!-- Exclude per-module project directories from monolith compilation -->
  <ItemGroup>
    <Compile Remove="modules/**" />
  </ItemGroup>

  <!-- Tarfile uses System.Formats.Tar which requires .NET 7+ -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Remove="Tarfile/**" />
  </ItemGroup>

</Project>
