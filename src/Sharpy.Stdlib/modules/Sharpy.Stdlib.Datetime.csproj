<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Sharpy.Stdlib.Datetime</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Datetime/**/*.cs" />
    <!-- python's strftime is one formatter shared by datetime's strftime/__format__ and
         time.strftime; in the combined Sharpy.Stdlib assembly it is a sibling file. -->
    <Compile Include="../Strftime.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sharpy.Stdlib.Zoneinfo" />
    <!-- TomlConverter reaches for the internal System.DateTime/TimeSpan constructors and
         accessors when mapping TOML date/time values. -->
    <InternalsVisibleTo Include="Sharpy.Stdlib.Toml" />
    <InternalsVisibleTo Include="Sharpy.Stdlib.Tests" />
  </ItemGroup>

</Project>
