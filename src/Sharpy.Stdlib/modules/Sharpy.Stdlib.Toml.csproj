<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Sharpy.Stdlib.Toml</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- TomlConverter maps TOML date/time values onto Date/Time/DateTime/Timedelta/Timezone,
         which live in the datetime module. -->
    <ProjectReference Include="Sharpy.Stdlib.Datetime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Toml/**/*.cs" />
  </ItemGroup>

</Project>
