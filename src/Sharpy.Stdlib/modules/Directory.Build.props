<Project>
  <!-- Chain to the repo-root props. MSBuild stops at the first Directory.Build.props it finds
       walking up from a project, so without this import the packaging projects here inherit
       none of the repo-wide settings: they were versioned 1.0.0 instead of SharpyVersion, had
       an empty AssemblyVersion, and built with TreatWarningsAsErrors off (#1181). The import
       is first so anything set below still wins for these projects. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <BaseIntermediateOutputPath>obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion Condition="'$(TargetFramework)' == 'netstandard2.1'">9.0</LangVersion>
    <LangVersion Condition="'$(TargetFramework)' == 'net10.0'">14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Sharpy</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1574;CS1580;CS1591</NoWarn>
    <NoWarn Condition="'$(TargetFramework)' == 'net10.0'">$(NoWarn);CA1305;CA1307</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Sharpy.Core/Sharpy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../IsExternalInit.cs" />
  </ItemGroup>
</Project>
