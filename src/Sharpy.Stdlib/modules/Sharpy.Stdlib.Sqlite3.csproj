<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 only: Microsoft.Data.Sqlite does not support netstandard2.1 -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>Sharpy.Stdlib.Sqlite3</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- #1176: pin the provider bundle explicitly; the version Microsoft.Data.Sqlite pulls
         transitively carries a known advisory (NU1903). Keep this literal in lock-step with
         Sharpy.Cli.csproj and Sharpy.Stdlib.csproj — the three-way drift guard test enforces it. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Sqlite3/**/*.cs" />
  </ItemGroup>

</Project>
