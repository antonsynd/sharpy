"""Low-level networking interface (TCP, UDP, DNS)."""

from system import IDisposable, Array, Double
from system.net import IPAddress, IPEndPoint, EndPoint, Dns
from system.net.sockets import Socket as NetSocket, AddressFamily, SocketType, ProtocolType, SocketOptionLevel, SocketOptionName, SocketShutdown, SocketFlags, SocketException, SocketError, SelectMode

# ---- Address family constants (mirror System.Net.Sockets.AddressFamily) ----
AF_INET: int = AddressFamily.InterNetwork as! int
AF_INET6: int = AddressFamily.InterNetworkV6 as! int
AF_UNIX: int = AddressFamily.Unix as! int

# ---- Socket type constants (mirror System.Net.Sockets.SocketType) ----
SOCK_STREAM: int = SocketType.Stream as! int
SOCK_DGRAM: int = SocketType.Dgram as! int
SOCK_RAW: int = SocketType.Raw as! int

# ---- Protocol constants (mirror System.Net.Sockets.ProtocolType) ----
IPPROTO_IP: int = ProtocolType.IP as! int
IPPROTO_TCP: int = ProtocolType.Tcp as! int
IPPROTO_UDP: int = ProtocolType.Udp as! int

# ---- Socket option constants (mirror System.Net.Sockets option enums) ----
SOL_SOCKET: int = SocketOptionLevel.Socket as! int
SO_REUSEADDR: int = SocketOptionName.ReuseAddress as! int
SO_KEEPALIVE: int = SocketOptionName.KeepAlive as! int
SO_BROADCAST: int = SocketOptionName.Broadcast as! int
SO_RCVBUF: int = SocketOptionName.ReceiveBuffer as! int
SO_SNDBUF: int = SocketOptionName.SendBuffer as! int
TCP_NODELAY: int = SocketOptionName.NoDelay as! int

# ---- Shutdown constants (mirror System.Net.Sockets.SocketShutdown) ----
SHUT_RD: int = SocketShutdown.Receive as! int
SHUT_WR: int = SocketShutdown.Send as! int
SHUT_RDWR: int = SocketShutdown.Both as! int

# ---- Other constants ----
SOMAXCONN: int = 128

# Default timeout applied to newly created sockets (None means blocking mode).
_default_timeout: float | None = None

def _check_timeout(timeout: float | None) -> None:
    """Refuse a timeout value python3 refuses, at the call that receives it (#2228).

    The one rule shared by every timeout-accepting entry point (settimeout,
    setdefaulttimeout, create_connection(timeout=)), applied before any state
    changes, in python3's order: NaN -> ValueError; a value whose nanosecond
    count does not fit int64 (+-inf, |t| >= ~9.22e9 s) -> OverflowError;
    negative -> ValueError. None (blocking) and 0.0 (non-blocking) are accepted.
    """
    if timeout is None:
        return
    value: float = timeout
    if Double.is_na_n(value):
        raise ValueError("Invalid value NaN (not a number)")
    # python3 converts the seconds to int64 nanoseconds first; at this
    # magnitude every double is integral, so its rounding cannot move the bound.
    ns: float = value * 1000000000.0
    if ns >= 9223372036854775808.0 or ns < -9223372036854775808.0:
        raise OverflowError("timestamp out of range for platform time_t")
    if value < 0.0:
        raise ValueError("Timeout value out of range")

class error(Exception):
    """Base exception for socket-related errors. Corresponds to Python's socket.error."""

    errno: int

    def __init__(self, message: str, errno: int = 0):
        """Create a socket error with the specified message and optional errno."""
        super().__init__(message)
        self.errno = errno

    def __init__(self, message: str, inner: Exception, errno: int = 0):
        """Create a socket error wrapping an inner exception."""
        super().__init__(message, inner)
        self.errno = errno

    def from_socket_exception(ex: SocketException) -> error:
        """Create a socket error from a .NET SocketException."""
        return error(ex.Message, ex, (ex.socket_error_code as! int))

class timeout(error):
    """Raised when a socket operation times out. Corresponds to Python's socket.timeout."""

    def __init__(self, message: str, errno: int = 0):
        """Create a socket timeout error with the specified message."""
        super().__init__(message, errno)

    def __init__(self, message: str, inner: Exception, errno: int = 0):
        """Create a socket timeout error wrapping an inner exception."""
        super().__init__(message, inner, errno)

class gaierror(error):
    """Raised for address-related errors (e.g., DNS failures). Python's socket.gaierror."""

    def __init__(self, message: str, errno: int = 0):
        """Create a GAI error with the specified message."""
        super().__init__(message, errno)

    def __init__(self, message: str, inner: Exception, errno: int = 0):
        """Create a GAI error wrapping an inner exception."""
        super().__init__(message, inner, errno)

class herror(error):
    """Raised for legacy address-related errors. Corresponds to Python's socket.herror."""

    def __init__(self, message: str, errno: int = 0):
        """Create an herror with the specified message."""
        super().__init__(message, errno)

    def __init__(self, message: str, inner: Exception, errno: int = 0):
        """Create an herror wrapping an inner exception."""
        super().__init__(message, inner, errno)

@final
class socket(IDisposable):
    """Wraps System.Net.Sockets.Socket to provide a Python-like socket API.

    Supports TCP and UDP communication, socket options, and timeout handling.
    """

    @private
    _socket: NetSocket
    @private
    _timeout: float | None

    def __init__(self, family: int = 2, sock_type: int = 1, proto: int = 0):
        """Create a new socket with the given address family, type, and protocol."""
        self._socket = NetSocket(family as! AddressFamily, sock_type as! SocketType, proto as! ProtocolType)
        self._timeout = None
        default: float | None = _default_timeout
        if default is not None:
            self.settimeout(default)

    def __init__(self, existing: NetSocket):
        """Wrap an existing .NET socket (used for accepted connections)."""
        self._socket = existing
        self._timeout = None

    # ---- Properties ----

    property get family(self) -> int:
        """The address family of the socket."""
        return self._socket.address_family as! int

    property get `type`(self) -> int:
        """The socket type."""
        return self._socket.socket_type as! int

    property get proto(self) -> int:
        """The protocol type."""
        return self._socket.protocol_type as! int

    # ---- Connection methods ----

    def connect(self, address: tuple[host: str, port: int]) -> None:
        """Connect to a remote (host, port) address."""
        try:
            ip_addresses = Dns.get_host_addresses(address[0])
            if len(ip_addresses) == 0:
                raise gaierror("Name or service not known", (SocketError.HostNotFound as! int))
            endpoint: IPEndPoint = IPEndPoint(ip_addresses[0], address[1])
            ms: int = self._timeout_ms()
            if ms > 0:
                # .NET's synchronous Connect ignores Send/ReceiveTimeout, so a timed
                # connect waits on an asynchronous one for at most the timeout (#2177).
                pending = self._socket.begin_connect(endpoint, None, None)
                if not pending.async_wait_handle.wait_one(ms):
                    raise timeout("timed out")
                self._socket.end_connect(pending)
            else:
                self._socket.connect(endpoint)
        except SocketException as ex when ex.socket_error_code == SocketError.TimedOut:
            raise timeout("timed out", ex, (ex.socket_error_code as! int))
        except SocketException as ex:
            raise error.from_socket_exception(ex)

    def bind(self, address: tuple[host: str, port: int]) -> None:
        """Bind the socket to a local (host, port) address."""
        try:
            ip_addr: IPAddress = IPAddress.Any
            host: str = address[0]
            if host == "" or host == "0.0.0.0":
                ip_addr = IPAddress.Any
            elif host == "::":
                ip_addr = IPAddress.IPv6Any
            else:
                ip_addr = IPAddress.parse(host)
            endpoint: IPEndPoint = IPEndPoint(ip_addr, address[1])
            self._socket.bind(endpoint)
        except SocketException as ex:
            raise error.from_socket_exception(ex)

    def listen(self, backlog: int = 5) -> None:
        """Enable a server to accept connections with the given backlog."""
        try:
            self._socket.listen(backlog)
        except SocketException as ex:
            raise error.from_socket_exception(ex)

    def accept(self) -> tuple[conn: socket, addr: tuple[host: str, port: int]]:
        """Accept a connection, returning (new socket, (remote_host, remote_port))."""
        try:
            ms: int = self._timeout_ms()
            if ms > 0 and not self._wait_readable(ms):
                raise timeout("timed out")
            accepted = self._socket.accept()
            remote = accepted.remote_end_point
            if remote is None:
                raise error("Accepted connection has no remote endpoint.")
            remote_ep: IPEndPoint = remote as! IPEndPoint
            conn: socket = socket(accepted)
            return (conn, (remote_ep.address.to_string(), remote_ep.port))
        except SocketException as ex when ex.socket_error_code == SocketError.TimedOut:
            raise timeout("timed out", ex, (ex.socket_error_code as! int))
        except SocketException as ex:
            raise error.from_socket_exception(ex)

    # ---- Data transfer methods ----

    def send(self, data: bytes) -> int:
        """Send data to the socket, returning the number of bytes sent."""
        try:
            return self._socket.send(data.to_array())
        except SocketException as ex when ex.socket_error_code == SocketError.TimedOut:
            raise timeout("timed out", ex, (ex.socket_error_code as! int))
        except SocketException as ex:
            raise error.from_socket_exception(ex)

    def sendall(self, data: bytes) -> None:
        """Send all data to the socket, continuing until every byte is sent."""
        try:
            buffer = data.to_array()
            total: int = len(data)
            total_sent: int = 0
            while total_sent < total:
                sent: int = self._socket.send(buffer, total_sent, total - total_sent, SocketFlags.None)
                if sent == 0:
                    raise error("Connection reset by peer", (SocketError.ConnectionReset as! int))
                total_sent = total_sent + sent
        except SocketException as ex when ex.socket_error_code == SocketError.TimedOut:
            raise timeout("timed out", ex, (ex.socket_error_code as! int))
        except SocketException as ex:
            raise error.from_socket_exception(ex)

    def recv(self, bufsize: int) -> bytes:
        """Receive up to bufsize bytes from the socket."""
        try:
            buffer = array[byte](bufsize)
            received: int = self._socket.receive(buffer)
            result = array[byte](received)
            Array.copy(buffer, result, received)
            return bytes(result)
        except SocketException as ex when ex.socket_error_code == SocketError.TimedOut:
            raise timeout("timed out", ex, (ex.socket_error_code as! int))
        except SocketException as ex:
            raise error.from_socket_exception(ex)

    def sendto(self, data: bytes, address: tuple[host: str, port: int]) -> int:
        """Send data to a specific (host, port) address (UDP)."""
        try:
            ip_addr: IPAddress = IPAddress.parse(address[0])
            endpoint: IPEndPoint = IPEndPoint(ip_addr, address[1])
            return self._socket.send_to(data.to_array(), endpoint)
        except SocketException as ex when ex.socket_error_code == SocketError.TimedOut:
            raise timeout("timed out", ex, (ex.socket_error_code as! int))
        except SocketException as ex:
            raise error.from_socket_exception(ex)

    def recvfrom(self, bufsize: int) -> tuple[data: bytes, addr: tuple[host: str, port: int]]:
        """Receive data and the sender's address (UDP)."""
        try:
            buffer = array[byte](bufsize)
            remote: EndPoint = IPEndPoint(IPAddress.Any, 0)
            received: int = self._socket.receive_from(buffer, ref remote)
            result = array[byte](received)
            Array.copy(buffer, result, received)
            ep: IPEndPoint = remote as! IPEndPoint
            return (bytes(result), (ep.address.to_string(), ep.port))
        except SocketException as ex when ex.socket_error_code == SocketError.TimedOut:
            raise timeout("timed out", ex, (ex.socket_error_code as! int))
        except SocketException as ex:
            raise error.from_socket_exception(ex)

    # ---- Socket options ----

    def setsockopt(self, level: int, optname: int, value: int) -> None:
        """Set a socket option (e.g., SOL_SOCKET, SO_REUSEADDR)."""
        try:
            self._socket.set_socket_option(level as! SocketOptionLevel, optname as! SocketOptionName, value)
        except SocketException as ex:
            raise error.from_socket_exception(ex)

    def getsockopt(self, level: int, optname: int) -> int:
        """Get a socket option value."""
        try:
            opt = self._socket.get_socket_option(level as! SocketOptionLevel, optname as! SocketOptionName)
            if opt is None:
                return 0
            return opt as! int
        except SocketException as ex:
            raise error.from_socket_exception(ex)

    # ---- Lifecycle methods ----

    def settimeout(self, timeout: float | None) -> None:
        """Set the timeout in seconds for blocking operations, or None for blocking mode."""
        _check_timeout(timeout)
        self._timeout = timeout
        if timeout is None:
            self._socket.blocking = True
            self._socket.receive_timeout = 0
            self._socket.send_timeout = 0
        else:
            value: float = timeout
            if value == 0.0:
                self._socket.blocking = False
            else:
                self._socket.blocking = True
                # Send/ReceiveTimeout govern send/recv; connect and accept read the
                # same _timeout_ms() (a 0 ms timeout would mean "infinite" to .NET).
                ms: int = self._timeout_ms()
                self._socket.receive_timeout = ms
                self._socket.send_timeout = ms

    @private
    def _timeout_ms(self) -> int:
        """The positive timeout in whole milliseconds (at least 1), or 0 when the
        socket is blocking (None) or non-blocking (0.0)."""
        t: float | None = self._timeout
        if t is None:
            return 0
        value: float = t
        if value <= 0.0:
            return 0
        # Send/ReceiveTimeout, WaitOne and Poll take whole milliseconds as an
        # int, so an accepted timeout longer than that (~24.8 days, up to the
        # ~9.22e9 s _check_timeout allows) waits the longest .NET can wait
        # rather than overflowing the conversion.
        max_ms: int = 2147483647
        ms_float: float = value * 1000.0
        if ms_float >= (max_ms as! float):
            return max_ms
        ms: int = ms_float as! int
        if ms < 1:
            return 1
        return ms

    @private
    def _wait_readable(self, ms: int) -> bool:
        """Wait up to ms milliseconds for the socket to become readable (for a
        listening socket: a connection is pending); False when the wait times out."""
        remaining: int = ms
        while remaining > 0:
            # Poll takes microseconds as an int, so wait at most 1000 s per call.
            chunk: int = remaining
            if chunk > 1000000:
                chunk = 1000000
            if self._socket.poll(chunk * 1000, SelectMode.SelectRead):
                return True
            remaining = remaining - chunk
        return False

    def gettimeout(self) -> float | None:
        """Return the timeout in seconds, or None if in blocking mode."""
        return self._timeout

    def setblocking(self, flag: bool) -> None:
        """Set blocking (True) or non-blocking (False) mode."""
        if flag:
            self.settimeout(None)
        else:
            self.settimeout(0.0)

    def getblocking(self) -> bool:
        """Return whether the socket is in blocking mode."""
        return self._socket.blocking

    def shutdown(self, how: int) -> None:
        """Shut down one or both halves of the connection (SHUT_RD/WR/RDWR)."""
        try:
            self._socket.shutdown(how as! SocketShutdown)
        except SocketException as ex:
            raise error.from_socket_exception(ex)

    def close(self) -> None:
        """Close the socket."""
        self._socket.close()

    def getsockname(self) -> tuple[host: str, port: int]:
        """Return the local (host, port) address the socket is bound to."""
        endpoint = self._socket.local_end_point
        if endpoint is None:
            raise error("Socket is not bound to an address.")
        ep: IPEndPoint = endpoint as! IPEndPoint
        return (ep.address.to_string(), ep.port)

    def getpeername(self) -> tuple[host: str, port: int]:
        """Return the remote (host, port) address the socket is connected to."""
        endpoint = self._socket.remote_end_point
        if endpoint is None:
            raise error("Socket is not connected.")
        ep: IPEndPoint = endpoint as! IPEndPoint
        return (ep.address.to_string(), ep.port)

    def fileno(self) -> int:
        """Return the socket handle (file descriptor) as an integer."""
        return self._socket.handle.to_int64() as! int

    def dispose(self) -> None:
        """Dispose the underlying socket resources."""
        self._socket.dispose()

    def __enter__(self) -> socket:
        return self

    def __exit__(self):
        self.dispose()

    def __str__(self) -> str:
        fd: int = self.fileno()
        fam: int = self.family
        typ: int = self.`type`
        pr: int = self.proto
        return f"<socket fd={fd}, family={fam}, type={typ}, proto={pr}>"

# ---- Default timeout ----

def getdefaulttimeout() -> float | None:
    """Return the default timeout in seconds for new sockets, or None."""
    return _default_timeout

def setdefaulttimeout(timeout: float | None) -> None:
    """Set the default timeout for new sockets. None means blocking mode."""
    _check_timeout(timeout)
    _default_timeout = timeout

# ---- Connection helper ----

# python3's `timeout` default is a private sentinel (_GLOBAL_DEFAULT_TIMEOUT), so an
# omitted timeout and an explicit None differ: omitted takes getdefaulttimeout(),
# None means blocking. One `= None` default cannot tell them apart, so the omitted
# call is its own overload (#2236, R-EV).

def create_connection(address: tuple[host: str, port: int]) -> socket:
    """Connect to a TCP (host, port) address and return the connected socket.

    The socket takes the global default timeout (getdefaulttimeout()).
    """
    return create_connection(address, _default_timeout)

def create_connection(address: tuple[host: str, port: int], timeout: float | None) -> socket:
    """Connect to a TCP (host, port) address with the given timeout and return the connected socket.

    None means blocking mode, regardless of the global default timeout.
    """
    # A refused timeout raises before any socket is created (the same rule
    # settimeout applies).
    _check_timeout(timeout)
    sock: socket = socket(AF_INET, SOCK_STREAM, 0)
    try:
        sock.settimeout(timeout)
        sock.connect(address)
        return sock
    except Exception:
        sock.close()
        raise

# ---- DNS functions ----

def gethostname() -> str:
    """Return the hostname of the current machine."""
    return Dns.get_host_name()

def gethostbyname(hostname: str) -> str:
    """Resolve a hostname to an IPv4 address string."""
    try:
        addresses = Dns.get_host_addresses(hostname)
        i: int = 0
        while i < len(addresses):
            if (addresses[i].address_family as! int) == AF_INET:
                return addresses[i].to_string()
            i = i + 1
        if len(addresses) > 0:
            return addresses[0].to_string()
        raise gaierror("Name or service not known", (SocketError.HostNotFound as! int))
    except SocketException as ex:
        raise gaierror(ex.Message, ex, (ex.socket_error_code as! int))

def getfqdn() -> str:
    """Return the fully qualified domain name of the local host."""
    try:
        host_name: str = Dns.get_host_name()
        entry = Dns.get_host_entry(host_name)
        return entry.host_name
    except Exception:
        return "localhost"

def getnameinfo(sockaddr: tuple[host: str, port: int], flags: int = 0) -> tuple[host: str, service: str]:
    """Resolve a socket address to a (host, service) tuple."""
    try:
        entry = Dns.get_host_entry(sockaddr[0])
        host: str = entry.host_name
        service: str = str(sockaddr[1])
        return (host, service)
    except SocketException as ex:
        raise gaierror(ex.Message, ex, (ex.socket_error_code as! int))
