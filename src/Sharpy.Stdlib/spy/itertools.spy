"""Functions creating iterators for efficient looping."""

from system import IEquatable

# WHY SOME PRODUCERS HERE ARE WRAPPERS AND MOST ARE NOT YET (#1354, #1518)
#
# Every function in this module is a generator in CPython: `itertools.count(0)` hands back a lazy
# `count` object, not a list. A Sharpy generator lowers to a C# iterator method returning
# IEnumerable<T>; the bridge maps an IEnumerable<T> return onto list[T], and #1251 then binds
# NativeCollectionForm at the assignment site. So `c = itertools.count(0)` emitted
# `new Sharpy.List<int>(Itertools.Count(0))` and ran the producer to exhaustion before the next
# statement — Out of memory for the infinite ones, a silent eager walk for the finite ones. Direct
# iteration (`for n in itertools.count():`) binds no variable and so never materialized, which is
# why the whole pre-existing suite stayed green through the defect.
#
# The cure is the landed glob.iglob recipe (f9507543e): a type deriving from Sharpy.Iterator<T>
# takes a different bridge arm — it maps to a BuiltinType, not a GenericType — so the
# materialization rule rejects it at its first check and never fires. The generator body moves to a
# private `_..._core` (a function containing `yield` cannot itself declare an Iterator[T] return;
# the C# it lowers to must return IEnumerable<T>), and the public name becomes a one-line wrapper
# returning `iter[T](...)`. Builtins.Iter adds no eagerness — it defers to the same enumerator.
#
# ONLY THE NON-GENERIC PRODUCERS CAN TAKE THAT SHAPE TODAY. The wrapper needs a fully CLOSED
# explicit type argument. Measured 2026-08-14 at 16e35a0cd, one probe, all six rows:
#
#   iter[int](_core(...))            in a non-generic def   OK
#   iter(_core(...))                 inferred, non-generic  SPY0237
#   iter[T](_core(...))              in a generic def       SPY0354
#   iter(_core(...))                 inferred, generic      SPY0237
#   iter[tuple[T, T]](_core(...))    in a generic def       SPY0354
#   iter[list[T]](_core(...))        in a generic def       SPY0354
#
# The inferred spelling fails everywhere because the generator call's type is IEnumerable[T] while
# iter's formal is list[T], and those are not assignable — the closed call is accepted by the
# iterable-position projection, not by assignability, and that projection does not cover an open
# formal. That is #1518, filed with its trace. So `count` is flipped here, `accumulate`'s
# non-generic overload is flipped, and the 22 generic producers keep their generator shape with a
# TODO(#1518) at each cluster until the projection reaches them. os.walk (non-generic, closed tuple
# type argument) is flipped in os_module.spy.
#
# Keep the docstring on the PUBLIC wrapper. The `_..._core` helpers are deliberately undocumented:
# docs/stdlib is generated from doc comments, and a docstring here would publish the plumbing onto
# the user-facing page.

def _count_core(start: int, step: int) -> int:
    n: int = start
    while True:
        yield n
        n = n + step

def count(start: int = 0, step: int = 1) -> Iterator[int]:
    """Make an iterator that returns evenly spaced values starting with number start."""
    return iter[int](_count_core(start, step))

# TODO(#1518): every generic producer from here to the end of the file still returns its element
# type (i.e. lowers to IEnumerable<T>) and so still materializes when bound to a variable. Each one
# needs `iter[T](...)` / `iter[tuple[T, T]](...)` / `iter[list[T]](...)`, which is refused while the
# type argument stays open. Flip them in one pass when #1518 lands — the transformation is
# mechanical and identical to `count` above.
def repeat[T](elem: T, n: int = -1) -> T:
    """Make an iterator that returns object over and over again, optionally limited by n times."""
    if n < 0:
        while True:
            yield elem
    else:
        i: int = 0
        while i < n:
            yield elem
            i = i + 1

def cycle[T](iterable: list[T]) -> T:
    """Make an iterator returning elements from the iterable and saving a copy of each."""
    saved: list[T] = list(iterable)
    if len(saved) == 0:
        return
    while True:
        for element in saved:
            yield element

def compress[T](data: list[T], selectors: list[bool]) -> T:
    """Make an iterator that filters elements from data returning only those that have a corresponding element in selectors that evaluates to True."""
    i: int = 0
    limit: int = len(data)
    sel_limit: int = len(selectors)
    while i < limit and i < sel_limit:
        if selectors[i]:
            yield data[i]
        i = i + 1

def dropwhile[T](predicate: (T) -> bool, iterable: list[T]) -> T:
    """Make an iterator that drops elements from the iterable as long as the predicate is true; afterwards, returns every element."""
    dropping: bool = True
    for element in iterable:
        if dropping:
            if not predicate(element):
                dropping = False
                yield element
        else:
            yield element

def takewhile[T](predicate: (T) -> bool, iterable: list[T]) -> T:
    """Make an iterator that returns elements from the iterable as long as the predicate is true."""
    for element in iterable:
        if predicate(element):
            yield element
        else:
            return

def filterfalse[T](predicate: (T) -> bool, iterable: list[T]) -> T:
    """Make an iterator that filters elements from iterable returning only those for which the predicate is false."""
    for element in iterable:
        if not predicate(element):
            yield element

def islice[T](iterable: list[T], stop: int) -> T:
    """Make an iterator that returns selected elements from the iterable."""
    i: int = 0
    for element in iterable:
        if i >= stop:
            return
        yield element
        i = i + 1

def islice_range[T](iterable: list[T], start: int, stop: int, step: int = 1) -> T:
    """Make an iterator that returns selected elements from the iterable with start, stop, and step."""
    i: int = 0
    next_yield: int = start
    for element in iterable:
        if i >= stop:
            return
        if i == next_yield:
            yield element
            next_yield = next_yield + step
        i = i + 1

def pairwise[T](iterable: list[T]) -> tuple[T, T]:
    """Return successive overlapping pairs taken from the input iterable."""
    items: list[T] = list(iterable)
    i: int = 0
    while i < len(items) - 1:
        yield (items[i], items[i + 1])
        i = i + 1

# The one accumulate overload with no type parameter, hence the one that can be flipped today. Its
# two generic siblings below keep the generator shape under the same TODO(#1518) as the rest, so
# the overload set is deliberately asymmetric until that lands. Like _count_core, this must precede
# its wrapper.
def _accumulate_core(iterable: list[int]) -> int:
    items: list[int] = list(iterable)
    if len(items) == 0:
        return
    total: int = items[0]
    yield total
    i: int = 1
    while i < len(items):
        total = total + items[i]
        yield total
        i = i + 1

def accumulate(iterable: list[int]) -> Iterator[int]:
    """Make an iterator that returns accumulated sums."""
    return iter[int](_accumulate_core(iterable))

def accumulate[T](iterable: list[T], func: (T, T) -> T) -> T:
    """Make an iterator that returns accumulated results of a binary function."""
    items: list[T] = list(iterable)
    if len(items) == 0:
        return
    total: T = items[0]
    yield total
    i: int = 1
    while i < len(items):
        total = func(total, items[i])
        yield total
        i = i + 1

def accumulate[T](iterable: list[T], func: (T, T) -> T, initial: T) -> T:
    """Make an iterator that returns accumulated results of a binary function, starting with an initial value."""
    total: T = initial
    yield total
    for item in iterable:
        total = func(total, item)
        yield total

def chain[T](first: list[T], second: list[T]) -> T:
    """Make an iterator that returns elements from the first iterable until it is exhausted, then proceeds to the next iterable."""
    for x in first:
        yield x
    for y in second:
        yield y

def chain[T](first: list[T], second: list[T], third: list[T]) -> T:
    """Make an iterator that returns elements from each iterable in turn until all are exhausted."""
    for x in first:
        yield x
    for y in second:
        yield y
    for z in third:
        yield z

def chain_from_iterable[T](iterables: list[list[T]]) -> T:
    """Make an iterator that chains all iterables from a single list of iterables."""
    for inner in iterables:
        for item in inner:
            yield item

def starmap[T1, T2, R](func: (T1, T2) -> R, iterable: list[tuple[T1, T2]]) -> R:
    """Make an iterator that computes the function using arguments obtained from the iterable."""
    for a, b in iterable:
        yield func(a, b)

def zip_longest[T](first: list[T], second: list[T], fillvalue: T) -> tuple[T, T]:
    """Make an iterator that aggregates elements from each iterable, filling missing values with fillvalue."""
    len_first: int = len(first)
    len_second: int = len(second)
    limit: int = len_first if len_first > len_second else len_second
    i: int = 0
    while i < limit:
        x: T = first[i] if i < len_first else fillvalue
        y: T = second[i] if i < len_second else fillvalue
        yield (x, y)
        i = i + 1

def groupby[T, K: IEquatable[K]](iterable: list[T], key: (T) -> K) -> tuple[K, list[T]]:
    """Make an iterator that returns consecutive keys and groups from the iterable."""
    items: list[T] = list(iterable)
    if len(items) == 0:
        return
    current_key: K = key(items[0])
    group: list[T] = [items[0]]
    i: int = 1
    while i < len(items):
        item_key: K = key(items[i])
        if item_key.equals(current_key):
            group.append(items[i])
        else:
            yield (current_key, group)
            current_key = item_key
            group = [items[i]]
        i = i + 1
    yield (current_key, group)

def product[T1, T2](first: list[T1], second: list[T2]) -> tuple[T1, T2]:
    """Cartesian product of two input iterables, equivalent to nested for-loops."""
    for x in first:
        for y in second:
            yield (x, y)

def product[T1, T2, T3](first: list[T1], second: list[T2], third: list[T3]) -> tuple[T1, T2, T3]:
    """Cartesian product of three input iterables, equivalent to nested for-loops."""
    for x in first:
        for y in second:
            for z in third:
                yield (x, y, z)

def combinations[T](iterable: list[T], r: int) -> list[T]:
    """Return successive r-length combinations of elements in the iterable."""
    if r < 0:
        raise ValueError("r must be non-negative")
    pool: list[T] = list(iterable)
    n: int = len(pool)
    if r > n:
        return
    indices: list[int] = []
    i: int = 0
    while i < r:
        indices.append(i)
        i = i + 1
    results: list[list[T]] = []
    first: list[T] = []
    j: int = 0
    while j < r:
        first.append(pool[indices[j]])
        j = j + 1
    results.append(first)
    while True:
        i = r - 1
        while i >= 0 and indices[i] == n - r + i:
            i = i - 1
        if i < 0:
            break
        indices[i] = indices[i] + 1
        k: int = i + 1
        while k < r:
            indices[k] = indices[k - 1] + 1
            k = k + 1
        combo: list[T] = []
        m: int = 0
        while m < r:
            combo.append(pool[indices[m]])
            m = m + 1
        results.append(combo)
    for result in results:
        yield result

def permutations[T](iterable: list[T], r: int = -1) -> list[T]:
    """Return successive r-length permutations of elements in the iterable. A negative r means full length."""
    pool: list[T] = list(iterable)
    n: int = len(pool)
    size: int = n if r < 0 else r
    if size > n:
        return
    indices: list[int] = []
    i: int = 0
    while i < n:
        indices.append(i)
        i = i + 1
    cycles: list[int] = []
    c: int = n
    while c > n - size:
        cycles.append(c)
        c = c - 1
    results: list[list[T]] = []
    first: list[T] = []
    j: int = 0
    while j < size:
        first.append(pool[indices[j]])
        j = j + 1
    results.append(first)
    done: bool = n == 0
    while not done:
        advanced: bool = False
        i = size - 1
        while i >= 0:
            cycles[i] = cycles[i] - 1
            if cycles[i] == 0:
                rotated: int = indices[i]
                k: int = i
                while k < n - 1:
                    indices[k] = indices[k + 1]
                    k = k + 1
                indices[n - 1] = rotated
                cycles[i] = n - i
            else:
                swap_idx: int = n - cycles[i]
                temp: int = indices[i]
                indices[i] = indices[swap_idx]
                indices[swap_idx] = temp
                perm: list[T] = []
                m: int = 0
                while m < size:
                    perm.append(pool[indices[m]])
                    m = m + 1
                results.append(perm)
                advanced = True
                break
            i = i - 1
        if not advanced:
            done = True
    for result in results:
        yield result

def combinations_with_replacement[T](iterable: list[T], r: int) -> list[T]:
    """Return successive r-length combinations of elements in the iterable allowing individual elements to be repeated."""
    if r < 0:
        raise ValueError("r must be non-negative")
    pool: list[T] = list(iterable)
    n: int = len(pool)
    if n == 0 and r > 0:
        return
    indices: list[int] = []
    i: int = 0
    while i < r:
        indices.append(0)
        i = i + 1
    results: list[list[T]] = []
    first: list[T] = []
    j: int = 0
    while j < r:
        first.append(pool[indices[j]])
        j = j + 1
    results.append(first)
    while True:
        i = r - 1
        while i >= 0 and indices[i] == n - 1:
            i = i - 1
        if i < 0:
            break
        new_val: int = indices[i] + 1
        k: int = i
        while k < r:
            indices[k] = new_val
            k = k + 1
        combo: list[T] = []
        m: int = 0
        while m < r:
            combo.append(pool[indices[m]])
            m = m + 1
        results.append(combo)
    for result in results:
        yield result
