"""Time access and conversions."""
# Named *_stub, not *_module: a `time_module` stem is the namespace Sharpy.TimeModule, which would
# shadow the hand-written TimeModule this module delegates to (SPY0615, #2039).

from sharpy import TimeModule

def time() -> float:
    """Return the time in seconds since the epoch as a floating point number."""
    return TimeModule.time()

def time_ns() -> long:
    """Return the time in nanoseconds since the epoch."""
    return TimeModule.time_ns()

def sleep(secs: float) -> None:
    """Suspend execution for the given number of seconds."""
    TimeModule.sleep(secs)
