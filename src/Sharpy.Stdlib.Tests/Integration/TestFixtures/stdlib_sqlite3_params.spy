# Test sqlite3 module: parameterized queries with ? placeholders
import sqlite3

def main():
    conn = sqlite3.connect(":memory:")
    cur = conn.cursor()
    cur.execute("CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT, price REAL)")
    params1: list[object] = ["apple", 1.5]
    cur.execute("INSERT INTO items (name, price) VALUES (?, ?)", params1)
    params2: list[object] = ["banana", 0.75]
    cur.execute("INSERT INTO items (name, price) VALUES (?, ?)", params2)
    params3: list[object] = ["cherry", 3.0]
    cur.execute("INSERT INTO items (name, price) VALUES (?, ?)", params3)
    conn.commit()
    print(cur.lastrowid)
    params4: list[object] = [2.0, "banana"]
    cur.execute("UPDATE items SET price = ? WHERE name = ?", params4)
    conn.commit()
    print(cur.rowcount)
    cur.execute("SELECT name FROM items WHERE price > ? ORDER BY name", [1.0])
    rows = cur.fetchall()
    print(len(rows))
    cur.execute("DELETE FROM items WHERE name = ?", ["cherry"])
    conn.commit()
    print(cur.rowcount)
    conn.close()
