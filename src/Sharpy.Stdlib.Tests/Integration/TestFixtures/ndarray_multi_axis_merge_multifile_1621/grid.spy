# The subscripts live HERE, in a non-entry file: one IndexSpread read (a[1, 1] = 50.0), one
# SliceCall with [Slice, Slice] (a[0:2, 0:2] -> [[10, 20], [40, 50]], corners 10 + 50 = 60.0),
# and one SliceCall with [Index, Slice] (a[1, :] -> 3 elements).
import numpy as np


def center() -> float:
    a = np.array([[10.0, 20.0, 30.0], [40.0, 50.0, 60.0]])
    return a[1, 1]


def corner_sum() -> float:
    a = np.array([[10.0, 20.0, 30.0], [40.0, 50.0, 60.0]])
    s = a[0:2, 0:2]
    return s[0, 0] + s[1, 1]


def row_size() -> int:
    a = np.array([[10.0, 20.0, 30.0], [40.0, 50.0, 60.0]])
    r = a[1, :]
    return r.size
