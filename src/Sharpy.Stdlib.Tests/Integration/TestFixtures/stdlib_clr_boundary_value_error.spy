# #2461: a Stdlib boundary raises ValueError where Python does, so `except ValueError`
# catches it (never a System.ArgumentOutOfRangeException / ArgumentException).
import datetime
import numpy as np

def main():
    try:
        datetime.date(2023, 2, 29)
    except ValueError as e:
        print("date: " + str(e))

    try:
        datetime.date(2023, 13, 1)
    except ValueError as e:
        print("date month: " + str(e))

    try:
        datetime.date(10000, 1, 1)
    except ValueError as e:
        print("date year: " + str(e))

    try:
        datetime.time(25, 0)
    except ValueError as e:
        print("time: " + str(e))

    try:
        datetime.time(0, 0, 0, 1000000)
    except ValueError as e:
        print("time microsecond: " + str(e))

    try:
        datetime.datetime(2023, 2, 29)
    except ValueError as e:
        print("datetime: " + str(e))

    try:
        datetime.datetime(2023, 1, 1, 0, 60)
    except ValueError as e:
        print("datetime minute: " + str(e))

    try:
        _ = np.array([1.0, 2.0, 3.0]) + np.array([1.0, 2.0])
    except ValueError as e:
        print("broadcast: " + str(e).strip())

    try:
        _ = np.array([1.0, 2.0, 3.0, 4.0]).reshape(3, 2)
    except ValueError as e:
        print("reshape: " + str(e))

    try:
        _ = np.zeros(-1)
    except ValueError as e:
        print("zeros: " + str(e))

    try:
        _ = np.concatenate([np.zeros(6).reshape(2, 3), np.zeros(4).reshape(2, 2)], 0)
    except ValueError as e:
        print("concatenate: " + str(e))

    r = np.clip(np.array([1.0, 3.0, 7.0]), 5.0, 2.0)
    print("clip: " + str(r[0]) + " " + str(r[1]) + " " + str(r[2]))
