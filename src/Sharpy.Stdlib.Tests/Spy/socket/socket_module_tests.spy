# Ported from src/Sharpy.Stdlib.Tests/SocketModuleTests.cs (46 [Fact] methods).
#
# All networked tests use the loopback interface (127.0.0.1) only, so they are
# hermetic and require no external connectivity.
#
# Named-tuple results (e.g. (host, port)) are accessed positionally ([0]/[1]) or
# via destructuring, because element-name access on CLR-returned named tuples is
# currently mis-mangled to PascalCase. Positional/unpack access is correct.
#
# The socket `.type` property is lowercase in the DLL; Sharpy member access
# PascalCases it to `.Type`, which does not exist, so it is unreachable. The
# three creation tests therefore assert only `.Family` (plus successful
# construction with the requested type), dropping the `.type` check.
#
# create_connection()'s return value is annotated `socket.socket` because the
# function's return type does not flow through inference (indexing the resulting
# tuple otherwise fails); the explicit annotation restores it.
#
# Omitted (1 of 46 methods):
#   - Error_FromSocketException_PreservesErrno: constructs a raw .NET
#     SocketException and asserts reference identity of InnerException. No Sharpy
#     surface for building a SocketException or inspecting InnerException identity.
#
# Error-hierarchy tests (3 source methods, folded to 2 tests) were unblocked by
# #945: socket.error / socket.timeout now resolve to SocketModule's nested
# exception types (no longer collide with re.Error), so `except socket.error:`
# catches a raised socket.timeout.
#
# Tests that depend on a DNS resolver being present (kept, but noted):
#   - test_gethostbyname_localhost_returns_loopback
#   - test_gethostname_returns_non_empty
#   - test_gethostbyname_invalid_host_raises_gaierror
#   - test_getnameinfo_localhost_returns_host_and_service
# These resolve only localhost / 127.0.0.1 (or a guaranteed-invalid name), which
# the OS resolver answers without network access.

from unittest import assert_raises

import socket
import time

# ---- Constants ----

@test
def test_af_inet_has_correct_value():
    assert socket.AF_INET == 2

@test
def test_af_inet6_has_correct_value():
    assert socket.AF_INET6 == 23 or socket.AF_INET6 == 10 or socket.AF_INET6 == 30

@test
def test_sock_stream_has_correct_value():
    assert socket.SOCK_STREAM == 1

@test
def test_sock_dgram_has_correct_value():
    assert socket.SOCK_DGRAM == 2

@test
def test_sock_raw_has_correct_value():
    assert socket.SOCK_RAW == 3

@test
def test_ipproto_tcp_has_correct_value():
    assert socket.IPPROTO_TCP == 6

@test
def test_ipproto_udp_has_correct_value():
    assert socket.IPPROTO_UDP == 17

@test
def test_shut_rd_has_correct_value():
    assert socket.SHUT_RD == 0

@test
def test_shut_wr_has_correct_value():
    assert socket.SHUT_WR == 1

@test
def test_shut_rdwr_has_correct_value():
    assert socket.SHUT_RDWR == 2

@test
def test_tcp_nodelay_has_correct_value():
    assert socket.TCP_NODELAY != 0

@test
def test_so_rcvbuf_has_correct_value():
    assert socket.SO_RCVBUF != 0

@test
def test_so_sndbuf_has_correct_value():
    assert socket.SO_SNDBUF != 0

@test
def test_somaxconn_is_128():
    assert socket.SOMAXCONN == 128

# ---- Socket creation ----

@test
def test_socket_creates_stream_socket():
    # NOTE: the C# test also asserts `s.type == SOCK_STREAM`, but the socket
    # `type` property is lowercase in the DLL and member access mangles it to
    # `Type`, which doesn't exist, so it is unreachable from Sharpy (see header).
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    assert s.Family == socket.AF_INET
    s.close()

@test
def test_socket_creates_datagram_socket():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    assert s.Family == socket.AF_INET
    s.close()

@test
def test_socket_default_params_creates_ipv4_stream():
    s = socket.socket()
    assert s.Family == socket.AF_INET
    s.close()

# ---- TCP server / client (loopback) ----

@test
def test_tcp_server_bind_listen_accept_works():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(("127.0.0.1", 0))
    server.listen(5)

    server_addr = server.getsockname()
    assert server_addr[0] == "127.0.0.1"
    assert server_addr[1] > 0

    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client.connect(("127.0.0.1", server_addr[1]))

    conn, addr = server.accept()
    assert addr[0] == "127.0.0.1"
    assert addr[1] > 0

    conn.close()
    client.close()
    server.close()

@test
def test_tcp_send_recv_works():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(("127.0.0.1", 0))
    server.listen(1)
    port = server.getsockname()[1]

    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client.connect(("127.0.0.1", port))

    conn, _ = server.accept()

    message: bytes = b"hello"
    client.sendall(message)

    received: bytes = conn.recv(1024)
    assert received == b"hello"

    conn.close()
    client.close()
    server.close()

# ---- UDP (loopback) ----

@test
def test_udp_sendto_recvfrom_works():
    receiver = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    receiver.bind(("127.0.0.1", 0))
    port = receiver.getsockname()[1]

    sender = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    message: bytes = b"udp test"
    sender.sendto(message, ("127.0.0.1", port))

    data, addr = receiver.recvfrom(1024)
    assert data == b"udp test"
    assert addr[0] == "127.0.0.1"

    sender.close()
    receiver.close()

# ---- DNS ----

@test
def test_gethostbyname_localhost_returns_loopback():
    ip: str = socket.gethostbyname("localhost")
    assert ip == "127.0.0.1" or ip == "::1"

@test
def test_gethostname_returns_non_empty():
    hostname: str = socket.gethostname()
    assert hostname != ""

@test
def test_gethostbyname_invalid_host_raises_gaierror():
    with assert_raises(socket.gaierror):
        socket.gethostbyname("this.host.does.not.exist.invalid")

# ---- Socket options ----

@test
def test_setsockopt_getsockopt_reuse_addr():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    val: int = s.getsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR)
    assert val != 0
    s.close()

# ---- Timeout ----

@test
def test_settimeout_gettimeout_works():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(5.0)
    t = s.gettimeout()
    assert t is not None
    if t is not None:
        assert t == 5.0

    s.settimeout(None)
    assert s.gettimeout() is None
    s.close()

# ---- Default timeout ----

@test
def test_getdefaulttimeout_returns_null_by_default():
    socket.setdefaulttimeout(None)
    assert socket.getdefaulttimeout() is None

@test
def test_setdefaulttimeout_sets_and_gets():
    socket.setdefaulttimeout(10.0)
    d = socket.getdefaulttimeout()
    assert d is not None
    if d is not None:
        assert d == 10.0
    socket.setdefaulttimeout(None)

@test
def test_setdefaulttimeout_applied_to_new_sockets():
    socket.setdefaulttimeout(3.0)
    s = socket.socket()
    t = s.gettimeout()
    assert t is not None
    if t is not None:
        assert t == 3.0
    s.close()
    socket.setdefaulttimeout(None)

# ---- Byte order ----

@test
def test_htons_ntohs_round_trips():
    original: int = 8080
    network: int = socket.htons(original)
    host: int = socket.ntohs(network)
    assert host == original

@test
def test_htonl_ntohl_round_trips():
    original: int = 0x12345678
    network: int = socket.htonl(original)
    host: int = socket.ntohl(network)
    assert host == original

# ---- Inet conversions ----

@test
def test_inet_aton_ntoa_round_trips():
    ip: str = "192.168.1.1"
    packed: bytes = socket.inet_aton(ip)
    result: str = socket.inet_ntoa(packed)
    assert result == ip

@test
def test_inet_pton_ntop_ipv4_round_trips():
    ip: str = "10.0.0.1"
    packed: bytes = socket.inet_pton(socket.AF_INET, ip)
    assert len(packed) == 4
    result: str = socket.inet_ntop(socket.AF_INET, packed)
    assert result == ip

@test
def test_inet_pton_ntop_ipv6_round_trips():
    ip: str = "::1"
    packed: bytes = socket.inet_pton(socket.AF_INET6, ip)
    assert len(packed) == 16
    result: str = socket.inet_ntop(socket.AF_INET6, packed)
    assert result == ip

# ---- IPv6 ----

@test
def test_socket_ipv6_can_create():
    s = socket.socket(socket.AF_INET6, socket.SOCK_STREAM)
    assert s.Family == socket.AF_INET6
    s.close()

# ---- Error handling ----


@test
def test_connect_invalid_address_raises_error():
    # connect() to an unroutable address (with a short timeout) raises a
    # socket.error subclass (socket.timeout). Caught via the base `error` type with
    # try/except, which is subclass-based — assert_raises is exact-match and would
    # reject the Timeout subclass.
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(1.0)
    caught: bool = False
    is_timeout: bool = False
    start: float = time.monotonic()
    try:
        s.connect(("192.0.2.1", 1))
    except Exception as e:
        caught = isinstance(e, socket.error)
        is_timeout = isinstance(e, socket.timeout)
    elapsed: float = time.monotonic() - start
    assert caught
    # settimeout governs connect (#2177): the 1 s timeout elapses and raises
    # socket.timeout, where an un-timed connect waited the OS default (~75 s on
    # macOS). A host whose network refuses 192.0.2.1 outright raises a plain
    # socket.error before the timeout can elapse; python3 does the same.
    assert elapsed < 5.0
    assert (is_timeout and elapsed >= 0.5) or (not is_timeout and elapsed < 0.5)
    s.close()


@test
def test_error_hierarchy():
    # Folds the three BeAssignableTo<Error> checks: each subclass instance is
    # catchable as the base `error` type. Uses try/except (subclass-based) rather
    # than assert_raises (exact-match), which would reject the subclasses.
    timeout_caught: bool = False
    try:
        raise socket.timeout("timed out")
    except socket.error:
        timeout_caught = True
    assert timeout_caught

    gaierror_caught: bool = False
    try:
        raise socket.gaierror("name resolution failed")
    except socket.error:
        gaierror_caught = True
    assert gaierror_caught

    herror_caught: bool = False
    try:
        raise socket.herror("host error")
    except socket.error:
        herror_caught = True
    assert herror_caught

# ---- create_connection (loopback) ----

@test
def test_create_connection_connects_to_local_server():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(("127.0.0.1", 0))
    server.listen(1)
    port = server.getsockname()[1]

    client: socket.socket = socket.create_connection(("127.0.0.1", port))

    peer = client.getpeername()
    assert peer[0] == "127.0.0.1"
    assert peer[1] == port

    conn, _ = server.accept()
    conn.close()
    client.close()
    server.close()

@test
def test_create_connection_invalid_address_raises():
    # create_connection re-raises the underlying connect() failure, a socket.error
    # subclass (socket.timeout). Caught via try/except on the base `error` type
    # (subclass-based), since assert_raises is exact-match.
    caught: bool = False
    is_timeout: bool = False
    start: float = time.monotonic()
    try:
        socket.create_connection(("192.0.2.1", 1), timeout=1.0)
    except Exception as e:
        caught = isinstance(e, socket.error)
        is_timeout = isinstance(e, socket.timeout)
    elapsed: float = time.monotonic() - start
    assert caught
    # The timeout= argument governs the connect (#2177); see
    # test_connect_invalid_address_raises_error for the two admissible outcomes.
    assert elapsed < 5.0
    assert (is_timeout and elapsed >= 0.5) or (not is_timeout and elapsed < 0.5)

# ---- settimeout governs every blocking operation (#2177) ----
#
# Cells: operation {connect, create_connection, accept, send, recv} x timeout
# {1.0, None, 0.0}. 1.0 raises socket.timeout after ~1 s; 0.0 (non-blocking)
# raises a plain socket.error at once (python3: BlockingIOError); None blocks, so
# its cells are the successful loopback tests above. Each pair of a listener and a
# connected client is loopback-only.

def _elapsed_since(start: float) -> float:
    return time.monotonic() - start

@test
def test_accept_with_timeout_raises_timeout():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.bind(("127.0.0.1", 0))
    server.listen(1)
    server.settimeout(1.0)
    start: float = time.monotonic()
    with assert_raises(socket.timeout):
        server.accept()
    elapsed: float = _elapsed_since(start)
    assert elapsed >= 0.5
    assert elapsed < 5.0
    server.close()

@test
def test_accept_with_timeout_returns_pending_connection():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.bind(("127.0.0.1", 0))
    server.listen(1)
    server.settimeout(1.0)
    port = server.getsockname()[1]
    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client.connect(("127.0.0.1", port))
    conn, addr = server.accept()
    assert addr[0] == "127.0.0.1"
    conn.close()
    client.close()
    server.close()

@test
def test_accept_with_sub_millisecond_timeout_raises_timeout():
    # A positive timeout below 1 ms still times out; it never means "blocking".
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.bind(("127.0.0.1", 0))
    server.listen(1)
    server.settimeout(0.0001)
    start: float = time.monotonic()
    with assert_raises(socket.timeout):
        server.accept()
    assert _elapsed_since(start) < 5.0
    server.close()

@test
def test_accept_non_blocking_raises_error_immediately():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.bind(("127.0.0.1", 0))
    server.listen(1)
    server.settimeout(0.0)
    caught: bool = False
    is_timeout: bool = False
    start: float = time.monotonic()
    try:
        server.accept()
    except Exception as e:
        caught = isinstance(e, socket.error)
        is_timeout = isinstance(e, socket.timeout)
    assert caught
    assert not is_timeout
    assert _elapsed_since(start) < 0.5
    server.close()

@test
def test_connect_non_blocking_raises_error_immediately():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(0.0)
    caught: bool = False
    is_timeout: bool = False
    start: float = time.monotonic()
    try:
        s.connect(("192.0.2.1", 1))
    except Exception as e:
        caught = isinstance(e, socket.error)
        is_timeout = isinstance(e, socket.timeout)
    assert caught
    assert not is_timeout
    assert _elapsed_since(start) < 0.5
    s.close()

@test
def test_connect_with_timeout_succeeds_to_listening_server():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.bind(("127.0.0.1", 0))
    server.listen(1)
    port = server.getsockname()[1]
    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client.settimeout(1.0)
    client.connect(("127.0.0.1", port))
    peer = client.getpeername()
    assert peer[0] == "127.0.0.1"
    assert peer[1] == port
    conn, _ = server.accept()
    client.sendall(b"ping")
    received: bytes = conn.recv(16)
    assert received == b"ping"
    conn.close()
    client.close()
    server.close()

@test
def test_create_connection_with_timeout_succeeds_to_listening_server():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.bind(("127.0.0.1", 0))
    server.listen(1)
    port = server.getsockname()[1]
    client: socket.socket = socket.create_connection(("127.0.0.1", port), timeout=1.0)
    peer = client.getpeername()
    assert peer[1] == port
    conn, _ = server.accept()
    conn.close()
    client.close()
    server.close()

@test
def test_connect_with_timeout_refused_raises_error_not_timeout():
    # python3: ConnectionRefusedError (an OSError, not a TimeoutError), at once.
    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    probe.bind(("127.0.0.1", 0))
    port = probe.getsockname()[1]
    probe.close()
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(1.0)
    caught: bool = False
    is_timeout: bool = False
    try:
        s.connect(("127.0.0.1", port))
    except Exception as e:
        caught = isinstance(e, socket.error)
        is_timeout = isinstance(e, socket.timeout)
    assert caught
    assert not is_timeout
    s.close()

@test
def test_recv_with_timeout_raises_timeout():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.bind(("127.0.0.1", 0))
    server.listen(1)
    port = server.getsockname()[1]
    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client.connect(("127.0.0.1", port))
    conn, _ = server.accept()
    client.settimeout(1.0)
    start: float = time.monotonic()
    with assert_raises(socket.timeout):
        client.recv(16)
    elapsed: float = _elapsed_since(start)
    assert elapsed >= 0.5
    assert elapsed < 5.0
    conn.close()
    client.close()
    server.close()

@test
def test_send_with_timeout_raises_timeout_when_peer_does_not_read():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.bind(("127.0.0.1", 0))
    server.listen(1)
    port = server.getsockname()[1]
    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client.connect(("127.0.0.1", port))
    conn, _ = server.accept()
    client.settimeout(1.0)
    chunk: bytes = b"x" * 65536
    is_timeout: bool = False
    start: float = time.monotonic()
    try:
        while _elapsed_since(start) < 10.0:
            client.send(chunk)
    except Exception as e:
        is_timeout = isinstance(e, socket.timeout)
    assert is_timeout
    assert _elapsed_since(start) < 5.0
    conn.close()
    client.close()
    server.close()

@test
def test_settimeout_negative_raises_value_error():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    with assert_raises(ValueError):
        s.settimeout(-1.0)
    assert s.gettimeout() is None
    s.close()

# ---- One timeout-value rule for every entry point (#2228) ----
#
# Cells: entry point {setdefaulttimeout, settimeout, create_connection(timeout=)}
# x value, each measured against python3 3.12:
#   None, 0.0, -0.0, 1.5, 1e6, 9.2e9 (int64 ns fits)   accepted
#   -1.0, -1e-10 (negative)                            ValueError
#   nan                                                ValueError
#   inf, -inf, 9.3e9, 1e300, -1e300 (int64 ns overflow) OverflowError
# The refusal is raised AT the call (setdefaulttimeout used to store the value
# and let the next socket() construction raise), and a refused call leaves the
# previous timeout / default unchanged.

def _timeout_outcome(e: Exception) -> str:
    if isinstance(e, OverflowError):
        return "OverflowError"
    if isinstance(e, ValueError):
        return "ValueError"
    if isinstance(e, socket.error):
        return "socket.error"
    return "other"

def _same_timeout(actual: float | None, expected: float | None) -> bool:
    if actual is None or expected is None:
        return actual is None and expected is None
    a: float = actual
    b: float = expected
    return a == b

def _closed_loopback_port() -> int:
    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    probe.bind(("127.0.0.1", 0))
    port: int = probe.getsockname()[1]
    probe.close()
    return port

def _assert_timeout_rule(value: float | None, expected: str) -> None:
    # setdefaulttimeout: the outcome is decided at the call. The next socket()
    # construction never raises and sees the accepted value, or the previous
    # default when the call was refused.
    survivor: float | None = 2.0
    if expected == "accepted":
        survivor = value
    outcome: str = "accepted"
    socket.setdefaulttimeout(2.0)
    try:
        try:
            socket.setdefaulttimeout(value)
        except Exception as e:
            outcome = _timeout_outcome(e)
        assert outcome == expected
        assert _same_timeout(socket.getdefaulttimeout(), survivor)
        fresh = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        assert _same_timeout(fresh.gettimeout(), survivor)
        fresh.close()
    finally:
        # Never leak a default (refused or not) into the other socket tests.
        socket.setdefaulttimeout(None)

    # settimeout: same rule; a refused call keeps the socket's previous timeout.
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(2.0)
    outcome = "accepted"
    try:
        s.settimeout(value)
    except Exception as e:
        outcome = _timeout_outcome(e)
    assert outcome == expected
    assert _same_timeout(s.gettimeout(), survivor)
    s.close()

    # create_connection(timeout=): a refused value raises before any connect;
    # an accepted one reaches the connect, which the closed port refuses with
    # socket.error (never socket.timeout: the refusal is immediate).
    port: int = _closed_loopback_port()
    outcome = "accepted"
    try:
        c: socket.socket = socket.create_connection(("127.0.0.1", port), timeout=value)
        c.close()
    except Exception as e:
        outcome = _timeout_outcome(e)
        assert not isinstance(e, socket.timeout)
    if expected == "accepted":
        assert outcome == "socket.error"
    else:
        assert outcome == expected

@test
def test_timeout_rule_accepts_none_zero_and_positive():
    _assert_timeout_rule(None, "accepted")
    _assert_timeout_rule(0.0, "accepted")
    _assert_timeout_rule(-0.0, "accepted")
    _assert_timeout_rule(1.5, "accepted")

@test
def test_timeout_rule_accepts_very_large_within_int64_nanoseconds():
    _assert_timeout_rule(1e6, "accepted")
    _assert_timeout_rule(9.2e9, "accepted")

@test
def test_timeout_rule_refuses_negative_with_value_error():
    _assert_timeout_rule(-1.0, "ValueError")
    _assert_timeout_rule(-1e-10, "ValueError")

@test
def test_timeout_rule_refuses_nan_with_value_error():
    _assert_timeout_rule(float("nan"), "ValueError")

@test
def test_timeout_rule_refuses_int64_nanosecond_overflow_with_overflow_error():
    _assert_timeout_rule(float("inf"), "OverflowError")
    _assert_timeout_rule(float("-inf"), "OverflowError")
    _assert_timeout_rule(9.3e9, "OverflowError")
    _assert_timeout_rule(1e300, "OverflowError")
    _assert_timeout_rule(-1e300, "OverflowError")

@test
def test_very_large_timeout_still_governs_loopback_connect_and_recv():
    # 9.2e9 s is accepted (python3 too) but exceeds the int milliseconds .NET
    # takes; it must wait (capped), not overflow into a 1 ms timeout.
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.bind(("127.0.0.1", 0))
    server.listen(1)
    port = server.getsockname()[1]
    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client.settimeout(9.2e9)
    client.connect(("127.0.0.1", port))
    conn, _ = server.accept()
    conn.settimeout(9.2e9)
    sent: int = client.send(b"ping")
    assert sent == 4
    received: bytes = conn.recv(16)
    assert received == b"ping"
    conn.close()
    client.close()
    server.close()

# ---- ToString ----

@test
def test_str_contains_socket_info():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    text: str = str(s)
    assert "socket" in text
    assert "family=" in text
    assert "type=" in text
    s.close()

# ---- getpeername ----

@test
def test_getpeername_after_connect_returns_remote_addr():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(("127.0.0.1", 0))
    server.listen(1)
    port = server.getsockname()[1]

    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    client.connect(("127.0.0.1", port))

    peer = client.getpeername()
    assert peer[0] == "127.0.0.1"
    assert peer[1] == port

    conn, _ = server.accept()
    conn.close()
    client.close()
    server.close()

# ---- setblocking / getblocking ----

@test
def test_setblocking_false_sets_non_blocking():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setblocking(False)
    assert not s.getblocking()
    s.close()

@test
def test_setblocking_true_sets_blocking():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setblocking(False)
    s.setblocking(True)
    assert s.getblocking()
    s.close()

# ---- getnameinfo ----

@test
def test_getnameinfo_localhost_returns_host_and_service():
    host, service = socket.getnameinfo(("127.0.0.1", 80))
    assert host != ""
    assert service == "80"
