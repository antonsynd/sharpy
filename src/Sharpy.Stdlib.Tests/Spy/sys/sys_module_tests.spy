import sys

# Ported from SysModuleTests.cs (#843). 16/21 ported, 5 omitted.
# Stdout_IsConsoleOut/Stderr_IsConsoleError BeSameAs(Console.Out/Error) identity
# checks are replaced by weaker not-None assertions (reference identity has no
# Sharpy surface; behavioral non-null is verifiable).
#
# The copy-contract tests (Argv_ReturnsCopy/Path_ReturnsCopy/
# Argv_MutatingCopy_DoesNotAffectSource) were originally omitted as
# reference-identity-only — true while argv/path were CLR string[] with no
# Sharpy mutation surface. #1256 made both list[str], so `.append()` IS a
# Sharpy surface and the contract is behaviorally testable: mutate what a
# caller received, re-read, unchanged (test_argv_mutating_copy_* /
# test_path_mutating_copy_* below).
#
# 5 omitted: Print_WithStderrFile/Stdout_WriteRoutesToConsoleOut (StringWriter +
# Console.SetError/SetOut redirect — no Sharpy surface); Getsizeof_Null_ReturnsZero
# (null arg to non-nullable param, Axiom 3); Executable_MatchesArgvZeroOrEmpty
# (string.IsNullOrEmpty + ternary, C#-specific); the two ReturnsCopy
# reference-identity spellings themselves (NotBeSameAs — subsumed by the
# behavioral mutation tests above).


# --- Streams ---

@test
def test_stdout_is_not_none():
    assert sys.stdout is not None


@test
def test_stderr_is_not_none():
    assert sys.stderr is not None


@test
def test_stdin_is_not_none():
    assert sys.stdin is not None


# --- Argv ---

@test
def test_argv_is_not_none():
    assert sys.argv is not None


@test
def test_argv_has_at_least_program_name():
    assert len(sys.argv) > 0


@test
def test_argv_mutating_copy_does_not_affect_source():
    # The copy contract (#1256): each access returns a fresh list, so mutating
    # what a caller received cannot reach the backing store.
    copy = sys.argv
    before = len(copy)
    copy.append("injected")
    assert len(sys.argv) == before


# --- Version ---

@test
def test_version_contains_sharpy():
    assert "Sharpy" in sys.version


@test
def test_version_is_not_empty():
    assert len(sys.version) > 0


# --- Platform ---

@test
def test_platform_is_recognized_value():
    p: str = sys.platform
    assert len(p) > 0
    valid: bool = p == "win32" or p == "linux" or p == "darwin" or p == "unknown"
    assert valid


# --- Executable ---

@test
def test_executable_is_not_none():
    assert sys.executable is not None


# --- Path ---

@test
def test_path_is_not_none():
    assert sys.path is not None


@test
def test_path_is_not_empty():
    assert len(sys.path) > 0


@test
def test_path_mutating_copy_does_not_affect_source():
    # Same copy contract as argv (#1256): sys.path is a fresh list per access.
    copy = sys.path
    before = len(copy)
    copy.append("/injected")
    assert len(sys.path) == before


# --- Maxsize ---

@test
def test_maxsize_is_int_max_value():
    assert sys.maxsize == 2147483647


# --- Getsizeof ---

@test
def test_getsizeof_value_type_returns_positive_size():
    assert sys.getsizeof(42) > 0


@test
def test_getsizeof_reference_type_returns_minus_one():
    assert sys.getsizeof("a reference type") == -1
