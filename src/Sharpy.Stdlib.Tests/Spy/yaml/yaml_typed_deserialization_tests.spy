from unittest import assert_raises

import yaml

# Ported from YamlTypedDeserializationTests.cs (#843).
# yaml.safe_load_typed[T]() returns Result<T, YAMLError>. SafeLoadTyped uses the
# UnderscoredNamingConvention, so snake_case YAML keys map onto the class fields
# (which mangle to PascalCase C# properties).
# Omitted (documented in PORTING.md):
#   - SafeLoadTyped_Null_ThrowsTypeError: passes null to a non-nullable str
#     parameter, which Sharpy rejects at compile time (Axiom 3).


class ServerConfig:
    host: str = ""
    port: int = 0
    enabled: bool = False


class SnakeCaseConfig:
    service_name: str = ""
    max_connections: int = 0


class NestedConfig:
    label: str = ""
    server: ServerConfig = ServerConfig()


class RatioConfig:
    ratio: float = 0.0


# --- SafeLoadTyped — success ---

@test
def test_safe_load_typed_simple_class_deserializes():
    result = yaml.safe_load_typed[ServerConfig]("host: localhost\nport: 8080\nenabled: true\n")
    assert result.IsOk
    config = result.Unwrap()
    assert config.host == "localhost"
    assert config.port == 8080
    assert config.enabled

@test
def test_safe_load_typed_snake_case_keys_map_to_pascal_case():
    result = yaml.safe_load_typed[SnakeCaseConfig]("service_name: api\nmax_connections: 100\n")
    assert result.IsOk
    config = result.Unwrap()
    assert config.service_name == "api"
    assert config.max_connections == 100

@test
def test_safe_load_typed_nested_class_deserializes():
    result = yaml.safe_load_typed[NestedConfig]("label: outer\nserver:\n  host: db\n  port: 5432\n  enabled: false\n")
    assert result.IsOk
    config = result.Unwrap()
    assert config.label == "outer"
    assert config.server.host == "db"
    assert config.server.port == 5432
    assert not config.server.enabled

# --- SafeLoadTyped — errors ---

@test
def test_safe_load_typed_type_mismatch_returns_err():
    result = yaml.safe_load_typed[ServerConfig]("host: localhost\nport: not_a_number\nenabled: true\n")
    assert result.IsErr
    error = result.UnwrapErr()
    assert isinstance(error, yaml.YAMLError)

@test
def test_safe_load_typed_malformed_yaml_returns_err():
    result = yaml.safe_load_typed[ServerConfig]("host: [unbalanced\n")
    assert result.IsErr


# --- SafeLoadTyped — scalar precision (#1339 probe, #1353 remediation) ---
# The untyped loader's single-precision detour was #1339: safe_load("0.1") came back
# 0.10000000149011612 because YamlDotNet's convenience resolver tried float before double.
# The typed path builds its OWN deserializer and was argued to be unaffected by construction —
# but the plan asked for a probe rather than an assumption, and nothing pinned it. This is that
# pin: a typed float FIELD must carry the double, not a widened Single.
#
# 0.1 is chosen because it is not float32-exact; a Single detour shows up in the value itself,
# which is what the untyped suite was blind to before #1339.

@test
def test_safe_load_typed_float_field_keeps_double_precision():
    result = yaml.safe_load_typed[RatioConfig]("ratio: 0.1")
    assert result.IsOk
    cfg = result.Unwrap()
    assert cfg.ratio == 0.1


@test
def test_safe_load_typed_float_field_survives_non_float32_exact_values():
    doc = "ratio: -0.30000000000000004"
    result = yaml.safe_load_typed[RatioConfig](doc)
    assert result.IsOk
    cfg = result.Unwrap()
    assert cfg.ratio == -0.30000000000000004


# --- SafeLoadTyped — @dataclass targets (#1424) ---
# Every class above carries field DEFAULTS, which is what gives it a parameterless constructor. A
# @dataclass has none: it lowers to settable properties plus an all-fields constructor and nothing
# else, so YamlDotNet's default factory — which calls Activator.CreateInstance — failed with
# MissingMethodException, surfaced through the Result's error arm as a .NET reflection message
# mentioning neither YAML nor dataclasses.
#
# Measured before choosing a fix: json.loads[T] ALREADY accepts this shape, because System.Text.Json
# matches constructor parameters to property names. Refusing it here would have left the two
# serializers giving opposite answers for the same user type.


@dataclass
class DataclassConfig:
    ratio: float


@dataclass
class DataclassMultiField:
    service_name: str
    max_connections: int
    enabled: bool


@test
def test_safe_load_typed_dataclass_target_deserializes():
    result = yaml.safe_load_typed[DataclassConfig]("ratio: 0.1")
    assert result.IsOk
    cfg = result.Unwrap()
    assert cfg.ratio == 0.1


@test
def test_safe_load_typed_dataclass_binds_every_field_by_name():
    # The constructor is called with PLACEHOLDER arguments and the deserializer sets the properties
    # afterwards, so this fails loudly if construction order were ever mistaken for binding order.
    doc = "service_name: api\nmax_connections: 100\nenabled: true\n"
    result = yaml.safe_load_typed[DataclassMultiField](doc)
    assert result.IsOk
    cfg = result.Unwrap()
    assert cfg.service_name == "api"
    assert cfg.max_connections == 100
    assert cfg.enabled
