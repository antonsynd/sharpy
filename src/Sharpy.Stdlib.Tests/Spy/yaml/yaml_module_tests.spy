# The bound on the family, and the reason it is not spelled as a case-insensitive compare:
# PyYAML resolves exactly three casings per word and nothing else.

@test
def test_safe_load_norway_mixed_casing_stays_string():
    result: object = yaml.safe_load("key: yEs")
    match result:
        case dict() as d:
            assert isinstance(d["key"], str)
            assert operator.eq(d["key"], "yEs")
        case _:
            assert False

@test
def test_safe_load_norway_y_stays_string():
    result: object = yaml.safe_load("key: Y")
    match result:
        case dict() as d:
            assert isinstance(d["key"], str)
            assert operator.eq(d["key"], "Y")
        case _:
            assert False

@test
def test_safe_load_norway_n_stays_string():
    result: object = yaml.safe_load("key: N")
    match result:
        case dict() as d:
            assert isinstance(d["key"], str)
            assert operator.eq(d["key"], "N")
        case _:
            assert False

# The round trip the quoting exists to protect: a country code survives dump/load as itself.

@test
def test_safe_dump_quotes_the_bool_family_so_it_round_trips():
    assert operator.eq(yaml.safe_dump("NO"), "'NO'\n")
    assert operator.eq(yaml.safe_load(yaml.safe_dump("NO")), "NO")
    assert operator.eq(yaml.safe_load(yaml.safe_dump("yes")), "yes")

# --- SafeLoad - Nested structures ---

@test
def test_safe_load_map_in_map_returns_nested_dict():
    result: object = yaml.safe_load("outer:\n  inner: 42\n")
    match result:
        case dict() as d:
            match d["outer"]:
                case dict() as inner:
                    assert operator.eq(inner["inner"], 42)
                case _:
                    assert False
        case _:
            assert False

@test
def test_safe_load_list_in_map_returns_nested_list():
    result: object = yaml.safe_load("items:\n  - 1\n  - 2\n  - 3\n")
    match result:
        case dict() as d:
            match d["items"]:
                case list() as items:
                    assert len(items) == 3
                    assert operator.eq(items[0], 1)
                    assert operator.eq(items[2], 3)
                case _:
                    assert False
        case _:
            assert False

@test
def test_safe_load_map_in_list_returns_list_of_dicts():
    result: object = yaml.safe_load("- id: 1\n  name: alpha\n- id: 2\n  name: beta\n")
    match result:
        case list() as items:
            assert len(items) == 2
            match items[0]:
                case dict() as first:
                    assert operator.eq(first["id"], 1)
                    assert operator.eq(first["name"], "alpha")
                case _:
                    assert False
        case _:
            assert False

# --- SafeLoad - Empty / edge cases ---

@test
def test_safe_load_empty_document_returns_null():
    assert yaml.safe_load("") is None

@test
def test_safe_load_whitespace_only_returns_null():
    assert yaml.safe_load("   \n  \n") is None

@test
def test_safe_load_empty_mapping_returns_empty_dict():
    result: object = yaml.safe_load("{}")
    match result:
        case dict() as d:
            assert len(d) == 0
        case _:
            assert False

@test
def test_safe_load_empty_sequence_returns_empty_list():
    result: object = yaml.safe_load("[]")
    match result:
        case list() as items:
            assert len(items) == 0
        case _:
            assert False

@test
def test_safe_load_unicode_string_preserves_characters():
    result: object = yaml.safe_load("key: café üñî")
    match result:
        case dict() as d:
            assert operator.eq(d["key"], "café üñî")
        case _:
            assert False

@test
def test_safe_load_flow_mapping_returns_dict():
    result: object = yaml.safe_load("{a: 1, b: 2}")
    match result:
        case dict() as d:
            assert operator.eq(d["a"], 1)
            assert operator.eq(d["b"], 2)
        case _:
            assert False

# --- SafeDump - Formatting options ---

@test
def test_safe_dump_block_style_by_default():
    data: dict[str, object] = {}
    data["a"] = 1
    text: str = yaml.safe_dump(data)
    assert "a: 1" in text
    assert "{" not in text

@test
def test_safe_dump_flow_style_produces_inline():
    data: dict[str, object] = {}
    data["a"] = 1
    data["b"] = 2
    text: str = yaml.safe_dump(data, default_flow_style=True)
    assert "{" in text
    assert "}" in text

@test
def test_safe_dump_indent_uses_given_width():
    inner: dict[str, object] = {}
    inner["x"] = 1
    outer: dict[str, object] = {}
    outer["outer"] = inner
    text: str = yaml.safe_dump(outer, indent=4)
    assert "    x: 1" in text

@test
def test_safe_dump_sort_keys_true_sorts_alphabetically():
    data: dict[str, object] = {}
    data["c"] = 3
    data["a"] = 1
    data["b"] = 2
    text: str = yaml.safe_dump(data, sort_keys=True)
    pos_a: int = text.find("a:")
    pos_b: int = text.find("b:")
    pos_c: int = text.find("c:")
    assert pos_a < pos_b
    assert pos_b < pos_c

@test
def test_safe_dump_sort_keys_false_preserves_insertion_order():
    data: dict[str, object] = {}
    data["c"] = 3
    data["a"] = 1
    data["b"] = 2
    text: str = yaml.safe_dump(data, sort_keys=False)
    pos_c: int = text.find("c:")
    pos_a: int = text.find("a:")
    pos_b: int = text.find("b:")
    assert pos_c < pos_a
    assert pos_a < pos_b

@test
def test_safe_dump_width_affects_line_wrapping():
    items: list[object] = []
    for i in range(10):
        items.append(f"item-{i}")
    narrow: str = yaml.safe_dump(items, width=20)
    wide: str = yaml.safe_dump(items, width=1000)
    assert "item-0" in narrow
    assert "item-0" in wide

@test
def test_safe_dump_null_emits_null_token():
    # This test asserted only the round trip while claiming, in its name, to check the token.
    # That is exactly the blind spot #1467 lived in: Sharpy emitted `--- ` — a document with no
    # value at all, which a conforming parser reads as EMPTY — and read it back as None quite
    # happily, so the round trip held while neither half agreed with PyYAML. A property both
    # halves of one implementation satisfy is not evidence about the oracle.
    text: str = yaml.safe_dump(None)
    assert operator.eq(text, "null\n...\n")
    assert yaml.safe_load(text) is None

# --- SafeLoadAll / SafeDumpAll - Multi-document ---

@test
def test_safe_load_all_two_documents_returns_both():
    docs: list[object | None] = yaml.safe_load_all("a: 1\n---\nb: 2\n")
    assert len(docs) == 2
    first_elem: object = docs[0]
    match first_elem:
        case dict() as first:
            assert operator.eq(first["a"], 1)
        case _:
            assert False
    second_elem: object = docs[1]
    match second_elem:
        case dict() as second:
            assert operator.eq(second["b"], 2)
        case _:
            assert False

@test
def test_safe_load_all_three_documents_returns_all():
    docs: list[object | None] = yaml.safe_load_all("1\n---\n2\n---\n3\n")
    assert len(docs) == 3
    assert operator.eq(docs[0], 1)
    assert operator.eq(docs[1], 2)
    assert operator.eq(docs[2], 3)

@test
def test_safe_load_all_single_document_returns_one():
    docs: list[object | None] = yaml.safe_load_all("key: value\n")
    assert len(docs) == 1
    elem: object = docs[0]
    match elem:
        case dict() as d:
            assert operator.eq(d["key"], "value")
        case _:
            assert False

@test
def test_safe_load_all_empty_document_in_stream_yields_null():
    docs: list[object | None] = yaml.safe_load_all("a: 1\n---\n---\nb: 2\n")
    assert len(docs) == 3
    first_obj: object = docs[0]
    match first_obj:
        case dict():
            pass
        case _:
            assert False
    assert docs[1] is None
    third_obj: object = docs[2]
    match third_obj:
        case dict():
            pass
        case _:
            assert False

@test
def test_safe_dump_all_multiple_documents_produces_separators():
    doc1: dict[str, object] = {}
    doc1["a"] = 1
    doc2: dict[str, object] = {}
    doc2["b"] = 2
    documents: list[object | None] = []
    documents.append(doc1)
    documents.append(doc2)
    text: str = yaml.safe_dump_all(documents)
    assert "---" in text
    reparsed: list[object | None] = yaml.safe_load_all(text)
    assert len(reparsed) == 2

@test
def test_safe_dump_all_single_document_no_leading_separator():
    doc1: dict[str, object] = {}
    doc1["a"] = 1
    documents: list[object | None] = []
    documents.append(doc1)
    text: str = yaml.safe_dump_all(documents)
    assert not text.startswith("---")

# --- File I/O ---

@test
def test_safe_dump_file_safe_load_file_round_trip(tmp_path: str):
    path: str = tmp_path + "/data.yaml"
    data: dict[str, object] = {}
    data["name"] = "file-test"
    data["value"] = 7
    with open(path, "w") as fp:
        yaml.safe_dump_file(data, fp)
    name: str = ""
    value: int = 0
    with open(path, "r") as fp2:
        parsed: object = yaml.safe_load_file(fp2)
        match parsed:
            case dict() as d:
                match d["name"]:
                    case str() as n:
                        name = n
                    case _:
                        assert False
                match d["value"]:
                    case int() as v:
                        value = v
                    case _:
                        assert False
            case _:
                assert False
    assert name == "file-test"
    assert value == 7

# --- Anchors and aliases ---

@test
def test_safe_load_anchor_and_alias_resolves_mapping_reference():
    text: str = "defaults: &defaults\n  timeout: 30\n  retries: 3\nproduction: *defaults\n"
    result: object = yaml.safe_load(text)
    match result:
        case dict() as d:
            match d["production"]:
                case dict() as production:
                    assert operator.eq(production["timeout"], 30)
                    assert operator.eq(production["retries"], 3)
                case _:
                    assert False
        case _:
            assert False

@test
def test_safe_load_simple_alias_duplicates_value():
    text: str = "first: &val hello\nsecond: *val\n"
    result: object = yaml.safe_load(text)
    match result:
        case dict() as d:
            assert operator.eq(d["first"], "hello")
            assert operator.eq(d["second"], "hello")
        case _:
            assert False

@test
def test_safe_load_undefined_alias_throws_parse_error():
    with assert_raises(yaml.YAMLParseError):
        yaml.safe_load("ref: *missing\n")

# --- Error handling ---

@test
def test_safe_load_malformed_yaml_throws_parse_error():
    with assert_raises(yaml.YAMLParseError):
        yaml.safe_load("key: [1, 2")

@test
def test_safe_load_unterminated_quote_throws_parse_error():
    with assert_raises(yaml.YAMLParseError):
        yaml.safe_load("key: 'unterminated\n")

@test
def test_safe_load_tab_indentation_throws_parse_error():
    with assert_raises(yaml.YAMLParseError):
        yaml.safe_load("a:\n\t- 1\n")

@test
def test_yaml_parse_error_has_line_and_column():
    with assert_raises(yaml.YAMLParseError) as exc:
        yaml.safe_load("key: [1, 2")
    assert exc.line >= 0
    assert exc.column >= 0

@test
def test_yaml_parse_error_is_yaml_error():
    with assert_raises(yaml.YAMLParseError) as exc:
        yaml.safe_load("key: [1, 2")
    assert isinstance(exc, yaml.YAMLError)


# --- Float text matches PyYAML, and a float stays a float (#1229) ---
#
# ORACLE: PyYAML 6.0.3 under CPython 3.12.13 — NOT `repr` and not json.dumps. Every expected
# string below was produced by `python3 -c "import yaml; print(yaml.safe_dump(<value>))"`.
#
# The trailing "\n..." on each is the document-end marker PyYAML writes after a PLAIN scalar
# document, which Sharpy emits since #1348. It is not decoration: written without it, these
# assertions disagreed with the very command the paragraph above names as their oracle, and
# passed only because Sharpy was missing it too.
#
# PyYAML differs from repr in exactly one respect: in EXPONENT form the mantissa is forced to
# contain a decimal point.
#
#     value      repr        PyYAML       agree?
#     1e20       1e+20       1.0e+20      no
#     1e-5       1e-05       1.0e-05      no
#     2.5e-10    2.5e-10     2.5e-10      yes   (mantissa already has '.')
#     1e15       positional  positional   yes
#
# Do NOT "correct" these toward repr — that is what the plan for #1229 assumed before the
# spellings were measured.


@test
def test_safe_dump_float_exponent_matches_pyyaml():
    assert yaml.safe_dump(1e20).strip() == "1.0e+20\n..."
    assert yaml.safe_dump(1e17).strip() == "1.0e+17\n..."
    assert yaml.safe_dump(-1e20).strip() == "-1.0e+20\n..."
    assert yaml.safe_dump(1e100).strip() == "1.0e+100\n..."
    # A mantissa that already carries digits keeps them.
    assert yaml.safe_dump(2.5e-10).strip() == "2.5e-10\n..."
    assert yaml.safe_dump(1.5e20).strip() == "1.5e+20\n..."


@test
def test_safe_dump_float_layout_boundary_matches_pyyaml():
    # 1e16 is the first exponent-form value; 1e15 is the last positional one.
    assert yaml.safe_dump(1e16).strip() == "1.0e+16\n..."
    assert yaml.safe_dump(1e15).strip() == "1000000000000000.0\n..."
    # Small values cross over between 1e-4 and 1e-5.
    assert yaml.safe_dump(1e-4).strip() == "0.0001\n..."
    assert yaml.safe_dump(1e-5).strip() == "1.0e-05\n..."


@test
def test_safe_dump_whole_float_keeps_its_point():
    # Previously safe_dump emitted "1" and "5" here, which reload as INTS.
    assert yaml.safe_dump(1.0).strip() == "1.0\n..."
    assert yaml.safe_dump(5.0).strip() == "5.0\n..."
    assert yaml.safe_dump(0.0).strip() == "0.0\n..."
    assert yaml.safe_dump(-0.0).strip() == "-0.0\n..."


@test
def test_safe_dump_float_round_trips_as_a_float():
    # The value-fidelity floor, and the half of #1229 that was corruption rather than cosmetics:
    # safe_dump(1.0) used to emit "1", so the value came back an int.
    parsed: object = yaml.safe_load(yaml.safe_dump(1.0))
    assert isinstance(parsed, float)


@test
def test_roundtrip_dump_float_matches_safe_dump():
    # The two surfaces formatted floats independently and had drifted: roundtrip_dump got the
    # trailing .0 right but spelled the exponent "1E+20". One shared formatter now serves both,
    # so agreement between them is the property worth pinning.
    #
    # #1348 tested that claim rather than restating it: adding the document-end marker to
    # safe_dump alone broke this test, which is the design saying the two must agree. The marker
    # went to both surfaces (YamlDocumentEnd) instead of the assertion being narrowed.
    assert yaml.roundtrip_dump(1e20).strip() == yaml.safe_dump(1e20).strip()
    assert yaml.roundtrip_dump(1.0).strip() == yaml.safe_dump(1.0).strip()
    assert yaml.roundtrip_dump(1e16).strip() == yaml.safe_dump(1e16).strip()


# --- The document-end marker after a plain scalar (#1348) ---
#
# ORACLE: PyYAML 6.0.3 and ruamel.yaml 0.18.16 (round-trip mode) agree on every cell below.
# The condition is the emitted scalar's STYLE, not the value's kind — a quoted scalar is still a
# scalar and still gets no marker.


@test
def test_safe_dump_plain_scalar_ends_with_document_marker():
    assert yaml.safe_dump("hello") == "hello\n...\n"
    assert yaml.safe_dump(1.0) == "1.0\n...\n"
    assert yaml.safe_dump(42) == "42\n...\n"
    assert yaml.safe_dump(True) == "true\n...\n"


@test
def test_safe_dump_quoted_scalar_has_no_document_marker():
    # Quoted because the text would read back as another type (#1417) ...
    assert yaml.safe_dump("true") == "'true'\n"
    assert yaml.safe_dump("42") == "'42'\n"
    # ... or because the spelling would not survive plain at all.
    assert yaml.safe_dump("a: b") == "'a: b'\n"


@test
def test_safe_dump_collection_has_no_document_marker():
    mapping: dict[str, object] = {}
    mapping["a"] = 1
    assert yaml.safe_dump(mapping) == "a: 1\n"

    items: list[object] = []
    items.append(1)
    items.append(2)
    assert yaml.safe_dump(items) == "- 1\n- 2\n"


@test
def test_roundtrip_dump_marks_the_same_documents_as_safe_dump():
    # One authority for the rule, so the two dump surfaces cannot drift apart on it.
    #
    # RE-WIDENED (#1472). This loop was cut down to plain scalars because the ambiguous corpus
    # failed on `'true'` vs `"true"`: the two surfaces agreed on WHICH strings need quoting —
    # both ask YamlScalarResolver — and disagreed on HOW, because YamlRoundtrip.QuotedScalar
    # hardcoded DoubleQuoted where safe_dump and both Python oracles emit single quotes. A shared
    # predicate with unshared rendering still produces two documents for one value, which is the
    # subtler half of the same defect class. The quoted cells are back.
    for value in ["hello", "world", "abc", "true", "a: b", "yes", "0x1A", "#hash", ""]:
        assert yaml.roundtrip_dump(value) == yaml.safe_dump(value)


@test
def test_safe_dump_marked_scalar_still_round_trips():
    # The marker is part of the document the loader must accept, not decoration on the outside.
    assert operator.eq(yaml.safe_load(yaml.safe_dump("hello")), "hello")
    assert operator.eq(yaml.safe_load(yaml.safe_dump(42)), 42)


@test
def test_safe_dump_special_floats_keep_yaml_spellings():
    assert yaml.safe_dump(float("inf")).strip() == ".inf\n..."
    assert yaml.safe_dump(float("-inf")).strip() == "-.inf\n..."
    assert yaml.safe_dump(float("nan")).strip() == ".nan\n..."
