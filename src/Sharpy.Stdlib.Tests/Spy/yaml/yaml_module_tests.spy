from unittest import assert_raises, approx

import yaml
import operator

# Ported from YamlModuleTests.cs (#843).
# Untyped yaml.safe_load() returns object?; scalar results are compared with
# operator.eq (object '==' is rejected by Axiom 3) and structural results are
# navigated via match type-patterns (see json port / #912 for the indexing idiom).
#
# Omitted (documented in PORTING.md): the 5 null-argument TypeError guards
# (SafeLoad/SafeLoadAll/SafeLoadFile/SafeDumpFile/SafeDumpAll with null) cannot be
# expressed — passing None to a non-nullable str/list/TextFile parameter is a
# compile-time error in Sharpy (Axiom 3), so the runtime guard is unreachable from
# type-safe spy (same rationale as shlex/http null omissions).

# --- SafeLoad / SafeDump round-trip ---

@test
def test_round_trip_simple_mapping_preserves_data():
    data: dict[str, object] = {}
    data["name"] = "test"
    data["count"] = 42
    text: str = yaml.safe_dump(data)
    parsed: object = yaml.safe_load(text)
    match parsed:
        case dict() as result:
            assert operator.eq(result["name"], "test")
            assert operator.eq(result["count"], 42)
        case _:
            assert False

@test
def test_round_trip_list_preserves_data():
    data: list[object] = []
    data.append(1)
    data.append("two")
    data.append(True)
    data.append(None)
    text: str = yaml.safe_dump(data)
    parsed: object = yaml.safe_load(text)
    match parsed:
        case list() as result:
            assert operator.eq(result[0], 1)
            assert operator.eq(result[1], "two")
            assert operator.eq(result[2], True)
            assert result[3] is None
        case _:
            assert False

# --- SafeLoad - Scalar types ---

@test
def test_safe_load_string_returns_string():
    result: object = yaml.safe_load("key: hello")
    match result:
        case dict() as d:
            assert operator.eq(d["key"], "hello")
        case _:
            assert False

@test
def test_safe_load_quoted_string_returns_string():
    result: object = yaml.safe_load("key: \"hello world\"")
    match result:
        case dict() as d:
            assert operator.eq(d["key"], "hello world")
        case _:
            assert False

@test
def test_safe_load_int_returns_int():
    result: object = yaml.safe_load("key: 42")
    match result:
        case dict() as d:
            assert isinstance(d["key"], int)
            assert operator.eq(d["key"], 42)
        case _:
            assert False

@test
def test_safe_load_negative_int_returns_int():
    result: object = yaml.safe_load("key: -7")
    match result:
        case dict() as d:
            assert operator.eq(d["key"], -7)
        case _:
            assert False

@test
def test_safe_load_large_int_returns_long():
    result: object = yaml.safe_load("key: 9999999999")
    match result:
        case dict() as d:
            assert isinstance(d["key"], long)
            value: long = 9999999999
            assert operator.eq(d["key"], value)
        case _:
            assert False

@test
def test_safe_load_float_returns_double_exactly():
    # EXACT, not approx. This test used to assert `approx(3.14, abs=1e-4)` and call the
    # difference a "KNOWN QUIRK": SafeLoad resolved plain scalars through YamlDotNet's
    # float-before-double convenience, so 3.14 came back as 3.140000104904175. The tolerance
    # is what let the defect survive 89 yaml tests — every assertion in the suite was loose
    # enough to accept a single-precision detour (#1339). PyYAML: 3.14.
    result: object = yaml.safe_load("key: 3.14")
    match result:
        case dict() as d:
            # An index-access match subject, narrowed by the assert: same #1370 shape as
            # json_additional_tests' identifier subject, and the reason both are pinned here.
            assert isinstance(d["key"], float)
            match d["key"]:
                case float() as fv:
                    assert fv == 3.14
                case _:
                    assert False
        case _:
            assert False

@test
def test_safe_load_whole_number_float_stays_float_typed():
    result: object = yaml.safe_load("key: 2.0")
    match result:
        case dict() as d:
            assert isinstance(d["key"], float)
            match d["key"]:
                case float() as fv:
                    assert fv == 2.0
                case _:
                    assert False
        case _:
            assert False

@test
def test_safe_load_resolves_non_float32_exact_values():
    # Values chosen because they are NOT representable in single precision — the property
    # the old assertions could not see. Each expected value is what python3's PyYAML
    # safe_load returns for the same text (verified 2026-08-09).
    assert _load_float("0.1") == 0.1
    assert _load_float("3.141592653589793") == 3.141592653589793
    assert _load_float("2.718281828459045") == 2.718281828459045
    assert _load_float("1.0e+20") == 1e20
    assert _load_float("-0.30000000000000004") == -0.30000000000000004

@test
def test_safe_dump_safe_load_round_trip_is_identity():
    # The property #1339 broke: PyYAML holds safe_load(safe_dump(x)) == x, and Sharpy did not.
    for value in [0.1, 3.141592653589793, 2.718281828459045, 1e20, 1e-5, -0.0, 1.5e20]:
        text: str = yaml.safe_dump(value)
        reloaded: object = yaml.safe_load(text)
        match reloaded:
            case float() as back:
                assert back == value
            case _:
                assert False


def _load_float(text: str) -> float:
    parsed: object = yaml.safe_load(text)
    match parsed:
        case float() as f:
            return f
        case _:
            raise ValueError("expected a float from " + text)

@test
def test_safe_load_bool_true_returns_bool():
    result: object = yaml.safe_load("key: true")
    match result:
        case dict() as d:
            assert isinstance(d["key"], bool)
            assert operator.eq(d["key"], True)
        case _:
            assert False

@test
def test_safe_load_bool_false_returns_bool():
    result: object = yaml.safe_load("key: false")
    match result:
        case dict() as d:
            assert operator.eq(d["key"], False)
        case _:
            assert False

@test
def test_safe_load_null_returns_null():
    result: object = yaml.safe_load("key: null")
    match result:
        case dict() as d:
            assert d["key"] is None
        case _:
            assert False

@test
def test_safe_load_tilde_returns_null():
    result: object = yaml.safe_load("key: ~")
    match result:
        case dict() as d:
            assert d["key"] is None
        case _:
            assert False

# --- SafeLoad - the YAML 1.1 bool family, a.k.a. the Norway problem (#1465) ---
#
# These cells USED to assert that no/yes/on/off stay strings, under a header claiming the YAML
# 1.2 core schema. That claim had already stopped being true of this resolver: #1339 and #1423
# rebuilt it against PyYAML as the oracle and documented it as "a strict subset of YAML 1.1"
# (Yaml.cs) with "YAML 1.1's float production" (YamlScalarResolver.cs). The visible proof is
# `1e-7`, which stdlib_yaml_exponent_scalar_1423 pins as a STRING — that is a YAML 1.1 answer;
# the 1.2 core schema calls it a float. So the schema position was 1.1 everywhere except this
# header, and #1465 closes the gap rather than changing direction.
#
# The trade is real and worth naming: `NO` is Norway's country code, and under YAML 1.1 an
# unquoted one loads as False. Sharpy's answer is not to leave the resolver half-1.2 but to make
# DUMP round-trip it — safe_dump("NO") emits 'NO' quoted, because the same resolver decides
# quoting (#1417). A string that would read back as a bool is never written bare.
#
# Cells measured against PyYAML 6.0.3 / python 3.12.13. Casing is all-or-nothing: only the
# all-lower, Title and all-UPPER spellings resolve, so `yEs` and `oN` stay strings, and the
# single letters `y`/`Y`/`n`/`N` are NOT bools in PyYAML at all (they are in the 1.1 spec, but
# not in the implementation that is this module's oracle).

@test
def test_safe_load_norway_no_caps_is_false():
    result: object = yaml.safe_load("key: NO")
    match result:
        case dict() as d:
            assert isinstance(d["key"], bool)
            assert operator.eq(d["key"], False)
        case _:
            assert False

@test
def test_safe_load_norway_no_lower_is_false():
    result: object = yaml.safe_load("key: no")
    match result:
        case dict() as d:
            assert isinstance(d["key"], bool)
            assert operator.eq(d["key"], False)
        case _:
            assert False

@test
def test_safe_load_norway_no_title_is_false():
    result: object = yaml.safe_load("key: No")
    match result:
        case dict() as d:
            assert isinstance(d["key"], bool)
            assert operator.eq(d["key"], False)
        case _:
            assert False

@test
def test_safe_load_norway_yes_title_is_true():
    result: object = yaml.safe_load("key: Yes")
    match result:
        case dict() as d:
            assert isinstance(d["key"], bool)
            assert operator.eq(d["key"], True)
        case _:
            assert False

@test
def test_safe_load_norway_yes_lower_is_true():
    result: object = yaml.safe_load("key: yes")
    match result:
        case dict() as d:
            assert isinstance(d["key"], bool)
            assert operator.eq(d["key"], True)
        case _:
            assert False

