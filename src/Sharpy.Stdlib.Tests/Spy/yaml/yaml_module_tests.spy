def test_safe_load_norway_on_lower_is_true():
    result: object = yaml.safe_load("key: on")
    match result:
        case dict() as d:
            assert isinstance(d["key"], bool)
            assert operator.eq(d["key"], True)
        case _:
            assert False

@test
def test_safe_load_norway_on_title_is_true():
    result: object = yaml.safe_load("key: On")
    match result:
        case dict() as d:
            assert isinstance(d["key"], bool)
            assert operator.eq(d["key"], True)
        case _:
            assert False

