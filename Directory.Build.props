<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Sharpy toolchain version (single version for Compiler + Core + CLI + LSP) -->
    <SharpyVersion>0.17.0</SharpyVersion>
    <Version>$(SharpyVersion)</Version>
    <AssemblyVersion>$(SharpyVersion).0</AssemblyVersion>
    <FileVersion>$(SharpyVersion).0</FileVersion>

    <!-- NuGet packaging metadata (shared across all packable projects) -->
    <Authors>antonsynd</Authors>
    <PackageLicenseExpression>Apache-2.0 OR MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/antonsynd/sharpy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/antonsynd/sharpy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>sharpy;python;dotnet;compiler;transpiler</PackageTags>
    <PackageIcon>sharpy-icon.png</PackageIcon>
    <Copyright>Copyright (c) 2025 Anton Nguyen</Copyright>
  </PropertyGroup>

  <!-- Include icon in all packable projects -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets/sharpy-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Embed git commit hash into InformationalVersion at build time -->
  <Target Name="_SetSharpyInformationalVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git -C &quot;$(MSBuildThisFileDirectory)&quot; rev-parse --short HEAD" ConsoleToMsBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SharpyCommitHash" />
    </Exec>
    <PropertyGroup>
      <_SharpyCommitHash Condition="'$(_SharpyCommitHash)' == ''">unknown</_SharpyCommitHash>
      <InformationalVersion>$(SharpyVersion)+$(_SharpyCommitHash)</InformationalVersion>
      <!-- Prevent .NET SDK from appending SourceRevisionId to InformationalVersion -->
      <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
