import numpy as np


def main():
    # Numeric-path matrix multiply: numpy NdArray (@ operator, matmul feature)
    # delegates to MathNet.Numerics, mirroring how a Sharpy user would write a
    # numeric-heavy kernel rather than nesting pure-list loops (matrix_multiply).
    size: int = 256
    a = np.array([[float((i + j) % 7) for j in range(size)] for i in range(size)])
    b = np.array([[float((i * j + 1) % 11) for j in range(size)] for i in range(size)])

    result = a @ b
    n: int = 1
    while n < 200:
        result = a @ b
        n = n + 1
    print(f"done: {int(result[0, 0])}")
