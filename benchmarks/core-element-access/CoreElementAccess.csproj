<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P76 (#2404) element-access kernel. Deliberately OUTSIDE sharpy.sln: it is a measurement
    instrument, run by hand (README.md), never part of the gate. Always run with -c Release —
    the referenced Sharpy.Core is then built Release too, and the program prints the Core
    assembly's IsJITOptimizerDisabled state so a Debug-Core reading cannot pass for evidence.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <IsPackable>false</IsPackable>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sharpy.Core/Sharpy.Core.csproj" />
  </ItemGroup>

</Project>
